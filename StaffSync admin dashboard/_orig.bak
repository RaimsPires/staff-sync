  state={route:null,adminPage:'dashboard',nonce:0,menu:false,role:null,obStep:null};
  subs={}; last={};
  nav=(t,o)=>this.navigate(t,o);
  pageChange=p=>{ if(p!==this.state.adminPage) this.setState({adminPage:p},()=>this.persist()); };
  componentDidMount(){
    this._alive=true;
    const ss=this.props.startScreen;
    if(ss&&ADMIN.has(ss)) this.setState({adminPage:ss});
    this.sync();
  }
  componentDidUpdate(pp){
    if(pp.startScreen!==this.props.startScreen&&this.props.startScreen) this.navigate(this.props.startScreen);
    if(pp.role!==this.props.role&&this.state.role) this.setState({role:null});
    this.sync();
  }
  componentWillUnmount(){ this._alive=false; for(const k in this.subs){ const s=this.subs[k]; s.componentWillUnmount&&s.componentWillUnmount(); } }
  route(){ const r=this.state.route||this.props.startScreen||'signin'; return ADMIN.has(r)?'admin':r; }
  persist(){ try{localStorage.setItem(KEY,JSON.stringify({route:this.route(),adminPage:this.state.adminPage}));}catch(e){} }
  navigate(target,opts){
    opts=opts||{};
    const patch={menu:false,obStep:target==='onboarding'?(opts.step||null):null};
    if(opts.role) patch.role=opts.role;
    if(ADMIN.has(target)) this.setState(s=>Object.assign(patch,{route:'admin',adminPage:target,nonce:s.nonce+1}),()=>this.persist());
    else this.setState(Object.assign(patch,{route:target}),()=>this.persist());
    window.scrollTo(0,0);
  }
  subProps(k){
    const P=this.props,s=this.state;
    if(k==='signin') return {onNavigate:this.nav,theme:P.theme,lang:P.lang,previewState:P.signinState};
    if(k==='invite') return {onNavigate:this.nav,theme:P.theme,lang:P.lang,inviteState:P.inviteState};
    if(k==='workspaces') return {onNavigate:this.nav,theme:P.theme,lang:P.lang};
    if(k==='onboarding') return {onNavigate:this.nav,theme:P.theme,startStep:s.obStep||P.onboardingStep};
    return {onNavigate:this.nav,onPageChange:this.pageChange,initialPage:s.adminPage,pageNonce:s.nonce,theme:P.theme,lang:P.lang,role:s.role||P.role,sidebar:P.sidebar,layout:P.layout,dashState:P.dashState,recordsState:P.recordsState};
  }
  ensure(k){
    if(!this.subs[k]){ const inst=new CLASSES[k](this,k); const own=Object.getOwnPropertyDescriptor(inst,'state'); if(own){ delete inst.state; inst._s=own.value||{}; } this.subs[k]=inst; }
    return this.subs[k];
  }
  sync(){
    const act=this.route();
    for(const k of Object.keys(this.subs)) if(k!==act){ const s=this.subs[k]; delete this.subs[k]; delete this.last[k]; s.componentWillUnmount&&s.componentWillUnmount(); }
    const s=this.subs[act]; if(!s) return;
    if(!s._mounted){ s._mounted=true; this.last[act]=this.subProps(act); s.componentDidMount&&s.componentDidMount(); return; }
    const np=this.subProps(act), op=this.last[act];
    if(Object.keys(np).some(x=>np[x]!==op[x])){ this.last[act]=np; s.componentDidUpdate&&s.componentDidUpdate(op,s._s); }
  }
  renderVals(){
    const r=this.route(), s=this.state;
    const out={si:{},iv:{},ws:{},ob:{},ad:{}};
    out[NS[r]]=this.ensure(r).renderVals();
    const activeKey=r==='admin'?s.adminPage:r;
    const cur=SCREENS.flatMap(g=>g.items).find(i=>i[0]===activeKey);
    return Object.assign(out,{
      isSignin:r==='signin',isInvite:r==='invite',isWorkspaces:r==='workspaces',isOnboarding:r==='onboarding',isAdmin:r==='admin',
      showSwitcher:this.props.showSwitcher!==false,menuOpen:s.menu,toggleMenu:()=>this.setState({menu:!s.menu}),chevron:s.menu?'M18 15l-6-6-6 6':'M6 9l6 6 6-6',
      currentLabel:cur?cur[1]:'Screens',
      groups:SCREENS.map(g=>({label:g.group,items:g.items.map(([k,label,soon])=>({label,soon:!!soon,active:k===activeKey,bg:k===activeKey?'#E8F0FC':'transparent',fg:k===activeKey?'#0B67DD':'#0D1B2E',go:()=>this.navigate(k)}))}))
    });
  }
}
</script>
</body>
</html>
