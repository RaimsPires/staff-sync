  toast(msg,kind){ const id=Math.random(); this.setState(s=>({toasts:[...s.toasts,{id,msg,kind:kind||'ok'}]})); setTimeout(()=>this.setState(s=>({toasts:s.toasts.filter(x=>x.id!==id)})),3600); }
