<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
html,body{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;font-family:'Geist',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:#0B67DD;text-decoration:none}a:hover{color:#0957BD;text-decoration:underline}
[data-theme=light]{--bg:#F4F6F9;--surface:#FFFFFF;--surface-2:#F8F9FB;--hover:#F1F4F8;--border:#E3E7ED;--border-strong:#CDD4DE;--text:#0D1B2E;--text-2:#4A5668;--text-3:#6F7A8B;--accent:#0B67DD;--accent-hover:#0957BD;--accent-soft:#E8F0FC;--fence:rgba(11,103,221,.12);--sidebar:#FFFFFF;--ok:#0F7A3F;--ok-bg:#E5F4EA;--ok-dot:#16A34A;--warn:#8F5300;--warn-bg:#FCF0D6;--warn-dot:#E59A00;--bad:#B9241A;--bad-bg:#FCE9E7;--bad-dot:#E5372A;--info:#2E45BF;--info-bg:#EBEEFC;--info-dot:#4F6BED;--orange:#A9420B;--orange-bg:#FCECE0;--orange-dot:#EA6A1F;--violet:#6236C2;--violet-bg:#F0EAFC;--violet-dot:#8B5CF6;--neutral:#4A5668;--neutral-bg:#EEF1F5;--neutral-dot:#97A1B0;--map-bg:#ECEFEA;--map-road:#FFFFFF;--map-block:#E1E6DD;--map-water:#D3E4F2;--shadow:0 1px 2px rgba(13,27,46,.05),0 1px 3px rgba(13,27,46,.04);--shadow-lg:0 12px 40px rgba(13,27,46,.16);--overlay:rgba(13,27,46,.32)}
[data-theme=dark]{--bg:#0A0F17;--surface:#111823;--surface-2:#0E141E;--hover:#18212E;--border:#1F2A39;--border-strong:#2C3A4E;--text:#E7EDF5;--text-2:#A5B1C2;--text-3:#7F8CA0;--accent:#3B8BFF;--accent-hover:#5C9EFF;--accent-soft:rgba(59,139,255,.15);--fence:rgba(59,139,255,.16);--sidebar:#0D131D;--ok:#4ADE80;--ok-bg:rgba(34,197,94,.14);--ok-dot:#22C55E;--warn:#FBBF24;--warn-bg:rgba(245,158,11,.15);--warn-dot:#F59E0B;--bad:#F87171;--bad-bg:rgba(239,68,68,.15);--bad-dot:#EF4444;--info:#9AABFF;--info-bg:rgba(99,123,255,.16);--info-dot:#6F86FF;--orange:#FB923C;--orange-bg:rgba(249,115,22,.15);--orange-dot:#F97316;--violet:#C0A6FF;--violet-bg:rgba(139,92,246,.17);--violet-dot:#8B5CF6;--neutral:#A5B1C2;--neutral-bg:rgba(148,163,184,.12);--neutral-dot:#64748B;--map-bg:#121B26;--map-road:#1C2735;--map-block:#0F1721;--map-water:#0F2539;--shadow:none;--shadow-lg:0 16px 48px rgba(0,0,0,.5);--overlay:rgba(0,0,0,.55)}
@keyframes ssPulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.5)}70%{box-shadow:0 0 0 7px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
@keyframes ssIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes ssDrawer{from{transform:translateX(24px);opacity:0}to{transform:none;opacity:1}}
@keyframes ssShimmer{0%{opacity:.55}50%{opacity:1}100%{opacity:.55}}
input,select,textarea,button{font-family:inherit}
input[type=range]{accent-color:#0B67DD}
@keyframes ssSpin{to{transform:rotate(360deg)}}
@keyframes ssFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
</style>
</helmet>
<div style="min-height:100vh;position:relative">
<sc-if value="{{ isSignin }}" hint-placeholder-val="{{ true }}">
<!-- ===== SIGNIN ===== -->
<div data-theme="{{ si.theme }}" style="min-height:100vh;background:var(--surface);color:var(--text);display:flex;font-size:14px;line-height:1.45">

<sc-if value="{{ si.showBrand }}" hint-placeholder-val="{{ true }}">
<section style="flex:1 1 50%;position:relative;overflow:hidden;background:#0A2547;color:#fff;display:flex;flex-direction:column;padding:40px 48px;box-sizing:border-box;min-height:100vh">
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.07) 1px,transparent 1px);background-size:22px 22px"></div>
  <div style="position:absolute;width:620px;height:620px;right:-220px;top:-160px;border-radius:50%;border:1px solid rgba(255,255,255,.08)"></div>
  <div style="position:absolute;width:420px;height:420px;right:-120px;top:-60px;border-radius:50%;border:1px solid rgba(255,255,255,.1)"></div>
  <div style="position:relative;display:flex;align-items:center;gap:10px">
    <div style="width:38px;height:38px;border-radius:10px;background:#fff;display:grid;place-items:center;overflow:hidden"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:34px;height:34px;object-fit:contain"></div>
    <span style="font-weight:700;font-size:18px;letter-spacing:-.01em">StaffSync</span>
  </div>

  <div style="position:relative;flex:1;display:flex;align-items:center;justify-content:center;padding:40px 0">
    <div style="position:relative;width:100%;max-width:440px;height:360px">
      <div style="position:absolute;left:0;top:30px;width:300px;border-radius:16px;background:#fff;color:#0D1B2E;box-shadow:0 24px 60px rgba(0,0,0,.35);padding:18px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><span style="font-weight:600;font-size:13px">{{ si.t.ilTitle }}</span><span style="display:flex;align-items:center;gap:6px;font-size:11.5px;color:#0F7A3F;font-weight:500"><span style="width:7px;height:7px;border-radius:50%;background:#16A34A"></span>{{ si.t.ilLive }}</span></div>
        <div style="display:flex;align-items:baseline;gap:6px"><span style="font-size:34px;font-weight:600;letter-spacing:-.02em">168</span><span style="font-size:12.5px;color:#6F7A8B">/ 198 {{ si.t.ilPresent }}</span></div>
        <div style="display:flex;height:8px;border-radius:8px;overflow:hidden;gap:2px;margin:12px 0 14px"><span style="flex:152;background:#0B67DD"></span><span style="flex:16;background:#E59A00"></span><span style="flex:11;background:#E5372A"></span><span style="flex:19;background:#EEF1F5"></span></div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:11.5px">
          <div style="padding:8px;border-radius:8px;background:#E5F4EA;color:#0F7A3F"><div style="font-weight:600;font-size:15px">152</div>{{ si.t.ilOnTime }}</div>
          <div style="padding:8px;border-radius:8px;background:#FCF0D6;color:#8F5300"><div style="font-weight:600;font-size:15px">16</div>{{ si.t.ilLate }}</div>
          <div style="padding:8px;border-radius:8px;background:#FCE9E7;color:#B9241A"><div style="font-weight:600;font-size:15px">4</div>{{ si.t.ilFlag }}</div>
        </div>
      </div>
      <div style="position:absolute;right:0;top:0;width:200px;height:170px;border-radius:16px;background:#E9EEF0;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.35);animation:ssFloat 6s ease-in-out infinite">
        <svg viewBox="0 0 200 170" style="position:absolute;inset:0;width:100%;height:100%">
          <rect x="10" y="10" width="50" height="34" rx="3" fill="#DDE3DA"></rect><rect x="132" y="102" width="58" height="50" rx="3" fill="#DDE3DA"></rect>
          <path d="M0 130 C 50 118, 90 160, 200 140 L200 170 L0 170Z" fill="#D3E4F2"></path>
          <g stroke="#fff" fill="none" stroke-linecap="round"><path d="M0 56 L200 48" stroke-width="7"></path><path d="M74 0 L82 170" stroke-width="7"></path><path d="M0 104 L200 96" stroke-width="4"></path><path d="M150 0 L170 170" stroke-width="4"></path></g>
          <circle cx="110" cy="76" r="40" fill="rgba(11,103,221,.14)" stroke="#0B67DD" stroke-width="1.6" stroke-dasharray="5 4"></circle>
          <circle cx="100" cy="68" r="5" fill="#16A34A" stroke="#fff" stroke-width="2"></circle><circle cx="122" cy="82" r="5" fill="#16A34A" stroke="#fff" stroke-width="2"></circle><circle cx="108" cy="92" r="5" fill="#E59A00" stroke="#fff" stroke-width="2"></circle><circle cx="178" cy="22" r="5" fill="#E5372A" stroke="#fff" stroke-width="2"></circle>
        </svg>
      </div>
      <div style="position:absolute;right:20px;bottom:0;width:250px;border-radius:14px;background:#fff;color:#0D1B2E;box-shadow:0 24px 60px rgba(0,0,0,.35);padding:12px 14px;display:flex;gap:12px;align-items:center;animation:ssFloat 6s ease-in-out -3s infinite">
        <div style="width:36px;height:36px;border-radius:50%;background:oklch(0.93 0.045 150);color:oklch(0.42 0.1 150);display:grid;place-items:center;font-size:12.5px;font-weight:600;flex:none">CD</div>
        <div style="flex:1;min-width:0"><div style="font-weight:600;font-size:13px">Camille Durand</div><div style="font-size:11.5px;color:#6F7A8B">{{ si.t.ilCheckin }}</div></div>
        <span style="font:500 11px 'Geist Mono',monospace;padding:3px 7px;border-radius:999px;background:#E5F4EA;color:#0F7A3F">07:54</span>
      </div>
    </div>
  </div>

  <div style="position:relative;max-width:460px">
    <h2 style="margin:0;font-size:30px;line-height:1.15;font-weight:600;letter-spacing:-.02em;text-wrap:balance">{{ si.t.vpTitle }}</h2>
    <div style="margin-top:12px;font-size:15px;color:rgba(255,255,255,.78);text-wrap:pretty">{{ si.t.vpSub }}</div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:20px">
      <sc-for list="{{ si.vpChips }}" as="c" hint-placeholder-count="3"><span style="display:flex;align-items:center;gap:7px;height:30px;padding:0 12px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);font-size:12.5px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7FB4FF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>{{ c }}</span></sc-for>
    </div>
  </div>
</section>
</sc-if>

<section style="flex:1 1 50%;display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding:24px 32px;background:var(--surface)">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
    <sc-if value="{{ si.compact }}"><div style="display:flex;align-items:center;gap:8px"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:30px;height:30px;object-fit:contain"><span style="font-weight:700;font-size:16px">StaffSync</span></div></sc-if>
    <div style="flex:1"></div>
    <div style="display:flex;align-items:center;gap:8px">
      <button onClick="{{ si.toggleTheme }}" title="Theme" style="width:32px;height:32px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ si.themeIcon }}"></path></svg></button>
      <div style="display:flex;padding:3px;border:1px solid var(--border);border-radius:9px;gap:2px" role="group" aria-label="Language">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="color:var(--text-3);margin:5px 4px 0 5px"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z"></path></svg>
        <button onClick="{{ si.setEn }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ si.en.bg }};color:{{ si.en.fg }}">EN</button>
        <button onClick="{{ si.setFr }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ si.fr.bg }};color:{{ si.fr.fg }}">FR</button>
      </div>
    </div>
  </div>

  <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:32px 0">
    <div style="width:100%;max-width:400px;display:flex;flex-direction:column;gap:20px">
      <sc-if value="{{ si.offline }}">
        <div role="status" style="display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:10px;background:var(--warn-bg);color:var(--warn);animation:ssIn .2s ease-out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px"><path d="M2 2l20 20M8.5 16.4a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 5.2-2.7M19 12.9a10 10 0 0 0-2.3-1.6M1.4 9a15 15 0 0 1 4.4-2.6M22.6 9A15 15 0 0 0 10.7 5M12 20h.01"></path></svg>
          <div style="flex:1"><div style="font-weight:600;font-size:13.5px">{{ si.t.offTitle }}</div><div style="font-size:12.5px">{{ si.t.offDesc }}</div></div>
          <button onClick="{{ si.retry }}" style="height:28px;padding:0 10px;border-radius:7px;border:1px solid currentColor;background:transparent;color:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap">{{ si.t.retry }}</button>
        </div>
      </sc-if>

      <div>
        <h1 style="margin:0;font-size:26px;font-weight:600;letter-spacing:-.02em">{{ si.t.title }}</h1>
        <div style="margin-top:6px;color:var(--text-2)">{{ si.t.sub }}</div>
      </div>

      <sc-if value="{{ si.isWrong }}">
        <div role="alert" style="display:flex;gap:10px;padding:12px 14px;border-radius:10px;background:var(--bad-bg);color:var(--bad);animation:ssIn .2s ease-out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 8v5M12 16h.01"></path></svg>
          <div><div style="font-weight:600;font-size:13.5px">{{ si.t.wrongTitle }}</div><div style="font-size:12.5px">{{ si.wrongDesc }}</div></div>
        </div>
      </sc-if>
      <sc-if value="{{ si.isLocked }}">
        <div role="alert" style="display:flex;gap:12px;padding:14px;border-radius:10px;background:var(--bad-bg);color:var(--bad);animation:ssIn .2s ease-out">
          <div style="width:36px;height:36px;border-radius:9px;background:var(--bad-dot);color:#fff;display:grid;place-items:center;flex:none"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4"></path></svg></div>
          <div style="flex:1"><div style="font-weight:600;font-size:13.5px">{{ si.t.lockTitle }}</div><div style="font-size:12.5px">{{ si.t.lockDesc }}</div>
            <div style="display:flex;align-items:center;gap:10px;margin-top:10px"><span style="font:600 20px 'Geist Mono',monospace;letter-spacing:.02em">{{ si.lockClock }}</span><div style="flex:1;height:4px;border-radius:4px;background:rgba(229,55,42,.2);overflow:hidden"><div style="height:100%;width:{{ si.lockPct }};background:var(--bad-dot)"></div></div></div>
            <div style="font-size:12.5px;margin-top:8px"><a href="#" onClick="{{ si.forgot }}" style="color:inherit;text-decoration:underline">{{ si.t.lockReset }}</a></div>
          </div>
        </div>
      </sc-if>
      <sc-if value="{{ si.isDeact }}">
        <div role="alert" style="display:flex;gap:12px;padding:14px;border-radius:10px;background:var(--surface-2);border:1px solid var(--border-strong);animation:ssIn .2s ease-out">
          <div style="width:36px;height:36px;border-radius:9px;background:var(--neutral-bg);color:var(--text-2);display:grid;place-items:center;flex:none"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 4 1.5M16 17h6"></path></svg></div>
          <div style="flex:1"><div style="font-weight:600;font-size:13.5px">{{ si.t.deTitle }}</div><div style="font-size:12.5px;color:var(--text-2)">{{ si.deDesc }}</div>
            <div style="display:flex;gap:12px;margin-top:8px;font-size:12.5px"><a href="#" onClick="{{ si.contactAdmin }}">{{ si.t.deContact }}</a><a href="#" onClick="{{ si.useOther }}">{{ si.t.deOther }}</a></div>
          </div>
        </div>
      </sc-if>

      <form onSubmit="{{ si.submit }}" novalidate="{{ true }}" style="display:flex;flex-direction:column;gap:16px">
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ si.t.email }}</span>
          <input value="{{ si.email }}" onChange="{{ si.onEmail }}" type="email" autocomplete="email" placeholder="name@company.com" disabled="{{ si.fieldsDisabled }}" style="height:42px;padding:0 12px;border-radius:9px;border:1px solid {{ si.emailBd }};background:{{ si.fieldBg }};color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <sc-if value="{{ si.hasEmailErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ si.emailErr }}</span></sc-if>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px">
          <span style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:13px;font-weight:500">{{ si.t.password }}</span><a href="#" onClick="{{ si.forgot }}" style="font-size:12.5px;font-weight:500">{{ si.t.forgot }}</a></span>
          <div style="position:relative;display:flex">
            <input value="{{ si.password }}" onChange="{{ si.onPw }}" type="{{ si.pwType }}" autocomplete="current-password" placeholder="••••••••" disabled="{{ si.fieldsDisabled }}" style="flex:1;min-width:0;height:42px;padding:0 44px 0 12px;border-radius:9px;border:1px solid {{ si.pwBd }};background:{{ si.fieldBg }};color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
            <button type="button" onClick="{{ si.togglePw }}" aria-label="{{ si.pwAria }}" title="{{ si.pwAria }}" style="position:absolute;right:6px;top:6px;width:30px;height:30px;border:0;border-radius:7px;background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer" style-hover="background:var(--hover);color:var(--text)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ si.eyeIcon }}"></path></svg></button>
          </div>
          <sc-if value="{{ si.hasPwErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ si.pwErr }}</span></sc-if>
        </label>
        <label style="display:flex;align-items:center;gap:9px;font-size:13.5px;color:var(--text-2);cursor:pointer;align-self:flex-start">
          <input type="checkbox" checked="{{ si.remember }}" onChange="{{ si.onRemember }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD">{{ si.t.remember }}
        </label>
        <button type="submit" disabled="{{ si.submitDisabled }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:44px;border:0;border-radius:10px;background:{{ si.btnBg }};color:{{ si.btnFg }};font-size:14.5px;font-weight:600;cursor:{{ si.btnCursor }}" style-hover="filter:brightness(1.06)">
          <sc-if value="{{ si.loading }}"><span style="width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;animation:ssSpin .7s linear infinite;box-sizing:border-box"></span></sc-if>
          {{ si.btnLabel }}
        </button>
      </form>

      <div style="display:flex;align-items:center;gap:12px;color:var(--text-3);font-size:12px"><span style="flex:1;height:1px;background:var(--border)"></span>{{ si.t.or }}<span style="flex:1;height:1px;background:var(--border)"></span></div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <button onClick="{{ si.ssoGoogle }}" disabled="{{ si.ssoDisabled }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:42px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px;font-weight:500;cursor:pointer;opacity:{{ si.ssoOpacity }}" style-hover="background:var(--hover)"><span style="width:18px;height:18px;display:grid;place-items:center;font-weight:700;font-size:16px;color:#4285F4">G</span>{{ si.t.google }}</button>
        <button onClick="{{ si.ssoMs }}" disabled="{{ si.ssoDisabled }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:42px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px;font-weight:500;cursor:pointer;opacity:{{ si.ssoOpacity }}" style-hover="background:var(--hover)"><span style="display:grid;grid-template-columns:7px 7px;gap:1.5px"><span style="width:7px;height:7px;background:#F25022"></span><span style="width:7px;height:7px;background:#7FBA00"></span><span style="width:7px;height:7px;background:#00A4EF"></span><span style="width:7px;height:7px;background:#FFB900"></span></span>{{ si.t.ms }}</button>
      </div>
      <div style="text-align:center;font-size:13.5px;color:var(--text-2)">{{ si.t.noAccount }} <a href="#" onClick="{{ si.goCreate }}" style="font-weight:500">{{ si.t.create }}</a></div>
      <div style="font-size:12px;color:var(--text-3);text-align:center;padding:8px 12px;border-radius:8px;background:var(--surface-2)">{{ si.t.demo }}</div>
    </div>
  </div>

  <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:12px;color:var(--text-3)">
    <span>© 2026 StaffSync</span>
    <div style="display:flex;gap:16px"><a href="#" style="color:var(--text-3)">{{ si.t.privacy }}</a><a href="#" style="color:var(--text-3)">{{ si.t.terms }}</a><a href="#" style="color:var(--text-3)">{{ si.t.status }}</a></div>
  </div>
</section>

<div style="position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:40;display:flex;flex-direction:column;gap:8px;align-items:center">
  <sc-for list="{{ si.toasts }}" as="tt">
    <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:11px;background:var(--text);color:var(--surface);box-shadow:var(--shadow-lg);font-size:13.5px;animation:ssIn .2s ease-out"><span style="width:8px;height:8px;border-radius:50%;background:{{ tt.c }}"></span>{{ tt.msg }}</div>
  </sc-for>
</div>
</div>
</sc-if>
<sc-if value="{{ isInvite }}">
<!-- ===== INVITE ===== -->
<div data-theme="{{ iv.theme }}" style="min-height:100vh;background:var(--bg);color:var(--text);display:flex;flex-direction:column;font-size:14px;line-height:1.45">
  <header style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 28px">
    <div style="display:flex;align-items:center;gap:9px"><div style="width:30px;height:30px;border-radius:8px;background:#fff;border:1px solid var(--border);display:grid;place-items:center;overflow:hidden"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:26px;height:26px;object-fit:contain"></div><span style="font-weight:700;font-size:15px">StaffSync</span></div>
    <div style="display:flex;align-items:center;gap:8px">
      <button onClick="{{ iv.toggleTheme }}" title="Theme" style="width:32px;height:32px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ iv.themeIcon }}"></path></svg></button>
      <div style="display:flex;padding:3px;border:1px solid var(--border);border-radius:9px;gap:2px;background:var(--surface)">
        <button onClick="{{ iv.setEn }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ iv.en.bg }};color:{{ iv.en.fg }}">EN</button>
        <button onClick="{{ iv.setFr }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ iv.fr.bg }};color:{{ iv.fr.fg }}">FR</button>
      </div>
    </div>
  </header>

  <main style="flex:1;display:flex;justify-content:center;align-items:flex-start;padding:16px 20px 56px">
  <div style="width:100%;max-width:{{ iv.cardMax }};animation:ssIn .25s ease-out">

  <sc-if value="{{ iv.isValid }}" hint-placeholder-val="{{ true }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);overflow:hidden;display:flex;flex-wrap:wrap">
      <div style="flex:1 1 300px;padding:28px;background:var(--surface-2);border-right:1px solid var(--border);display:flex;flex-direction:column;gap:20px;box-sizing:border-box">
        <div style="display:flex;align-items:center;gap:14px">
          <div style="width:56px;height:56px;border-radius:14px;background:#0D1B2E;color:#fff;display:grid;place-items:center;font-weight:700;font-size:22px;flex:none">B</div>
          <div><div style="font-weight:600;font-size:17px">Batiplus Group</div><div style="font-size:12.5px;color:var(--text-3)">{{ iv.t.coMeta }}</div></div>
        </div>
        <div style="display:flex;gap:10px;align-items:center;padding:12px;border-radius:12px;background:var(--surface);border:1px solid var(--border)">
          <div style="width:34px;height:34px;border-radius:50%;background:oklch(0.93 0.045 250);color:oklch(0.42 0.1 250);display:grid;place-items:center;font-size:12.5px;font-weight:600;flex:none">MO</div>
          <div style="font-size:13.5px;text-wrap:pretty"><strong>Marc Olivier</strong> <span style="color:var(--text-2)">{{ iv.t.invitedYou }}</span><div style="font-size:12px;color:var(--text-3)">{{ iv.t.sent }}</div></div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em">{{ iv.t.yourRole }}</div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
            <span style="display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:13px;font-weight:600"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path></svg>{{ iv.t.roleName }}</span>
            <span style="display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px;border-radius:999px;background:var(--neutral-bg);color:var(--text-2);font-size:13px;font-weight:500"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path></svg>Part-Dieu Tower</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px;margin-top:4px">
            <sc-for list="{{ iv.perms }}" as="p" hint-placeholder-count="4">
              <div style="display:flex;gap:9px;font-size:13px;color:{{ p.c }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px;color:{{ p.ic }}"><path d="{{ p.icon }}"></path></svg>{{ p.label }}</div>
            </sc-for>
          </div>
        </div>
        <div style="margin-top:auto;font-size:12px;color:var(--text-3)">{{ iv.t.expires }}</div>
      </div>

      <form onSubmit="{{ iv.accept }}" style="flex:1 1 340px;padding:28px;display:flex;flex-direction:column;gap:16px;box-sizing:border-box">
        <div><h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-.02em">{{ iv.t.title }}</h1><div style="margin-top:4px;color:var(--text-2);font-size:13.5px">{{ iv.t.sub }}</div></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <button type="button" onClick="{{ iv.sso }}" style="display:flex;align-items:center;justify-content:center;gap:8px;height:40px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><span style="font-weight:700;font-size:15px;color:#4285F4">G</span>Google</button>
          <button type="button" onClick="{{ iv.sso }}" style="display:flex;align-items:center;justify-content:center;gap:8px;height:40px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><span style="display:grid;grid-template-columns:6px 6px;gap:1.5px"><span style="width:6px;height:6px;background:#F25022"></span><span style="width:6px;height:6px;background:#7FBA00"></span><span style="width:6px;height:6px;background:#00A4EF"></span><span style="width:6px;height:6px;background:#FFB900"></span></span>Microsoft</button>
        </div>
        <div style="display:flex;align-items:center;gap:12px;color:var(--text-3);font-size:12px"><span style="flex:1;height:1px;background:var(--border)"></span>{{ iv.t.orPw }}<span style="flex:1;height:1px;background:var(--border)"></span></div>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ iv.t.email }}</span>
          <div style="display:flex;align-items:center;gap:8px;height:40px;padding:0 12px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);color:var(--text-2)"><span style="flex:1">nadia.kone@batiplus.fr</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3)"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4"></path></svg></div>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ iv.t.name }}</span>
          <input value="{{ iv.name }}" onChange="{{ iv.onName }}" disabled="{{ iv.loading }}" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ iv.nameBd }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <sc-if value="{{ iv.hasNameErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ iv.nameErr }}</span></sc-if>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ iv.t.password }}</span>
          <div style="position:relative;display:flex">
            <input value="{{ iv.pw }}" onChange="{{ iv.onPw }}" type="{{ iv.pwType }}" autocomplete="new-password" placeholder="{{ iv.t.pwPh }}" disabled="{{ iv.loading }}" style="flex:1;min-width:0;height:40px;padding:0 44px 0 12px;border-radius:9px;border:1px solid {{ iv.pwBd }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
            <button type="button" onClick="{{ iv.togglePw }}" title="{{ iv.pwAria }}" style="position:absolute;right:5px;top:5px;width:30px;height:30px;border:0;border-radius:7px;background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ iv.eyeIcon }}"></path></svg></button>
          </div>
          <div style="display:flex;align-items:center;gap:10px"><div style="flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:4px"><sc-for list="{{ iv.bars }}" as="b" hint-placeholder-count="4"><span style="height:4px;border-radius:4px;background:{{ b }}"></span></sc-for></div><span style="font-size:12px;font-weight:500;min-width:52px;text-align:right;color:{{ iv.pwColor }}">{{ iv.pwLabel }}</span></div>
          <sc-if value="{{ iv.hasPwErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ iv.pwErr }}</span></sc-if>
        </label>
        <button type="submit" disabled="{{ iv.loading }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:44px;border:0;border-radius:10px;background:var(--accent);color:#fff;font-size:14.5px;font-weight:600;cursor:pointer;margin-top:4px" style-hover="background:var(--accent-hover)">
          <sc-if value="{{ iv.loading }}"><span style="width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;animation:ssSpin .7s linear infinite;box-sizing:border-box"></span></sc-if>{{ iv.btnLabel }}
        </button>
        <div style="font-size:12px;color:var(--text-3);text-align:center;text-wrap:pretty">{{ iv.t.legal }} <a href="#">{{ iv.t.terms }}</a></div>
        <div style="font-size:12.5px;color:var(--text-2);text-align:center">{{ iv.t.notYou }} <a href="#" onClick="{{ iv.decline }}">{{ iv.t.decline }}</a></div>
      </form>
    </div>
  </sc-if>

  <sc-if value="{{ iv.isDead }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);padding:36px 32px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px">
      <div style="position:relative;margin-bottom:6px">
        <div style="width:60px;height:60px;border-radius:15px;background:#0D1B2E;color:#fff;display:grid;place-items:center;font-weight:700;font-size:24px;opacity:.5">B</div>
        <div style="position:absolute;right:-8px;bottom:-8px;width:28px;height:28px;border-radius:50%;background:{{ iv.dead.badgeBg }};color:#fff;border:3px solid var(--surface);display:grid;place-items:center"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="{{ iv.dead.icon }}"></path></svg></div>
      </div>
      <h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-.02em">{{ iv.dead.title }}</h1>
      <div style="color:var(--text-2);max-width:380px;text-wrap:pretty">{{ iv.dead.desc }}</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin:6px 0 4px;padding:10px 14px;border-radius:10px;background:var(--surface-2);font-size:12.5px;color:var(--text-2)">
        <span>Batiplus Group</span><span style="color:var(--text-3)">·</span><span>{{ iv.t.roleName }}</span><span style="color:var(--text-3)">·</span><span>nadia.kone@batiplus.fr</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:6px">
        <button onClick="{{ iv.dead.secondary }}" style="height:40px;padding:0 16px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)">{{ iv.dead.secondaryLabel }}</button>
        <button onClick="{{ iv.dead.primary }}" style="height:40px;padding:0 16px;border-radius:10px;border:0;background:var(--accent);color:#fff;font-size:13.5px;font-weight:500;cursor:pointer" style-hover="background:var(--accent-hover)">{{ iv.dead.primaryLabel }}</button>
      </div>
    </div>
  </sc-if>
  </div>
  </main>

  <div style="position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:40;display:flex;flex-direction:column;gap:8px;align-items:center">
    <sc-for list="{{ iv.toasts }}" as="tt"><div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:11px;background:var(--text);color:var(--surface);box-shadow:var(--shadow-lg);font-size:13.5px;animation:ssIn .2s ease-out"><span style="width:8px;height:8px;border-radius:50%;background:#16A34A"></span>{{ tt.msg }}</div></sc-for>
  </div>
</div>
</sc-if>
<sc-if value="{{ isWorkspaces }}">
<!-- ===== WORKSPACES ===== -->
<div data-theme="{{ ws.theme }}" style="min-height:100vh;background:var(--bg);color:var(--text);display:flex;flex-direction:column;font-size:14px;line-height:1.45">
  <header style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 28px;border-bottom:1px solid var(--border);background:var(--surface)">
    <div style="display:flex;align-items:center;gap:9px"><div style="width:30px;height:30px;border-radius:8px;background:#fff;border:1px solid var(--border);display:grid;place-items:center;overflow:hidden"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:26px;height:26px;object-fit:contain"></div><span style="font-weight:700;font-size:15px">StaffSync</span></div>
    <div style="display:flex;align-items:center;gap:10px">
      <button onClick="{{ ws.toggleTheme }}" title="Theme" style="width:32px;height:32px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ws.themeIcon }}"></path></svg></button>
      <div style="display:flex;padding:3px;border:1px solid var(--border);border-radius:9px;gap:2px">
        <button onClick="{{ ws.setEn }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ ws.en.bg }};color:{{ ws.en.fg }}">EN</button>
        <button onClick="{{ ws.setFr }}" style="border:0;height:24px;padding:0 9px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ ws.fr.bg }};color:{{ ws.fr.fg }}">FR</button>
      </div>
      <div style="width:1px;height:24px;background:var(--border)"></div>
      <div style="display:flex;align-items:center;gap:9px">
        <div style="width:32px;height:32px;border-radius:50%;background:oklch(0.93 0.045 30);color:oklch(0.42 0.1 30);display:grid;place-items:center;font-size:12px;font-weight:600">CV</div>
        <div style="line-height:1.25"><div style="font-weight:600;font-size:13px">Claire Vasseur</div><div style="font-size:12px;color:var(--text-3)">claire@batiplus.fr</div></div>
      </div>
      <button onClick="{{ ws.signOut }}" style="display:flex;align-items:center;gap:6px;height:32px;padding:0 11px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text-2);font-size:12.5px;font-weight:500;cursor:pointer" style-hover="background:var(--hover);color:var(--bad)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg>{{ ws.t.signOut }}</button>
    </div>
  </header>

  <main style="flex:1;display:flex;justify-content:center;padding:40px 24px 64px">
    <div style="width:100%;max-width:880px;display:flex;flex-direction:column;gap:20px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <div><h1 style="margin:0;font-size:26px;font-weight:600;letter-spacing:-.02em">{{ ws.t.title }}</h1><div style="margin-top:6px;color:var(--text-2)">{{ ws.subtitle }}</div></div>
        <button onClick="{{ ws.createNew }}" style="display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>{{ ws.t.create }}</button>
      </div>

      <div style="display:flex;align-items:center;gap:10px;height:42px;padding:0 14px;border:1px solid var(--border-strong);border-radius:10px;background:var(--surface);color:var(--text-3)" style-focus-within="border-color:var(--accent)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg>
        <input value="{{ ws.q }}" onChange="{{ ws.onQ }}" placeholder="{{ ws.t.search }}" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:14px">
        <sc-if value="{{ ws.hasQ }}"><button onClick="{{ ws.clearQ }}" title="Clear" style="width:24px;height:24px;border:0;border-radius:6px;background:var(--neutral-bg);color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg></button></sc-if>
      </div>

      <div style="display:flex;flex-direction:column;gap:10px">
        <sc-for list="{{ ws.cards }}" as="c" hint-placeholder-count="4">
          <button onClick="{{ c.go }}" disabled="{{ c.disabled }}" style="display:flex;align-items:center;gap:16px;padding:16px 18px;border-radius:14px;border:1px solid {{ c.bd }};background:var(--surface);color:var(--text);text-align:left;cursor:{{ c.cursor }};box-shadow:var(--shadow);opacity:{{ c.opacity }};width:100%" style-hover="border-color:var(--border-strong);background:var(--surface-2)">
            <div style="width:48px;height:48px;border-radius:12px;background:{{ c.logoBg }};color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px;flex:none">{{ c.mono }}</div>
            <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:600;font-size:15px">{{ c.name }}</span><sc-if value="{{ c.isLast }}"><span style="font-size:11px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--ok-bg);color:var(--ok)">{{ ws.t.lastUsed }}</span></sc-if><sc-if value="{{ c.suspended }}"><span style="font-size:11px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--warn-bg);color:var(--warn)">{{ ws.t.suspended }}</span></sc-if></div>
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--text-2)">
                <span style="display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:999px;background:{{ c.roleBg }};color:{{ c.roleFg }};font-weight:600;font-size:12px">{{ c.role }}</span>
                <span>{{ c.scope }}</span><span style="color:var(--text-3)">·</span><span style="color:var(--text-3)">{{ c.meta }}</span>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex:none;min-width:120px">
              <span style="font-size:12px;color:var(--text-3)">{{ ws.t.lastAccessed }}</span><span style="font-size:13px;font-weight:500">{{ c.last }}</span>
            </div>
            <div style="width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:var(--text-3);flex:none">
              <sc-if value="{{ c.loading }}"><span style="width:16px;height:16px;border-radius:50%;border:2px solid var(--border-strong);border-top-color:var(--accent);animation:ssSpin .7s linear infinite;box-sizing:border-box"></span></sc-if>
              <sc-if value="{{ c.showArrow }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></sc-if>
            </div>
          </button>
          <sc-if value="{{ c.suspended }}"><div style="display:flex;align-items:center;gap:8px;margin:-4px 0 4px 18px;font-size:12.5px;color:var(--warn)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l10 18H2zM12 10v4M12 17h.01"></path></svg>{{ ws.t.suspDesc }} <a href="#" onClick="{{ c.reactivate }}" style="font-weight:500">{{ ws.t.reactivate }}</a></div></sc-if>
        </sc-for>

        <sc-if value="{{ ws.empty }}">
          <div style="padding:48px 20px;text-align:center;background:var(--surface);border:1px dashed var(--border-strong);border-radius:14px">
            <div style="font-weight:600;font-size:15px">{{ ws.emptyTitle }}</div>
            <div style="color:var(--text-3);font-size:13px;margin:4px 0 14px">{{ ws.t.emptyDesc }}</div>
            <button onClick="{{ ws.clearQ }}" style="height:34px;padding:0 14px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer">{{ ws.t.clear }}</button>
          </div>
        </sc-if>

        <button onClick="{{ ws.createNew }}" style="display:flex;align-items:center;gap:16px;padding:16px 18px;border-radius:14px;border:1.5px dashed var(--border-strong);background:transparent;color:var(--text-2);text-align:left;cursor:pointer;width:100%" style-hover="border-color:var(--accent);color:var(--accent);background:var(--accent-soft)">
          <div style="width:48px;height:48px;border-radius:12px;border:1.5px dashed currentColor;display:grid;place-items:center;flex:none"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></div>
          <div><div style="font-weight:600;font-size:14.5px">{{ ws.t.create }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ws.t.createDesc }}</div></div>
        </button>
      </div>
      <div style="font-size:12.5px;color:var(--text-3);text-align:center">{{ ws.t.missing }}</div>
    </div>
  </main>
</div>
</sc-if>
<sc-if value="{{ isOnboarding }}">
<!-- ===== ONBOARDING ===== -->
<div data-theme="{{ ob.theme }}" style="min-height:100vh;background:var(--bg);color:var(--text);display:flex;font-size:14px;line-height:1.45">

<sc-if value="{{ ob.showRail }}" hint-placeholder-val="{{ true }}">
<aside style="width:300px;flex:none;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;box-sizing:border-box;padding:24px 20px">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:32px">
    <div style="width:34px;height:34px;border-radius:9px;background:#fff;border:1px solid var(--border);display:grid;place-items:center;overflow:hidden"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:30px;height:30px;object-fit:contain"></div>
    <div style="font-weight:700;font-size:16px;letter-spacing:-.01em">StaffSync</div>
  </div>
  <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px">Set up your workspace</div>
  <div style="display:flex;flex-direction:column;flex:1">
    <sc-for list="{{ ob.steps }}" as="s" hint-placeholder-count="8">
      <button onClick="{{ s.go }}" disabled="{{ s.locked }}" style="display:flex;gap:12px;align-items:flex-start;border:0;background:transparent;text-align:left;padding:0;cursor:{{ s.cursor }};color:inherit">
        <div style="display:flex;flex-direction:column;align-items:center;align-self:stretch">
          <span style="width:26px;height:26px;border-radius:50%;box-sizing:border-box;display:grid;place-items:center;font:600 12px 'Geist Mono',monospace;flex:none;background:{{ s.dotBg }};color:{{ s.dotFg }};border:{{ s.dotBd }}">
            <sc-if value="{{ s.done }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg></sc-if>
            <sc-if value="{{ s.notDone }}">{{ s.n }}</sc-if>
          </span>
          <sc-if value="{{ s.notLast }}"><span style="width:2px;flex:1;min-height:14px;margin:3px 0;border-radius:2px;background:{{ s.lineC }}"></span></sc-if>
        </div>
        <div style="padding:3px 0 16px"><div style="font-weight:{{ s.weight }};font-size:13.5px;color:{{ s.labelC }}">{{ s.label }}</div><div style="font-size:12px;color:var(--text-3)">{{ s.sub }}</div></div>
      </button>
    </sc-for>
  </div>
  <div style="border-top:1px solid var(--border);padding-top:16px;font-size:12.5px;color:var(--text-3)">Need help? <a href="#">Book a 15-min setup call</a></div>
</aside>
</sc-if>

<div style="flex:1;min-width:0;display:flex;flex-direction:column">
  <header style="height:60px;flex:none;display:flex;align-items:center;gap:14px;padding:0 28px;border-bottom:1px solid var(--border);background:var(--surface)">
    <sc-if value="{{ ob.compact }}"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:28px;height:28px;object-fit:contain"></sc-if>
    <div style="display:flex;flex-direction:column;gap:6px;flex:1;max-width:340px">
      <div style="font-size:12.5px;color:var(--text-2)">{{ ob.progressLabel }}</div>
      <div style="height:4px;border-radius:4px;background:var(--neutral-bg);overflow:hidden"><div style="height:100%;width:{{ ob.progressPct }};background:var(--accent);border-radius:4px;transition:width .3s"></div></div>
    </div>
    <div style="flex:1"></div>
    <sc-if value="{{ ob.canSave }}">
      <button onClick="{{ ob.saveLater }}" style="display:flex;align-items:center;gap:7px;height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border);background:transparent;color:var(--text-2);font-size:13px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h11l3 3v15H5zM8 3v5h7V3M8 21v-7h8v7"></path></svg>Save and continue later</button>
    </sc-if>
    <button onClick="{{ ob.toggleTheme }}" title="Theme" style="width:34px;height:34px;border:1px solid var(--border);border-radius:9px;background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ob.themeIcon }}"></path></svg></button>
  </header>

  <main style="flex:1;display:flex;justify-content:center;padding:36px 28px 56px;box-sizing:border-box">
  <div style="width:100%;max-width:{{ ob.contentMax }};display:flex;flex-direction:column;gap:22px;animation:ssIn .25s ease-out" key="{{ ob.step }}">

  <sc-if value="{{ ob.inWizard }}" hint-placeholder-val="{{ true }}">
    <div>
      <div style="font:500 12px 'Geist Mono',monospace;color:var(--accent);margin-bottom:6px">{{ ob.stepEyebrow }}</div>
      <h1 style="margin:0;font-size:26px;font-weight:600;letter-spacing:-.02em">{{ ob.stepTitle }}</h1>
      <div style="margin-top:6px;color:var(--text-2);font-size:14px;text-wrap:pretty">{{ ob.stepDesc }}</div>
    </div>
  </sc-if>

  <sc-if value="{{ ob.showSummary }}">
    <div style="display:flex;gap:10px;align-items:center;padding:11px 14px;border-radius:10px;background:var(--bad-bg);color:var(--bad);font-size:13px;font-weight:500"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 3l10 18H2zM12 10v4M12 17h.01"></path></svg>{{ ob.summaryText }}</div>
  </sc-if>

  <!-- STEP 1 -->
  <sc-if value="{{ ob.is1 }}" hint-placeholder-val="{{ true }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:24px;display:flex;flex-direction:column;gap:18px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px">
        <button onClick="{{ ob.sso }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:42px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><span style="width:18px;height:18px;display:grid;place-items:center;font-weight:700;font-size:15px;color:#4285F4">G</span>Sign up with Google</button>
        <button onClick="{{ ob.sso }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:42px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><span style="display:grid;grid-template-columns:7px 7px;gap:1.5px"><span style="width:7px;height:7px;background:#F25022"></span><span style="width:7px;height:7px;background:#7FBA00"></span><span style="width:7px;height:7px;background:#00A4EF"></span><span style="width:7px;height:7px;background:#FFB900"></span></span>Sign up with Microsoft</button>
      </div>
      <div style="display:flex;align-items:center;gap:12px;color:var(--text-3);font-size:12px"><span style="flex:1;height:1px;background:var(--border)"></span>or with your work email<span style="flex:1;height:1px;background:var(--border)"></span></div>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Full name</span>
        <input value="{{ ob.f.name }}" onChange="{{ ob.on.name }}" placeholder="Claire Vasseur" autocomplete="name" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.name }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        <sc-if value="{{ ob.has.name }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.name }}</span></sc-if>
      </label>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Work email</span>
        <input value="{{ ob.f.email }}" onChange="{{ ob.on.email }}" type="email" placeholder="claire@batiplus.fr" autocomplete="email" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.email }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        <sc-if value="{{ ob.has.email }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.email }}</span></sc-if>
      </label>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Password</span>
        <div style="position:relative;display:flex">
          <input value="{{ ob.f.password }}" onChange="{{ ob.on.password }}" type="{{ ob.pwType }}" placeholder="At least 8 characters" autocomplete="new-password" style="flex:1;height:40px;padding:0 64px 0 12px;border-radius:9px;border:1px solid {{ ob.bd.password }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <button onClick="{{ ob.togglePw }}" type="button" style="position:absolute;right:6px;top:6px;height:28px;padding:0 9px;border:0;border-radius:6px;background:var(--surface-2);color:var(--text-2);font-size:12px;font-weight:500;cursor:pointer">{{ ob.pwToggleLabel }}</button>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <div style="flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:4px"><sc-for list="{{ ob.pwBars }}" as="b" hint-placeholder-count="4"><span style="height:4px;border-radius:4px;background:{{ b }}"></span></sc-for></div>
          <span style="font-size:12px;font-weight:500;min-width:52px;text-align:right;color:{{ ob.pwColor }}">{{ ob.pwLabel }}</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px"><sc-for list="{{ ob.pwRules }}" as="r" hint-placeholder-count="4"><span style="display:flex;align-items:center;gap:5px;color:{{ r.c }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="{{ r.icon }}"></path></svg>{{ r.label }}</span></sc-for></div>
        <sc-if value="{{ ob.has.password }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.password }}</span></sc-if>
      </label>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Phone <span style="color:var(--text-3);font-weight:400">· for account recovery</span></span>
        <div style="display:flex;gap:8px">
          <select value="{{ ob.f.dial }}" onChange="{{ ob.on.dial }}" style="height:40px;padding:0 8px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px"><option value="+33">🇫🇷 +33</option><option value="+32">🇧🇪 +32</option><option value="+41">🇨🇭 +41</option><option value="+1">🇨🇦 +1</option><option value="+44">🇬🇧 +44</option></select>
          <input value="{{ ob.f.phone }}" onChange="{{ ob.on.phone }}" type="tel" placeholder="6 12 34 56 78" style="flex:1;min-width:0;height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.phone }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        </div>
        <sc-if value="{{ ob.has.phone }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.phone }}</span></sc-if>
      </label>
      <div style="display:flex;flex-direction:column;gap:6px">
        <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;font-size:13.5px;color:var(--text-2)">
          <input type="checkbox" checked="{{ ob.f.terms }}" onChange="{{ ob.on.terms }}" style="width:16px;height:16px;margin:2px 0 0;accent-color:#0B67DD">
          <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>, including processing of employee location data during check-ins.</span>
        </label>
        <sc-if value="{{ ob.has.terms }}"><span style="font-size:12.5px;color:var(--bad);padding-left:26px">{{ ob.err.terms }}</span></sc-if>
      </div>
    </div>
    <div style="font-size:13px;color:var(--text-3);text-align:center">Already have an account? <a href="#" onClick="{{ ob.goSignIn }}">Sign in</a></div>
  </sc-if>

  <!-- STEP 2 -->
  <sc-if value="{{ ob.is2 }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:28px 24px;display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center">
      <div style="width:52px;height:52px;border-radius:14px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v14H3zM3 6l9 7 9-7"></path></svg></div>
      <div style="font-size:14px;color:var(--text-2)">We sent a 6-digit code to <strong style="color:var(--text)">{{ ob.emailShown }}</strong></div>
      <div style="display:flex;gap:8px" onPaste="{{ ob.onPaste }}">
        <sc-for list="{{ ob.codeBoxes }}" as="c" hint-placeholder-count="6">
          <input ref="{{ c.ref }}" value="{{ c.v }}" onChange="{{ c.change }}" onKeyDown="{{ c.key }}" inputmode="numeric" maxlength="1" aria-label="{{ c.aria }}" style="width:48px;height:56px;text-align:center;border-radius:10px;border:1px solid {{ c.bd }};background:var(--surface);color:var(--text);font:600 22px 'Geist Mono',monospace;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        </sc-for>
      </div>
      <sc-if value="{{ ob.has.code }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.code }}</span></sc-if>
      <div style="font-size:13px;color:var(--text-3)">
        <sc-if value="{{ ob.resendWaiting }}"><span>Resend code in <span style="font-family:'Geist Mono',monospace;color:var(--text-2)">{{ ob.resendClock }}</span></span></sc-if>
        <sc-if value="{{ ob.resendReady }}"><span>Didn’t get it? <a href="#" onClick="{{ ob.resend }}">Resend code</a></span></sc-if>
        <span> · <a href="#" onClick="{{ ob.changeEmail }}">Change email</a></span>
      </div>
      <div style="font-size:12px;color:var(--text-3);padding:8px 12px;background:var(--surface-2);border-radius:8px">Prototype: any 6 digits work except 000000</div>
    </div>
  </sc-if>

  <!-- STEP 3 -->
  <sc-if value="{{ ob.is3 }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:24px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;gap:16px;align-items:center">
        <label style="width:72px;height:72px;border-radius:14px;border:1.5px dashed var(--border-strong);background:var(--surface-2);display:grid;place-items:center;cursor:pointer;overflow:hidden;flex:none;color:var(--text-3)" style-hover="border-color:var(--accent)">
          <input type="file" accept="image/*" onChange="{{ ob.onLogo }}" style="display:none">
          <sc-if value="{{ ob.hasLogo }}"><div role="img" aria-label="Logo" style="width:100%;height:100%;background:center/contain no-repeat;background-image:{{ ob.logoBg }}"></div></sc-if>
          <sc-if value="{{ ob.noLogo }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"></path></svg></sc-if>
        </label>
        <div><div style="font-weight:500;font-size:13.5px">Company logo <span style="color:var(--text-3);font-weight:400">· optional</span></div><div style="font-size:12.5px;color:var(--text-3)">Shown in the mobile app and on reports. PNG or SVG, square, up to 2 MB.</div></div>
      </div>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Company name</span>
        <input value="{{ ob.f.company }}" onChange="{{ ob.on.company }}" placeholder="Batiplus Group" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.company }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        <sc-if value="{{ ob.has.company }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.company }}</span></sc-if>
      </label>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Industry</span>
        <select value="{{ ob.f.industry }}" onChange="{{ ob.on.industry }}" style="height:40px;padding:0 10px;border-radius:9px;border:1px solid {{ ob.bd.industry }};background:var(--surface);color:var(--text);font-size:14px">
          <option value="">Select an industry</option><option>Construction</option><option>Logistics &amp; warehousing</option><option>Cleaning &amp; facility services</option><option>Security</option><option>Retail</option><option>Manufacturing</option><option>Healthcare</option><option>Other</option>
        </select>
        <sc-if value="{{ ob.has.industry }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.industry }}</span></sc-if>
      </label>
      <div style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Company size</span>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <sc-for list="{{ ob.sizes }}" as="z" hint-placeholder-count="5"><button onClick="{{ z.go }}" style="height:36px;padding:0 14px;border-radius:9px;border:1px solid {{ z.bd }};background:{{ z.bg }};color:{{ z.fg }};font-size:13px;font-weight:500;cursor:pointer">{{ z.label }}</button></sc-for>
        </div>
        <sc-if value="{{ ob.has.size }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.size }}</span></sc-if>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Country</span>
          <select value="{{ ob.f.country }}" onChange="{{ ob.onCountry }}" style="height:40px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px"><option>France</option><option>Belgium</option><option>Switzerland</option><option>Canada</option><option>United Kingdom</option></select>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Default timezone</span>
          <select value="{{ ob.f.tz }}" onChange="{{ ob.on.tz }}" style="height:40px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px"><option>Europe/Paris (UTC+2)</option><option>Europe/Brussels (UTC+2)</option><option>Europe/Zurich (UTC+2)</option><option>America/Montreal (UTC−4)</option><option>Europe/London (UTC+1)</option></select>
        </label>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Default language <span style="color:var(--text-3);font-weight:400">· employees can change it in the app</span></span>
        <div style="display:flex;padding:3px;border:1px solid var(--border);border-radius:10px;gap:3px;align-self:flex-start;background:var(--surface-2)">
          <button onClick="{{ ob.setLangEn }}" style="border:0;height:32px;padding:0 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;background:{{ ob.langEn.bg }};color:{{ ob.langEn.fg }};box-shadow:{{ ob.langEn.sh }}">English</button>
          <button onClick="{{ ob.setLangFr }}" style="border:0;height:32px;padding:0 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;background:{{ ob.langFr.bg }};color:{{ ob.langFr.fg }};box-shadow:{{ ob.langFr.sh }}">Français</button>
        </div>
      </div>
    </div>
  </sc-if>

  <!-- STEP 4 -->
  <sc-if value="{{ ob.is4 }}">
    <div style="display:flex;gap:12px;padding:12px 14px;border-radius:10px;background:var(--surface);border:1px solid var(--border);font-size:13px;color:var(--text-2)">
      <div style="display:flex;align-items:center;gap:6px;font:500 12px 'Geist Mono',monospace;white-space:nowrap;flex-wrap:wrap"><span style="padding:3px 8px;border-radius:6px;background:var(--neutral-bg)">{{ ob.companyShown }}</span><span>→</span><span style="padding:3px 8px;border-radius:6px;background:var(--accent-soft);color:var(--accent)">Branch</span><span>→</span><span style="padding:3px 8px;border-radius:6px;background:var(--neutral-bg)">Sites</span></div>
      <span style="text-wrap:pretty">Branches group sites, usually by city or region. Branch managers only see their own branch.</span>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:24px;display:flex;flex-direction:column;gap:18px">
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Branch name</span>
        <input value="{{ ob.f.branch }}" onChange="{{ ob.on.branch }}" placeholder="Lyon" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.branch }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        <sc-if value="{{ ob.has.branch }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.branch }}</span></sc-if>
      </label>
      <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Street address</span>
        <input value="{{ ob.f.street }}" onChange="{{ ob.on.street }}" placeholder="17 Boulevard Vivier-Merle" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.street }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        <sc-if value="{{ ob.has.street }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.street }}</span></sc-if>
      </label>
      <div style="display:grid;grid-template-columns:140px minmax(0,1fr) minmax(0,1fr);gap:16px">
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Postal code</span>
          <input value="{{ ob.f.zip }}" onChange="{{ ob.on.zip }}" placeholder="69003" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.zip }};background:var(--surface);color:var(--text);font-size:14px;outline:none;min-width:0" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <sc-if value="{{ ob.has.zip }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.zip }}</span></sc-if>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">City</span>
          <input value="{{ ob.f.city }}" onChange="{{ ob.on.city }}" placeholder="Lyon" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.city }};background:var(--surface);color:var(--text);font-size:14px;outline:none;min-width:0" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <sc-if value="{{ ob.has.city }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.city }}</span></sc-if>
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Country</span>
          <input value="{{ ob.f.country }}" readonly style="height:40px;padding:0 12px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);color:var(--text-2);font-size:14px;outline:none;min-width:0">
        </label>
      </div>
    </div>
  </sc-if>

  <!-- STEP 5 -->
  <sc-if value="{{ ob.is5 }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);overflow:hidden;display:flex;flex-wrap:wrap">
      <div style="flex:1 1 300px;padding:24px;display:flex;flex-direction:column;gap:18px;box-sizing:border-box">
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Site name</span>
          <input value="{{ ob.f.siteName }}" onChange="{{ ob.on.siteName }}" placeholder="Part-Dieu Tower" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.siteName }};background:var(--surface);color:var(--text);font-size:14px;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
          <sc-if value="{{ ob.has.siteName }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.siteName }}</span></sc-if>
        </label>
        <div style="display:flex;flex-direction:column;gap:6px;position:relative"><span style="font-size:13px;font-weight:500">Address</span>
          <div style="display:flex;align-items:center;gap:8px;height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.siteAddr }};background:var(--surface);color:var(--text-3)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg>
            <input value="{{ ob.f.siteAddr }}" onChange="{{ ob.onAddr }}" onFocus="{{ ob.openSug }}" placeholder="Search an address" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:14px">
          </div>
          <sc-if value="{{ ob.showSug }}">
            <div style="position:absolute;top:70px;left:0;right:0;z-index:5;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-lg);overflow:hidden">
              <sc-for list="{{ ob.sugs }}" as="g" hint-placeholder-count="4">
                <button onClick="{{ g.pick }}" style="display:flex;gap:10px;align-items:flex-start;width:100%;padding:10px 12px;border:0;background:transparent;text-align:left;cursor:pointer;color:var(--text)" style-hover="background:var(--hover)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3);margin-top:2px;flex:none"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"></path></svg>
                  <span><span style="display:block;font-size:13.5px;font-weight:500">{{ g.line1 }}</span><span style="display:block;font-size:12px;color:var(--text-3)">{{ g.line2 }}</span></span>
                </button>
              </sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ ob.has.siteAddr }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.siteAddr }}</span></sc-if>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:13px;font-weight:500">Geofence radius</span><span style="font:600 15px 'Geist Mono',monospace;color:var(--accent)">{{ ob.f.radius }} m</span></div>
          <input type="range" min="50" max="500" step="10" value="{{ ob.f.radius }}" onChange="{{ ob.on.radius }}" style="width:100%">
          <div style="display:flex;justify-content:space-between;font:400 11px 'Geist Mono',monospace;color:var(--text-3)"><span>50 m</span><span>500 m</span></div>
          <div style="font-size:12.5px;color:var(--text-2);padding:10px 12px;border-radius:9px;background:var(--surface-2);text-wrap:pretty">{{ ob.radiusHint }}</div>
        </div>
      </div>
      <div style="flex:1.4 1 380px;min-height:360px;position:relative;background:var(--map-bg);border-left:1px solid var(--border);cursor:crosshair;overflow:hidden" onClick="{{ ob.onMapClick }}" ref="{{ ob.mapRef }}">
        <svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%">
          <rect x="30" y="24" width="120" height="70" rx="4" style="fill:var(--map-block)"></rect><rect x="200" y="20" width="150" height="60" rx="4" style="fill:var(--map-block)"></rect><rect x="420" y="110" width="150" height="90" rx="4" style="fill:var(--map-block)"></rect><rect x="30" y="140" width="110" height="100" rx="4" style="fill:var(--map-block)"></rect><rect x="390" y="16" width="190" height="56" rx="4" style="fill:var(--map-block)"></rect><rect x="200" y="250" width="130" height="60" rx="4" style="fill:var(--map-block)"></rect>
          <path d="M0 340 C 120 310, 220 400, 360 370 S 540 320, 600 344 L600 420 L0 420Z" style="fill:var(--map-water)"></path>
          <g style="stroke:var(--map-road);fill:none" stroke-linecap="round"><path d="M0 106 L600 92" stroke-width="10"></path><path d="M170 0 L184 420" stroke-width="10"></path><path d="M0 236 L600 222" stroke-width="7"></path><path d="M370 0 L452 420" stroke-width="7"></path><path d="M260 92 L272 236" stroke-width="4"></path><path d="M0 170 L600 160" stroke-width="4"></path><path d="M520 0 L534 230" stroke-width="4"></path></g>
          <circle cx="{{ ob.pinX }}" cy="{{ ob.pinY }}" r="{{ ob.fenceR }}" style="fill:var(--fence);stroke:var(--accent);stroke-width:2;stroke-dasharray:7 5;transition:r .15s"></circle>
          <circle cx="{{ ob.pinX }}" cy="{{ ob.pinY }}" r="4" style="fill:var(--accent)"></circle>
          <path d="{{ ob.pinPath }}" style="fill:var(--accent);stroke:var(--surface);stroke-width:2.5"></path>
          <circle cx="{{ ob.pinX }}" cy="{{ ob.pinHeadY }}" r="5" style="fill:#fff"></circle>
        </svg>
        <div style="position:absolute;left:14px;top:14px;padding:7px 11px;border-radius:9px;background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadow);font-size:12.5px;color:var(--text-2);display:flex;gap:7px;align-items:center;pointer-events:none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path></svg>Click the map to move the pin</div>
        <div style="position:absolute;right:14px;bottom:14px;padding:6px 10px;border-radius:8px;background:var(--surface);border:1px solid var(--border);font:500 11.5px 'Geist Mono',monospace;color:var(--text-2);pointer-events:none">{{ ob.coords }}</div>
        <div style="position:absolute;left:14px;bottom:14px;display:flex;align-items:center;gap:6px;pointer-events:none"><span style="width:60px;height:4px;border:1.5px solid var(--text-2);border-top:0;box-sizing:border-box"></span><span style="font:500 11px 'Geist Mono',monospace;color:var(--text-2)">100 m</span></div>
      </div>
    </div>
  </sc-if>

  <!-- STEP 6 -->
  <sc-if value="{{ ob.is6 }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:24px;display:flex;flex-direction:column;gap:22px">
      <div style="display:flex;flex-direction:column;gap:8px"><span style="font-size:13px;font-weight:500">Working days</span>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <sc-for list="{{ ob.days }}" as="dy" hint-placeholder-count="7"><button onClick="{{ dy.go }}" style="width:52px;height:44px;border-radius:10px;border:1px solid {{ dy.bd }};background:{{ dy.bg }};color:{{ dy.fg }};font-size:13px;font-weight:600;cursor:pointer">{{ dy.label }}</button></sc-for>
        </div>
        <sc-if value="{{ ob.has.days }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.days }}</span></sc-if>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px">
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">Start time</span>
          <input type="time" value="{{ ob.f.start }}" onChange="{{ ob.on.start }}" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 14px 'Geist Mono',monospace;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        </label>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">End time</span>
          <input type="time" value="{{ ob.f.end }}" onChange="{{ ob.on.end }}" style="height:40px;padding:0 12px;border-radius:9px;border:1px solid {{ ob.bd.end }};background:var(--surface);color:var(--text);font:500 14px 'Geist Mono',monospace;outline:none" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
        </label>
      </div>
      <sc-if value="{{ ob.has.end }}"><span style="font-size:12.5px;color:var(--bad);margin-top:-14px">{{ ob.err.end }}</span></sc-if>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:13px;font-weight:500">Grace period for lateness</span><span style="font:600 15px 'Geist Mono',monospace;color:var(--accent)">{{ ob.f.grace }} min</span></div>
        <input type="range" min="0" max="30" step="5" value="{{ ob.f.grace }}" onChange="{{ ob.on.grace }}" style="width:100%">
        <div style="display:flex;justify-content:space-between;font:400 11px 'Geist Mono',monospace;color:var(--text-3)"><span>0</span><span>5</span><span>10</span><span>15</span><span>20</span><span>25</span><span>30</span></div>
      </div>
      <div style="border:1px solid var(--border);border-radius:12px;padding:16px;background:var(--surface-2);display:flex;flex-direction:column;gap:12px">
        <div style="font-size:12px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em">How check-ins will be classified</div>
        <div style="position:relative;height:28px;border-radius:7px;overflow:hidden;display:flex;font:500 11.5px 'Geist Mono',monospace">
          <div style="flex:1;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center">On time</div>
          <div style="width:{{ ob.graceW }};background:var(--ok-bg);color:var(--ok);display:grid;place-items:center;border-left:1px dashed var(--ok-dot)"></div>
          <div style="flex:1.4;background:var(--warn-bg);color:var(--warn);display:grid;place-items:center">Late</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--text-2)">
          <span style="display:flex;gap:8px;align-items:center"><span style="width:8px;height:8px;border-radius:50%;background:var(--ok-dot)"></span>{{ ob.ruleOnTime }}</span>
          <span style="display:flex;gap:8px;align-items:center"><span style="width:8px;height:8px;border-radius:50%;background:var(--warn-dot)"></span>{{ ob.ruleLate }}</span>
          <span style="display:flex;gap:8px;align-items:center"><span style="width:8px;height:8px;border-radius:50%;background:var(--text-3)"></span>{{ ob.ruleHours }}</span>
        </div>
      </div>
      <div style="font-size:12.5px;color:var(--text-3)">These are company defaults. You can override them per site or per employee schedule later.</div>
    </div>
  </sc-if>

  <!-- STEP 7 -->
  <sc-if value="{{ ob.is7 }}">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);overflow:hidden">
      <div style="display:flex;gap:20px;padding:0 24px;border-bottom:1px solid var(--border)">
        <button onClick="{{ ob.modeManual }}" style="border:0;background:transparent;padding:14px 0 12px;margin-bottom:-1px;border-bottom:2px solid {{ ob.tabManual.bd }};color:{{ ob.tabManual.fg }};font-size:13.5px;font-weight:500;cursor:pointer">Add manually</button>
        <button onClick="{{ ob.modeCsv }}" style="border:0;background:transparent;padding:14px 0 12px;margin-bottom:-1px;border-bottom:2px solid {{ ob.tabCsv.bd }};color:{{ ob.tabCsv.fg }};font-size:13.5px;font-weight:500;cursor:pointer">Upload CSV</button>
      </div>
      <sc-if value="{{ ob.isManual }}">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:10px">
          <div style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.3fr) 160px 36px;gap:10px;font-size:12px;color:var(--text-3);font-weight:500"><span>Full name</span><span>Phone or email</span><span>Role</span><span></span></div>
          <sc-for list="{{ ob.people }}" as="p" hint-placeholder-count="3">
            <div style="display:flex;flex-direction:column;gap:4px">
              <div style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.3fr) 160px 36px;gap:10px">
                <input value="{{ p.name }}" onChange="{{ p.onName }}" placeholder="Name" style="height:38px;padding:0 10px;border-radius:9px;border:1px solid {{ p.bdName }};background:var(--surface);color:var(--text);font-size:13.5px;outline:none;min-width:0" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
                <input value="{{ p.contact }}" onChange="{{ p.onContact }}" placeholder="+33 6… or name@company.com" style="height:38px;padding:0 10px;border-radius:9px;border:1px solid {{ p.bdContact }};background:var(--surface);color:var(--text);font-size:13.5px;outline:none;min-width:0" style-focus="border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)">
                <select value="{{ p.role }}" onChange="{{ p.onRole }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px;min-width:0"><option value="employee">Employee</option><option value="site">Site manager</option><option value="branch">Branch manager</option><option value="admin">Admin</option></select>
                <button onClick="{{ p.remove }}" title="Remove" style="width:36px;height:38px;border-radius:9px;border:1px solid var(--border);background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer" style-hover="color:var(--bad);background:var(--bad-bg)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
              </div>
              <sc-if value="{{ p.hasErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ p.err }}</span></sc-if>
            </div>
          </sc-for>
          <button onClick="{{ ob.addPerson }}" style="align-self:flex-start;display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:9px;border:1px dashed var(--border-strong);background:transparent;color:var(--accent);font-size:13px;font-weight:500;cursor:pointer;margin-top:4px" style-hover="background:var(--accent-soft)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>Add another person</button>
          <div style="font-size:12.5px;color:var(--text-3);margin-top:6px;text-wrap:pretty">People with a phone number get an SMS invite to the mobile app. Employees without a smartphone can be checked in by their site manager.</div>
        </div>
      </sc-if>
      <sc-if value="{{ ob.isCsv }}">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px">
          <label style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:32px 20px;border:1.5px dashed {{ ob.csvBd }};border-radius:12px;background:var(--surface-2);cursor:pointer;text-align:center" style-hover="border-color:var(--accent)">
            <input type="file" accept=".csv,text/csv" onChange="{{ ob.onCsv }}" style="display:none">
            <div style="width:44px;height:44px;border-radius:12px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"></path></svg></div>
            <div style="font-weight:600">{{ ob.csvTitle }}</div>
            <div style="font-size:12.5px;color:var(--text-3)">{{ ob.csvSub }}</div>
          </label>
          <sc-if value="{{ ob.hasCsvRows }}">
            <div style="border:1px solid var(--border);border-radius:10px;overflow:hidden;font-size:13px">
              <sc-for list="{{ ob.csvRows }}" as="cr"><div style="display:grid;grid-template-columns:1fr 1.3fr .8fr;gap:10px;padding:8px 12px;border-bottom:1px solid var(--border)"><span>{{ cr.a }}</span><span style="color:var(--text-2)">{{ cr.b }}</span><span style="color:var(--text-2)">{{ cr.c }}</span></div></sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ ob.has.csv }}"><span style="font-size:12.5px;color:var(--bad)">{{ ob.err.csv }}</span></sc-if>
          <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text-2)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6v18h12V7zM14 3v4h4M9 13h6M9 17h6"></path></svg>Columns: name, phone_or_email, role, site · <a href="#" onClick="{{ ob.downloadTemplate }}">Download CSV template</a></div>
        </div>
      </sc-if>
    </div>
  </sc-if>

  <!-- STEP 8 -->
  <sc-if value="{{ ob.is8 }}">
    <div style="display:flex;justify-content:center">
      <div style="display:flex;padding:3px;border:1px solid var(--border);border-radius:11px;gap:3px;background:var(--surface)">
        <button onClick="{{ ob.billMonthly }}" style="border:0;height:34px;padding:0 18px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;background:{{ ob.billM.bg }};color:{{ ob.billM.fg }}">Monthly</button>
        <button onClick="{{ ob.billYearly }}" style="border:0;height:34px;padding:0 14px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;background:{{ ob.billY.bg }};color:{{ ob.billY.fg }};display:flex;align-items:center;gap:8px">Yearly<span style="font-size:11px;font-weight:600;padding:2px 6px;border-radius:999px;background:var(--ok-bg);color:var(--ok)">−20%</span></button>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
      <sc-for list="{{ ob.plans }}" as="pl" hint-placeholder-count="4">
        <button onClick="{{ pl.go }}" style="position:relative;text-align:left;display:flex;flex-direction:column;gap:14px;padding:20px 18px;border-radius:14px;border:{{ pl.bd }};background:var(--surface);color:var(--text);cursor:pointer;box-shadow:{{ pl.sh }}">
          <sc-if value="{{ pl.rec }}"><span style="position:absolute;top:-10px;left:18px;font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;background:var(--accent);color:#fff">Recommended for {{ ob.sizeShown }}</span></sc-if>
          <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-weight:600;font-size:15px">{{ pl.name }}</span><span style="width:18px;height:18px;border-radius:50%;box-sizing:border-box;border:{{ pl.radio }};background:var(--surface)"></span></div>
          <div><div style="display:flex;align-items:baseline;gap:4px"><span style="font-size:28px;font-weight:600;letter-spacing:-.02em">{{ pl.price }}</span><span style="font-size:12.5px;color:var(--text-3)">{{ pl.unit }}</span></div><div style="font-size:12.5px;color:var(--text-2);min-height:18px">{{ pl.note }}</div></div>
          <div style="font-size:12.5px;font-weight:500;padding:6px 10px;border-radius:8px;background:var(--surface-2);color:var(--text-2)">{{ pl.cap }}</div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <sc-for list="{{ pl.feats }}" as="ft"><span style="display:flex;gap:8px;font-size:12.5px;color:var(--text-2)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="color:var(--ok-dot);flex:none;margin-top:2px"><path d="M5 12l5 5L20 7"></path></svg>{{ ft }}</span></sc-for>
          </div>
        </button>
      </sc-for>
    </div>
    <div style="font-size:12.5px;color:var(--text-3);text-align:center">Every plan starts with a 14-day trial. No card needed until it ends. Prices exclude VAT.</div>
  </sc-if>

  <!-- FINISH -->
  <sc-if value="{{ ob.isDone }}">
    <div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;padding-top:12px">
      <div style="width:64px;height:64px;border-radius:50%;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg></div>
      <h1 style="margin:8px 0 0;font-size:28px;font-weight:600;letter-spacing:-.02em">{{ ob.doneTitle }}</h1>
      <div style="color:var(--text-2);max-width:460px;text-wrap:pretty">{{ ob.doneSub }}</div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">
      <sc-for list="{{ ob.recap }}" as="rc" hint-placeholder-count="4"><div style="padding:12px 14px;border-radius:11px;background:var(--surface);border:1px solid var(--border)"><div style="font-size:12px;color:var(--text-3)">{{ rc.k }}</div><div style="font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ rc.v }}</div></div></sc-for>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);overflow:hidden">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--border)"><span style="font-weight:600">Next steps</span><span style="font:500 12px 'Geist Mono',monospace;color:var(--text-3)">{{ ob.checkDone }}/3</span></div>
      <sc-for list="{{ ob.checklist }}" as="ck" hint-placeholder-count="3">
        <div style="display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--border)">
          <button onClick="{{ ck.toggle }}" style="width:22px;height:22px;border-radius:50%;border:{{ ck.bd }};background:{{ ck.bg }};color:#fff;display:grid;place-items:center;cursor:pointer;flex:none;padding:0"><sc-if value="{{ ck.done }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg></sc-if></button>
          <div style="flex:1;min-width:0"><div style="font-weight:500;text-decoration:{{ ck.deco }};color:{{ ck.fg }}">{{ ck.title }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ck.sub }}</div></div>
          <button onClick="{{ ck.act }}" style="height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap" style-hover="background:var(--hover)">{{ ck.cta }}</button>
        </div>
      </sc-for>
    </div>
    <div style="display:flex;justify-content:center"><a href="#" onClick="{{ ob.goDash }}" style="display:flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:10px;background:var(--accent);color:#fff;font-weight:500;text-decoration:none">Go to dashboard<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
  </sc-if>

  <sc-if value="{{ ob.inWizard }}" hint-placeholder-val="{{ true }}">
    <div style="display:flex;align-items:center;gap:10px;padding-top:4px">
      <sc-if value="{{ ob.canBack }}"><button onClick="{{ ob.back }}" style="display:flex;align-items:center;gap:6px;height:42px;padding:0 16px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:14px;font-weight:500;cursor:pointer" style-hover="background:var(--hover)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>Back</button></sc-if>
      <div style="flex:1"></div>
      <sc-if value="{{ ob.is7 }}"><button onClick="{{ ob.skip }}" style="height:42px;padding:0 14px;border-radius:10px;border:0;background:transparent;color:var(--text-2);font-size:14px;font-weight:500;cursor:pointer" style-hover="color:var(--text)">Skip for now</button></sc-if>
      <button onClick="{{ ob.next }}" style="display:flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:10px;border:0;background:var(--accent);color:#fff;font-size:14px;font-weight:500;cursor:pointer;opacity:{{ ob.nextOpacity }}" style-hover="background:var(--accent-hover)">{{ ob.nextLabel }}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
    </div>
  </sc-if>
  </div>
  </main>
</div>

<div style="position:fixed;right:20px;bottom:20px;z-index:40;display:flex;flex-direction:column;gap:8px;align-items:flex-end">
  <sc-for list="{{ ob.toasts }}" as="tt">
    <div style="display:flex;align-items:center;gap:10px;min-width:280px;max-width:400px;padding:12px 14px;border-radius:11px;background:var(--text);color:var(--surface);box-shadow:var(--shadow-lg);font-size:13.5px;animation:ssIn .2s ease-out">
      <span style="width:20px;height:20px;border-radius:50%;background:{{ tt.c }};display:grid;place-items:center;flex:none;color:#fff"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg></span>
      <span style="flex:1">{{ tt.msg }}</span>
    </div>
  </sc-for>
</div>
</div>
</sc-if>
<sc-if value="{{ isAdmin }}">
<!-- ===== ADMIN ===== -->
<div style="min-height:100vh;background:{{ ad.outerBg }};padding:{{ ad.outerPad }};box-sizing:border-box">
<div data-theme="{{ ad.theme }}" style="min-height:100vh;height:{{ ad.frameH }};overflow:{{ ad.frameOv }};max-width:{{ ad.frameMax }};margin:0 auto;transform:{{ ad.frameT }};border-radius:{{ ad.frameR }};box-shadow:{{ ad.frameSh }};background:var(--bg);color:var(--text);display:flex;font-size:14px;line-height:1.45">

<sc-if value="{{ ad.navOverlay }}"><div onClick="{{ ad.closeNav }}" style="position:fixed;inset:0;background:var(--overlay);z-index:59"></div></sc-if>
<aside style="width:{{ ad.sideW }};flex:none;background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;position:{{ ad.asidePos }};top:0;left:0;z-index:{{ ad.asideZ }};transform:{{ ad.asideT }};box-shadow:{{ ad.asideSh }};height:100vh;box-sizing:border-box;padding:14px 12px 12px;transition:width .18s ease,transform .22s ease">
  <div style="display:flex;align-items:center;gap:10px;padding:2px 4px 16px;justify-content:{{ ad.navJustify }}">
    <div style="width:34px;height:34px;border-radius:9px;background:#fff;border:1px solid var(--border);display:grid;place-items:center;flex:none;overflow:hidden"><img src="assets/staffsync-logo.png" alt="StaffSync" style="width:30px;height:30px;object-fit:contain"></div>
    <sc-if value="{{ ad.showLabels }}" hint-placeholder-val="{{ true }}"><div style="font-weight:700;font-size:16px;letter-spacing:-.01em;flex:1">StaffSync</div></sc-if>
    <sc-if value="{{ ad.isTablet }}"><button onClick="{{ ad.closeNav }}" title="{{ ad.st.close }}" style="width:32px;height:32px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M18 6L6 18M6 6l12 12"></path></svg></button></sc-if>
  </div>
  <nav style="display:flex;flex-direction:column;gap:14px;flex:1;overflow-y:auto;overflow-x:hidden;margin:0 -4px;padding:0 4px">
    <sc-for list="{{ ad.navGroups }}" as="g" hint-placeholder-count="3">
      <div style="display:flex;flex-direction:column;gap:2px">
        <sc-if value="{{ g.showLabel }}" hint-placeholder-val="{{ true }}"><div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;padding:0 10px 6px;white-space:nowrap">{{ g.label }}</div></sc-if>
        <sc-if value="{{ g.showDivider }}"><div style="height:1px;background:var(--border);margin:0 8px 10px"></div></sc-if>
        <sc-for list="{{ g.items }}" as="it" hint-placeholder-count="4">
          <button onClick="{{ it.go }}" title="{{ it.label }}" aria-current="{{ it.current }}" style="position:relative;display:flex;align-items:center;gap:10px;height:36px;padding:0 10px;border:0;border-radius:8px;background:{{ it.bg }};color:{{ it.fg }};font-size:13.5px;font-weight:{{ it.weight }};cursor:pointer;text-align:left;justify-content:{{ it.justify }}" style-hover="color:var(--text);background:var(--hover)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="{{ it.icon }}"></path></svg>
            <sc-if value="{{ it.showLabel }}" hint-placeholder-val="{{ true }}"><span style="flex:1;white-space:nowrap">{{ it.label }}</span></sc-if>
            <sc-if value="{{ it.hasBadge }}"><span style="min-width:20px;height:20px;padding:0 6px;box-sizing:border-box;border-radius:999px;background:{{ it.badgeBg }};color:#fff;font-size:11px;font-weight:600;display:grid;place-items:center">{{ it.badge }}</span></sc-if>
            <sc-if value="{{ it.dotBadge }}"><span style="position:absolute;top:5px;right:9px;min-width:16px;height:16px;padding:0 4px;box-sizing:border-box;border-radius:999px;background:{{ it.badgeBg }};color:#fff;font-size:9.5px;font-weight:700;display:grid;place-items:center;border:2px solid var(--sidebar)">{{ it.badge }}</span></sc-if>
          </button>
        </sc-for>
      </div>
    </sc-for>
  </nav>
  <sc-if value="{{ ad.showPlan }}">
    <sc-if value="{{ ad.showLabels }}">
      <div style="margin-top:12px;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);display:flex;flex-direction:column;gap:8px">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><span style="font-size:12.5px;font-weight:600;white-space:nowrap">{{ ad.plan.name }}</span><a href="#" onClick="{{ ad.upgrade }}" style="font-size:12px;font-weight:500">{{ ad.st.upgrade }}</a></div>
        <div style="height:6px;border-radius:6px;background:var(--neutral-bg);overflow:hidden"><div style="height:100%;width:{{ ad.plan.pct }};background:{{ ad.plan.c }};border-radius:6px"></div></div>
        <div style="font-size:12px;color:var(--text-2);white-space:nowrap"><span style="font:600 12px 'Geist Mono',monospace;color:var(--text)">{{ ad.plan.used }}</span> {{ ad.plan.unit }}</div>
      </div>
    </sc-if>
    <sc-if value="{{ ad.collapsedNav }}">
      <button onClick="{{ ad.upgrade }}" title="{{ ad.plan.tip }}" style="margin-top:10px;display:flex;flex-direction:column;align-items:center;gap:5px;padding:8px 0;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);cursor:pointer;color:var(--text)">
        <span style="font:600 11px 'Geist Mono',monospace">{{ ad.plan.pctShort }}</span>
        <span style="width:28px;height:4px;border-radius:4px;background:var(--neutral-bg);overflow:hidden;display:block"><span style="display:block;height:100%;width:{{ ad.plan.pct }};background:{{ ad.plan.c }}"></span></span>
      </button>
    </sc-if>
  </sc-if>
  <sc-if value="{{ ad.isDesk }}" hint-placeholder-val="{{ true }}">
    <button onClick="{{ ad.toggleCollapse }}" title="{{ ad.collapseLabel }}" style="margin-top:8px;display:flex;align-items:center;gap:10px;height:34px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--text-3);font-size:13px;font-weight:500;cursor:pointer;justify-content:{{ ad.navJustify }}" style-hover="background:var(--hover);color:var(--text)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="{{ ad.collapseIcon }}"></path></svg>
      <sc-if value="{{ ad.showLabels }}" hint-placeholder-val="{{ true }}"><span style="white-space:nowrap">{{ ad.collapseLabel }}</span></sc-if>
    </button>
  </sc-if>
</aside>

<div style="flex:1;min-width:0;display:flex;flex-direction:column">
  <header style="height:64px;flex:none;display:flex;align-items:center;gap:10px;padding:0 {{ ad.hdrPad }};border-bottom:1px solid var(--border);background:var(--surface);position:sticky;top:0;z-index:{{ ad.hdrZ }}">
    <sc-if value="{{ ad.anyOpen }}"><div onClick="{{ ad.closeAll }}" style="position:fixed;inset:0;z-index:0"></div></sc-if>
    <sc-if value="{{ ad.isTablet }}">
      <button onClick="{{ ad.openNav }}" title="{{ ad.st.menu }}" aria-label="{{ ad.st.menu }}" style="width:38px;height:38px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;position:relative;z-index:1"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
    </sc-if>

    <div style="position:relative;z-index:1;min-width:0">
      <button onClick="{{ ad.tog.scope }}" style="display:flex;align-items:center;gap:10px;height:42px;padding:0 10px 0 6px;border:1px solid {{ ad.bdScope }};border-radius:10px;background:var(--surface);color:var(--text);cursor:pointer;max-width:{{ ad.scopeMax }};box-sizing:border-box" style-hover="background:var(--hover)">
        <span style="width:30px;height:30px;border-radius:8px;background:{{ ad.scopeIconBg }};color:{{ ad.scopeIconFg }};display:grid;place-items:center;flex:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.scopeIcon }}"></path></svg></span>
        <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;min-width:0;text-align:left"><span style="font-size:11px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">{{ ad.scopeKicker }}</span><span style="font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">{{ ad.scopeLabel }}</span></span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3);flex:none"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"></path></svg>
      </button>
      <sc-if value="{{ ad.open.scope }}">
        <div style="position:absolute;top:calc(100% + 8px);background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:2;animation:ssIn .14s ease-out;overflow:hidden;left:0;width:340px;max-width:calc(100vw - 32px);display:flex;flex-direction:column">
          <div style="padding:10px;border-bottom:1px solid var(--border)">
            <div style="display:flex;align-items:center;gap:8px;height:36px;padding:0 10px;border:1px solid var(--border-strong);border-radius:9px;color:var(--text-3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg><input value="{{ ad.scopeQ }}" onChange="{{ ad.onScopeQ }}" autoFocus="{{ true }}" placeholder="{{ ad.st.scopeSearch }}" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:13.5px"></div>
          </div>
          <div style="max-height:360px;overflow:auto;padding:6px">
            <sc-for list="{{ ad.scopeRows }}" as="sr" hint-placeholder-count="5">
              <div style="display:flex;align-items:center;gap:2px;padding-left:{{ sr.indent }}">
                <sc-if value="{{ sr.hasToggle }}"><button onClick="{{ sr.toggle }}" title="{{ sr.toggleTip }}" style="width:22px;height:22px;border:0;border-radius:6px;background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer;flex:none;padding:0" style-hover="background:var(--hover)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="transform:{{ sr.chev }};transition:transform .15s"><path d="M9 6l6 6-6 6"></path></svg></button></sc-if>
                <sc-if value="{{ sr.noToggle }}"><span style="width:22px;flex:none"></span></sc-if>
                <button onClick="{{ sr.go }}" style="flex:1;min-width:0;display:flex;align-items:center;gap:10px;padding:7px 8px;border:0;border-radius:8px;background:{{ sr.bg }};color:var(--text);cursor:pointer;text-align:left" style-hover="background:var(--hover)">
                  <span style="width:26px;height:26px;border-radius:7px;background:{{ sr.ib }};color:{{ sr.if }};display:grid;place-items:center;flex:none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ sr.icon }}"></path></svg></span>
                  <span style="flex:1;min-width:0"><span style="display:block;font-size:13.5px;font-weight:{{ sr.weight }};white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ sr.label }}</span><span style="display:block;font-size:11.5px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ sr.sub }}</span></span>
                  <sc-if value="{{ sr.selected }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent);flex:none"><path d="M5 12l5 5L20 7"></path></svg></sc-if>
                </button>
              </div>
            </sc-for>
            <sc-if value="{{ ad.scopeEmpty }}"><div style="padding:20px 12px;text-align:center;font-size:13px;color:var(--text-3)">{{ ad.scopeEmptyMsg }}</div></sc-if>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 12px;border-top:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text-3)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4"></path></svg>{{ ad.scopeNote }}</div>
        </div>
      </sc-if>
    </div>

    <div style="position:relative;z-index:1;flex:{{ ad.searchFlex }};max-width:460px;min-width:0">
      <sc-if value="{{ ad.isDesk }}" hint-placeholder-val="{{ true }}">
        <div style="display:flex;align-items:center;gap:8px;height:40px;padding:0 8px 0 12px;border:1px solid {{ ad.bdSearch }};border-radius:10px;background:var(--surface-2);color:var(--text-3);box-shadow:{{ ad.searchRing }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg>
          <input ref="{{ ad.searchRef }}" value="{{ ad.searchQ }}" onChange="{{ ad.onSearchQ }}" onFocus="{{ ad.openSearch }}" placeholder="{{ ad.st.search }}" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:13.5px">
          <span style="font:500 11px 'Geist Mono',monospace;padding:2px 6px;border:1px solid var(--border);border-radius:5px;background:var(--surface);white-space:nowrap">⌘K</span>
        </div>
      </sc-if>
      <sc-if value="{{ ad.isTablet }}"><button onClick="{{ ad.tog.search }}" title="{{ ad.st.searchShort }}" style="width:38px;height:38px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;position:relative"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg></button></sc-if>
      <sc-if value="{{ ad.open.search }}">
        <div style="position:{{ ad.sd.pos }};top:{{ ad.sd.top }};left:{{ ad.sd.left }};right:{{ ad.sd.right }};width:{{ ad.sd.w }};background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:2;animation:ssIn .14s ease-out;overflow:hidden">
          <sc-if value="{{ ad.isTablet }}">
            <div style="padding:10px;border-bottom:1px solid var(--border)"><div style="display:flex;align-items:center;gap:8px;height:40px;padding:0 10px;border:1px solid var(--accent);border-radius:9px;color:var(--text-3)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg><input ref="{{ ad.searchRef }}" value="{{ ad.searchQ }}" onChange="{{ ad.onSearchQ }}" autoFocus="{{ true }}" placeholder="{{ ad.st.search }}" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:14px"></div></div>
          </sc-if>
          <div style="max-height:440px;overflow:auto;padding:4px 0 6px">
            <sc-for list="{{ ad.searchGroups }}" as="sg" hint-placeholder-count="3">
              <div style="display:flex;justify-content:space-between;padding:10px 14px 4px;font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em"><span>{{ sg.label }}</span><span style="font-family:'Geist Mono',monospace">{{ sg.count }}</span></div>
              <sc-for list="{{ sg.items }}" as="sx" hint-placeholder-count="3">
                <button onClick="{{ sx.go }}" style="display:flex;align-items:center;gap:12px;width:100%;padding:8px 14px;border:0;background:transparent;color:var(--text);cursor:pointer;text-align:left" style-hover="background:var(--hover)">
                  <span style="width:30px;height:30px;border-radius:{{ sx.radius }};background:{{ sx.bg }};color:{{ sx.fg }};display:grid;place-items:center;font-size:11.5px;font-weight:600;flex:none">{{ sx.ini }}<sc-if value="{{ sx.hasIcon }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ sx.icon }}"></path></svg></sc-if></span>
                  <span style="flex:1;min-width:0"><span style="display:block;font-size:13.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ sx.label }}</span><span style="display:block;font-size:12px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ sx.sub }}</span></span>
                  <sc-if value="{{ sx.hasChip }}"><span style="display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:500;white-space:nowrap;background:{{ sx.chip.bg }};color:{{ sx.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ sx.chip.dot }}"></span>{{ sx.chip.label }}</span></sc-if>
                </button>
              </sc-for>
            </sc-for>
            <sc-if value="{{ ad.searchEmpty }}"><div style="padding:28px 16px;text-align:center"><div style="font-weight:600;font-size:13.5px">{{ ad.searchEmptyTitle }}</div><div style="font-size:12.5px;color:var(--text-3);margin-top:2px">{{ ad.st.searchEmptyDesc }}</div></div></sc-if>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-top:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text-3)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4"></path></svg><span>{{ ad.searchScopeNote }}</span></div>
        </div>
      </sc-if>
    </div>

    <div style="flex:1"></div>

    <sc-if value="{{ ad.showDate }}" hint-placeholder-val="{{ true }}">
      <div title="{{ ad.tzTitle }}" style="display:flex;align-items:center;gap:9px;height:40px;padding:0 12px;border:1px solid var(--border);border-radius:10px;white-space:nowrap;color:var(--text-2)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 5h18v16H3zM3 10h18M8 3v4M16 3v4"></path></svg>
        <span style="display:flex;flex-direction:column;line-height:1.2"><span style="font-size:13px;font-weight:600;color:var(--text)">{{ ad.dateMain }}</span><span style="font-size:11px;color:var(--text-3)">{{ ad.dateSub }}</span></span>
      </div>
    </sc-if>

    <div style="position:relative;z-index:1">
      <button onClick="{{ ad.tog.notif }}" title="{{ ad.st.notifs }}" aria-label="{{ ad.st.notifs }}" style="width:38px;height:38px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;position:relative;border-color:{{ ad.bdNotif }}" style-hover="background:var(--hover)">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4"></path></svg>
        <sc-if value="{{ ad.hasUnread }}"><span style="position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;padding:0 5px;box-sizing:border-box;border-radius:999px;background:var(--bad-dot);color:#fff;font-size:10.5px;font-weight:700;display:grid;place-items:center;border:2px solid var(--surface)">{{ ad.unreadN }}</span></sc-if>
      </button>
      <sc-if value="{{ ad.open.notif }}">
        <div style="position:absolute;top:calc(100% + 8px);background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:2;animation:ssIn .14s ease-out;overflow:hidden;right:{{ ad.notifRight }};width:400px;max-width:calc(100vw - 24px);display:flex;flex-direction:column">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px 0">
            <span style="font-weight:600;font-size:15px">{{ ad.st.notifs }}</span>
            <button onClick="{{ ad.markAll }}" disabled="{{ ad.noUnread }}" style="border:0;background:transparent;color:{{ ad.markAllC }};font-size:12.5px;font-weight:500;cursor:pointer;padding:4px 0">{{ ad.st.markAll }}</button>
          </div>
          <div style="display:flex;gap:18px;padding:0 16px;border-bottom:1px solid var(--border);margin-top:8px">
            <sc-for list="{{ ad.notifTabs }}" as="nt" hint-placeholder-count="2">
              <button onClick="{{ nt.go }}" style="border:0;background:transparent;padding:8px 0 9px;margin-bottom:-1px;border-bottom:2px solid {{ nt.bd }};color:{{ nt.fg }};font-size:13px;font-weight:500;cursor:pointer;display:flex;gap:6px;align-items:center">{{ nt.label }}<span style="font:500 11px 'Geist Mono',monospace;padding:0 6px;border-radius:999px;background:var(--neutral-bg);color:var(--text-2)">{{ nt.count }}</span></button>
            </sc-for>
          </div>
          <div style="max-height:400px;overflow:auto">
            <sc-for list="{{ ad.notifs }}" as="n" hint-placeholder-count="4">
              <div onClick="{{ n.go }}" style="display:flex;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border);background:{{ n.bg }};cursor:pointer" style-hover="background:var(--hover)">
                <span style="width:32px;height:32px;border-radius:9px;background:{{ n.ib }};color:{{ n.if }};display:grid;place-items:center;flex:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ n.icon }}"></path></svg></span>
                <div style="flex:1;min-width:0">
                  <div style="display:flex;gap:8px;align-items:baseline"><span style="flex:1;font-size:13px;font-weight:{{ n.weight }}">{{ n.title }}</span><span style="font:400 11.5px 'Geist Mono',monospace;color:var(--text-3);white-space:nowrap">{{ n.time }}</span></div>
                  <div style="font-size:12.5px;color:var(--text-2);margin-top:1px">{{ n.desc }}</div>
                  <div style="display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text-3);margin-top:4px"><span style="padding:1px 7px;border-radius:999px;background:{{ n.ib }};color:{{ n.if }};font-weight:600">{{ n.kindLabel }}</span>{{ n.site }}</div>
                </div>
                <button onClick="{{ n.toggleRead }}" title="{{ n.readTip }}" style="width:24px;height:24px;border:0;border-radius:6px;background:transparent;display:grid;place-items:center;cursor:pointer;align-self:center;flex:none;padding:0" style-hover="background:var(--neutral-bg)"><span style="width:8px;height:8px;border-radius:50%;background:{{ n.dot }};border:1.5px solid {{ n.dotBd }};box-sizing:border-box"></span></button>
              </div>
            </sc-for>
            <sc-if value="{{ ad.notifEmpty }}">
              <div style="padding:36px 16px;text-align:center"><div style="width:40px;height:40px;margin:0 auto 10px;border-radius:50%;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg></div><div style="font-weight:600">{{ ad.st.caughtUp }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ad.st.caughtUpDesc }}</div></div>
            </sc-if>
          </div>
          <button onClick="{{ ad.viewAllNotifs }}" style="height:42px;border:0;background:var(--surface-2);color:var(--accent);font-size:13px;font-weight:600;cursor:pointer" style-hover="background:var(--hover)">{{ ad.st.viewAllNotifs }}</button>
        </div>
      </sc-if>
    </div>

    <div style="position:relative;z-index:1">
      <button onClick="{{ ad.tog.help }}" title="{{ ad.st.help }}" aria-label="{{ ad.st.help }}" style="width:38px;height:38px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;position:relative;border-color:{{ ad.bdHelp }}" style-hover="background:var(--hover)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"></path></svg></button>
      <sc-if value="{{ ad.open.help }}">
        <div style="position:absolute;top:calc(100% + 8px);background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:2;animation:ssIn .14s ease-out;overflow:hidden;right:0;width:280px;padding:6px">
          <sc-for list="{{ ad.helpItems }}" as="h" hint-placeholder-count="5">
            <button onClick="{{ h.go }}" style="display:flex;align-items:center;gap:10px;width:100%;height:38px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font-size:13.5px;cursor:pointer;text-align:left" style-hover="background:var(--hover)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3);flex:none"><path d="{{ h.icon }}"></path></svg><span style="flex:1">{{ h.label }}</span>
              <sc-if value="{{ h.hasKbd }}"><span style="font:500 11px 'Geist Mono',monospace;padding:2px 6px;border:1px solid var(--border);border-radius:5px;color:var(--text-3)">{{ h.kbd }}</span></sc-if>
              <sc-if value="{{ h.hasTag }}"><span style="font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--accent-soft);color:var(--accent)">{{ h.tag }}</span></sc-if>
            </button>
          </sc-for>
          <div style="display:flex;align-items:center;gap:8px;margin:6px -6px -6px;padding:10px 16px;border-top:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text-3)"><span style="width:7px;height:7px;border-radius:50%;background:var(--ok-dot)"></span>{{ ad.st.status }}<span style="margin-left:auto;font-family:'Geist Mono',monospace">v4.2.1</span></div>
        </div>
      </sc-if>
    </div>

    <div style="position:relative;z-index:1">
      <button onClick="{{ ad.tog.user }}" aria-label="{{ ad.st.account }}" style="display:flex;align-items:center;gap:6px;height:40px;padding:0 6px 0 4px;border:1px solid {{ ad.bdUser }};border-radius:999px;background:var(--surface);cursor:pointer;color:var(--text-3)" style-hover="background:var(--hover)">
        <span style="width:32px;height:32px;border-radius:50%;background:{{ ad.me.av.bg }};color:{{ ad.me.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600">{{ ad.me.av.ini }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M6 9l6 6 6-6"></path></svg>
      </button>
      <sc-if value="{{ ad.open.user }}">
        <div style="position:absolute;top:calc(100% + 8px);background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:2;animation:ssIn .14s ease-out;overflow:hidden;right:0;width:300px">
          <div style="display:flex;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border)">
            <span style="width:40px;height:40px;border-radius:50%;background:{{ ad.me.av.bg }};color:{{ ad.me.av.fg }};display:grid;place-items:center;font-size:14px;font-weight:600;flex:none">{{ ad.me.av.ini }}</span>
            <div style="min-width:0"><div style="font-weight:600">{{ ad.me.name }}</div><div style="font-size:12px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ ad.me.email }}</div><div style="margin-top:4px"><span style="font-size:11px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--accent-soft);color:var(--accent)">{{ ad.me.role }} · Batiplus Group</span></div></div>
          </div>
          <div style="padding:6px">
            <sc-for list="{{ ad.userTop }}" as="u" hint-placeholder-count="2">
              <button onClick="{{ u.go }}" style="display:flex;align-items:center;gap:10px;width:100%;height:38px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font-size:13.5px;cursor:pointer;text-align:left" style-hover="background:var(--hover)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3);flex:none"><path d="{{ u.icon }}"></path></svg><span style="flex:1">{{ u.label }}</span><sc-if value="{{ u.hasTag }}"><span style="font-size:11px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--ok-bg);color:var(--ok)">{{ u.tag }}</span></sc-if></button>
            </sc-for>
          </div>
          <div style="padding:10px 16px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px"><span style="display:flex;align-items:center;gap:10px;font-size:13.5px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z"></path></svg>{{ ad.st.language }}</span>
              <div style="display:flex;padding:2px;border:1px solid var(--border);border-radius:8px;gap:2px;background:var(--surface-2)"><sc-for list="{{ ad.langSeg }}" as="ls" hint-placeholder-count="2"><button onClick="{{ ls.go }}" style="border:0;height:26px;padding:0 10px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:{{ ls.bg }};color:{{ ls.fg }};box-shadow:{{ ls.sh }}">{{ ls.label }}</button></sc-for></div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px"><span style="display:flex;align-items:center;gap:10px;font-size:13.5px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3z"></path></svg>{{ ad.st.theme }}</span>
              <div style="display:flex;padding:2px;border:1px solid var(--border);border-radius:8px;gap:2px;background:var(--surface-2)"><sc-for list="{{ ad.themeSeg }}" as="ts" hint-placeholder-count="3"><button onClick="{{ ts.go }}" title="{{ ts.label }}" style="border:0;height:26px;width:32px;border-radius:6px;cursor:pointer;background:{{ ts.bg }};color:{{ ts.fg }};box-shadow:{{ ts.sh }};display:grid;place-items:center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ts.icon }}"></path></svg></button></sc-for></div>
            </div>
          </div>
          <div style="padding:6px;border-top:1px solid var(--border)">
            <button onClick="{{ ad.openWorkspaces }}" style="display:flex;align-items:center;gap:10px;width:100%;height:38px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font-size:13.5px;cursor:pointer;text-align:left" style-hover="background:var(--hover)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"></path></svg><span style="flex:1">{{ ad.st.switchWs }}</span><span style="font-size:12px;color:var(--text-3)">5</span></button>
            <button onClick="{{ ad.signOut }}" style="display:flex;align-items:center;gap:10px;width:100%;height:38px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--bad);font-size:13.5px;cursor:pointer;text-align:left" style-hover="background:var(--bad-bg)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg><span>{{ ad.st.signOut }}</span></button>
          </div>
        </div>
      </sc-if>
    </div>
  </header>

  <main style="flex:1;padding:{{ ad.mainPad }};box-sizing:border-box;max-width:1480px;width:100%">

  <sc-if value="{{ ad.isDash }}" hint-placeholder-val="{{ true }}">
  <sc-if value="{{ ad.db.isNew }}">
    <div style="display:flex;flex-direction:column;gap:20px">
      <div><h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.db.newTitle }}</h1><div style="margin-top:4px;color:var(--text-2)">{{ ad.db.st.newSub }}</div></div>
      <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
        <section style="flex:1.3 1 460px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);overflow:hidden">
          <div style="display:flex;align-items:center;gap:16px;padding:20px 22px;border-bottom:1px solid var(--border)">
            <div style="position:relative;width:56px;height:56px;flex:none">
              <svg viewBox="0 0 36 36" style="width:56px;height:56px;transform:rotate(-90deg)"><circle cx="18" cy="18" r="15.5" fill="none" style="stroke:var(--neutral-bg)" stroke-width="4"></circle><circle cx="18" cy="18" r="15.5" fill="none" style="stroke:var(--accent)" stroke-width="4" stroke-linecap="round" stroke-dasharray="{{ ad.db.setupDash }}"></circle></svg>
              <span style="position:absolute;inset:0;display:grid;place-items:center;font:600 13px 'Geist Mono',monospace">{{ ad.db.setupDone }}/{{ ad.db.setupTotal }}</span>
            </div>
            <div><div style="font-weight:600;font-size:16px">{{ ad.db.st.setupTitle }}</div><div style="font-size:13px;color:var(--text-3)">{{ ad.db.st.setupSub }}</div></div>
          </div>
          <sc-for list="{{ ad.db.setup }}" as="su" hint-placeholder-count="6">
            <div style="display:flex;align-items:center;gap:14px;padding:14px 22px;border-bottom:1px solid var(--border)">
              <button onClick="{{ su.toggle }}" style="width:24px;height:24px;border-radius:50%;border:{{ su.bd }};background:{{ su.bg }};color:#fff;display:grid;place-items:center;cursor:pointer;flex:none;padding:0"><sc-if value="{{ su.done }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M5 12l5 5L20 7"></path></svg></sc-if></button>
              <span style="width:34px;height:34px;border-radius:9px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);display:grid;place-items:center;flex:none"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ su.icon }}"></path></svg></span>
              <div style="flex:1;min-width:0"><div style="font-weight:500;text-decoration:{{ su.deco }};color:{{ su.fg }}">{{ su.title }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ su.sub }}</div></div>
              <sc-if value="{{ su.notDone }}"><button onClick="{{ su.act }}" style="height:32px;padding:0 12px;border-radius:8px;border:0;background:{{ su.ctaBg }};color:{{ su.ctaFg }};font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap">{{ su.cta }}</button></sc-if>
            </div>
          </sc-for>
        </section>
        <section style="flex:1 1 320px;min-width:0;display:flex;flex-direction:column;gap:12px">
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:18px 20px">
            <div style="font-weight:600;margin-bottom:4px">{{ ad.db.st.previewTitle }}</div>
            <div style="font-size:12.5px;color:var(--text-3);margin-bottom:14px">{{ ad.db.st.previewSub }}</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
              <sc-for list="{{ ad.db.ghostKpis }}" as="gk" hint-placeholder-count="4"><div style="padding:12px;border-radius:10px;border:1px dashed var(--border-strong);display:flex;flex-direction:column;gap:6px"><span style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-3)"><span style="width:7px;height:7px;border-radius:50%;background:{{ gk.dot }}"></span>{{ gk.label }}</span><span style="font-size:22px;font-weight:600;color:var(--text-3)">—</span></div></sc-for>
            </div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:16px 20px;display:flex;gap:12px;align-items:center">
            <span style="width:36px;height:36px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;flex:none"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M21 12a8 8 0 0 1-11.8 7L3 21l2-6A8 8 0 1 1 21 12z"></path></svg></span>
            <div style="flex:1;font-size:13px"><div style="font-weight:600">{{ ad.db.st.helpTitle }}</div><div style="color:var(--text-3);font-size:12.5px">{{ ad.db.st.helpSub }}</div></div>
            <button onClick="{{ ad.db.bookCall }}" style="height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap">{{ ad.db.st.book }}</button>
          </div>
        </section>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ ad.db.isLiveCo }}" hint-placeholder-val="{{ true }}">
  <div style="display:flex;flex-direction:column;gap:18px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap">
      <div style="min-width:0">
        <h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.db.st.title }}</h1>
        <div style="display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap">
          <span style="display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:999px;background:{{ ad.db.scopeBg }};color:{{ ad.db.scopeFg }};font-size:12.5px;font-weight:600"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.db.scopeIcon }}"></path></svg>{{ ad.db.scopeResult }}</span>
          <span style="font-size:13px;color:var(--text-3)">{{ ad.db.scopeMeta }}</span>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <button onClick="{{ ad.db.refresh }}" title="{{ ad.db.refreshTip }}" style="display:flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:9px;border:1px solid {{ ad.db.liveBd }};background:{{ ad.db.liveBg }};color:{{ ad.db.liveFg }};font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap">
          {{ ad.db.liveDot }}<span>{{ ad.db.liveLabel }}</span><span style="font-weight:400;opacity:.8">{{ ad.db.liveSub }}</span>
        </button>
        <div style="position:relative">
          <button onClick="{{ ad.db.toggleDate }}" style="display:flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:9px;border:1px solid {{ ad.db.dateBd }};background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M3 5h18v16H3zM3 10h18M8 3v4M16 3v4"></path></svg>{{ ad.db.dateLabel }}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M6 9l6 6 6-6"></path></svg></button>
          <sc-if value="{{ ad.db.dateOpen }}">
            <div onClick="{{ ad.db.closeDate }}" style="position:fixed;inset:0;z-index:29"></div>
            <div style="position:absolute;right:0;top:calc(100% + 8px);z-index:30;width:292px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);box-shadow:var(--shadow-lg);padding:14px;animation:ssIn .14s ease-out">
              <div style="display:flex;gap:6px;margin-bottom:12px"><sc-for list="{{ ad.db.quickDates }}" as="qd" hint-placeholder-count="3"><button onClick="{{ qd.go }}" style="flex:1;height:30px;border-radius:8px;border:1px solid {{ qd.bd }};background:{{ qd.bg }};color:{{ qd.fg }};font-size:12.5px;font-weight:500;cursor:pointer">{{ qd.label }}</button></sc-for></div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><span style="font-weight:600;font-size:13.5px">{{ ad.db.monthLabel }}</span><span style="font-size:11.5px;color:var(--text-3)">Europe/Paris</span></div>
              <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center;font-size:11px;color:var(--text-3);margin-bottom:4px"><sc-for list="{{ ad.db.dow }}" as="dw" hint-placeholder-count="7"><span>{{ dw }}</span></sc-for></div>
              <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px">
                <sc-for list="{{ ad.db.calCells }}" as="cc" hint-placeholder-count="35"><button onClick="{{ cc.go }}" disabled="{{ cc.disabled }}" style="height:34px;border:0;border-radius:8px;background:{{ cc.bg }};color:{{ cc.fg }};font:{{ cc.font }};cursor:{{ cc.cursor }};visibility:{{ cc.vis }};box-shadow:{{ cc.ring }}">{{ cc.n }}</button></sc-for>
              </div>
            </div>
          </sc-if>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:12px">
      <sc-for list="{{ ad.db.kpis }}" as="k" hint-placeholder-count="7">
        <button onClick="{{ k.go }}" title="{{ k.tip }}" style="text-align:left;cursor:pointer;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:14px 14px 12px;display:flex;flex-direction:column;gap:8px;color:var(--text);min-width:0;position:relative" style-hover="border-color:var(--border-strong)">
          <div style="display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--text-2);font-weight:500;white-space:nowrap;overflow:hidden"><span style="width:8px;height:8px;border-radius:50%;background:{{ k.dot }};flex:none"></span>{{ k.label }}</div>
          <div style="display:flex;align-items:baseline;gap:5px"><span style="font-size:28px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.05">{{ k.value }}</span><span style="font-size:12.5px;color:var(--text-3);white-space:nowrap">{{ k.suffix }}</span></div>
          <div style="display:flex;align-items:center;gap:4px;font-size:12px;white-space:nowrap"><span style="display:inline-flex;align-items:center;gap:2px;padding:1px 6px;border-radius:999px;background:{{ k.dBg }};color:{{ k.dFg }};font-weight:600"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ k.dIcon }}"></path></svg>{{ k.delta }}</span><span style="color:var(--text-3)">{{ ad.db.st.vsY }}</span></div>
        </button>
      </sc-for>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:stretch">
      <section style="flex:1.55 1 520px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:16px 18px 18px;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap">
          <div><div style="font-weight:600;font-size:15px">{{ ad.db.st.mapTitle }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ad.db.mapSub }}</div></div>
          <div style="display:flex;gap:12px;font-size:12px;color:var(--text-2)"><sc-for list="{{ ad.db.healthLegend }}" as="hl" hint-placeholder-count="3"><span style="display:flex;align-items:center;gap:5px"><span style="width:9px;height:9px;border-radius:50%;background:{{ hl.c }}"></span>{{ hl.label }}</span></sc-for></div>
        </div>
        <div style="position:relative;flex:1;min-height:340px;border-radius:10px;overflow:hidden;background:var(--map-bg);border:1px solid var(--border)">
          <svg viewBox="0 0 600 360" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%">
            <path d="M118 30 L300 10 L430 40 L520 120 L560 230 L520 320 L400 350 L300 340 L210 300 L140 330 L70 280 L40 190 L60 110Z" style="fill:var(--map-block)"></path>
            <path d="M330 40 C 360 120, 380 160, 372 210 S 390 300, 400 350" fill="none" style="stroke:var(--map-water)" stroke-width="6" stroke-linecap="round"></path>
            <path d="M560 230 L600 250 L600 360 L520 360 L520 320Z" style="fill:var(--map-water)"></path>
            <g fill="none" style="stroke:var(--map-road)" stroke-linecap="round" stroke-width="4"><path d="M262 64 L370 200 L398 322"></path><path d="M262 64 L150 130 L90 240"></path><path d="M370 200 L480 160"></path><path d="M300 52 L320 30"></path></g>
          </svg>
          <sc-for list="{{ ad.db.pins }}" as="pn" hint-placeholder-count="5">
            <button onClick="{{ pn.go }}" title="{{ pn.name }}" style="position:absolute;left:{{ pn.x }};top:{{ pn.y }};transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;border:0;background:transparent;padding:0;cursor:pointer;z-index:{{ pn.z }}">
              <span style="display:flex;align-items:center;gap:6px;height:28px;padding:0 10px 0 6px;border-radius:999px;background:var(--surface);border:2px solid {{ pn.c }};box-shadow:0 4px 12px rgba(13,27,46,.18);font-size:12px;font-weight:600;color:var(--text);white-space:nowrap"><span style="width:16px;height:16px;border-radius:50%;background:{{ pn.c }};color:#fff;display:grid;place-items:center"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="{{ pn.icon }}"></path></svg></span><span style="font-family:'Geist Mono',monospace">{{ pn.count }}</span><span style="font-weight:500;color:var(--text-2)">{{ pn.short }}</span></span>
              <span style="width:2px;height:8px;background:{{ pn.c }}"></span><span style="width:8px;height:8px;border-radius:50%;background:{{ pn.c }};border:2px solid var(--surface);margin-top:-2px"></span>
            </button>
          </sc-for>
          <sc-if value="{{ ad.db.hasPop }}">
            <div style="position:absolute;right:52px;top:12px;z-index:20;width:268px;max-height:calc(100% - 24px);overflow:auto;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out">
              <div style="display:flex;align-items:flex-start;gap:10px;padding:14px 14px 10px">
                <div style="flex:1;min-width:0"><div style="font-weight:600">{{ ad.db.pop.name }}</div><div style="font-size:12px;color:var(--text-3)">{{ ad.db.pop.branch }} · {{ ad.db.pop.addr }}</div></div>
                <button onClick="{{ ad.db.closePop }}" title="Close" style="width:24px;height:24px;border:0;border-radius:6px;background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer;padding:0"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
              </div>
              <div style="display:flex;align-items:center;gap:8px;padding:0 14px 12px">
                <span style="width:26px;height:26px;border-radius:50%;background:{{ ad.db.pop.mav.bg }};color:{{ ad.db.pop.mav.fg }};display:grid;place-items:center;font-size:10.5px;font-weight:600">{{ ad.db.pop.mav.ini }}</span>
                <span style="font-size:12.5px"><span style="color:var(--text-3)">{{ ad.db.st.manager }}</span> <strong style="font-weight:600">{{ ad.db.pop.manager }}</strong></span>
              </div>
              <div style="padding:0 14px 12px">
                <div style="display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:6px"><span style="color:var(--text-2)">{{ ad.db.st.presentL }}</span><span style="font:600 12.5px 'Geist Mono',monospace">{{ ad.db.pop.present }}/{{ ad.db.pop.expected }} · {{ ad.db.pop.pct }}</span></div>
                <div style="height:6px;border-radius:6px;background:var(--neutral-bg);overflow:hidden"><div style="height:100%;width:{{ ad.db.pop.pct }};background:{{ ad.db.pop.c }}"></div></div>
              </div>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border)">
                <sc-for list="{{ ad.db.pop.stats }}" as="ps" hint-placeholder-count="3"><div style="padding:9px 12px;border-right:1px solid var(--border)"><div style="font-size:11px;color:var(--text-3)">{{ ps.k }}</div><div style="font-weight:600;color:{{ ps.c }}">{{ ps.v }}</div></div></sc-for>
              </div>
              <div style="display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--border);background:var(--surface-2);border-radius:0 0 12px 12px">
                <button onClick="{{ ad.db.pop.viewAtt }}" style="height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap;flex:1">{{ ad.db.st.viewAttendance }}</button>
                <button onClick="{{ ad.db.pop.open }}" style="height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap;flex:1;border:0;background:var(--accent);color:#fff">{{ ad.db.st.openSite }}</button>
              </div>
            </div>
          </sc-if>
          <div style="position:absolute;right:12px;top:12px;display:flex;flex-direction:column;border-radius:8px;overflow:hidden;background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadow)"><span style="width:28px;height:28px;display:grid;place-items:center;color:var(--text-2);border-bottom:1px solid var(--border)">+</span><span style="width:28px;height:28px;display:grid;place-items:center;color:var(--text-2)">−</span></div>
        </div>
      </section>

      <section style="flex:1 1 360px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);display:flex;flex-direction:column;max-height:560px">
        <div style="padding:16px 18px 10px;display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;align-items:center;gap:8px"><span style="font-weight:600;font-size:15px">{{ ad.db.st.attnTitle }}</span><span style="font-size:12px;font-weight:600;padding:1px 8px;border-radius:999px;background:var(--bad-bg);color:var(--bad)">{{ ad.db.attnCount }}</span></div>
          <div style="display:flex;gap:6px;flex-wrap:wrap"><sc-for list="{{ ad.db.attnTabs }}" as="at" hint-placeholder-count="5"><button onClick="{{ at.go }}" style="display:flex;align-items:center;gap:5px;height:26px;padding:0 9px;border-radius:999px;border:1px solid {{ at.bd }};background:{{ at.bg }};color:{{ at.fg }};font-size:12px;font-weight:500;cursor:pointer;white-space:nowrap">{{ at.label }}<span style="font:500 11px 'Geist Mono',monospace;opacity:.75">{{ at.count }}</span></button></sc-for></div>
        </div>
        <div style="flex:1;overflow:auto;border-top:1px solid var(--border)">
          <sc-for list="{{ ad.db.attn }}" as="a" hint-placeholder-count="5">
            <div style="display:flex;gap:12px;padding:12px 18px;border-bottom:1px solid var(--border)">
              <span style="width:32px;height:32px;border-radius:9px;background:{{ a.ib }};color:{{ a.if }};display:grid;place-items:center;flex:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ a.icon }}"></path></svg></span>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:8px">
                <div><div style="display:flex;gap:8px;align-items:baseline"><span style="flex:1;font-weight:600;font-size:13.5px">{{ a.title }}</span><span style="font:400 11.5px 'Geist Mono',monospace;color:var(--text-3);white-space:nowrap">{{ a.time }}</span></div><div style="font-size:12.5px;color:var(--text-2)">{{ a.desc }}</div></div>
                <div style="display:flex;gap:6px;flex-wrap:wrap">
                  <sc-for list="{{ a.actions }}" as="ac" hint-placeholder-count="2"><button onClick="{{ ac.go }}" style="height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap;border:{{ ac.bd }};background:{{ ac.bg }};color:{{ ac.fg }}">{{ ac.label }}</button></sc-for>
                </div>
              </div>
            </div>
          </sc-for>
          <sc-if value="{{ ad.db.attnEmpty }}"><div style="padding:40px 18px;text-align:center"><div style="width:40px;height:40px;margin:0 auto 10px;border-radius:50%;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M5 12l5 5L20 7"></path></svg></div><div style="font-weight:600">{{ ad.db.st.attnEmpty }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ad.db.st.attnEmptyDesc }}</div></div></sc-if>
        </div>
      </section>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:stretch">
      <section style="flex:1.55 1 520px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:16px 18px 14px">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap">
          <div><div style="font-weight:600;font-size:15px">{{ ad.db.st.trendTitle }}</div><div style="display:flex;align-items:baseline;gap:8px;margin-top:4px"><span style="font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.db.trend.avg }}</span><span style="font-size:12.5px;color:var(--text-3)">{{ ad.db.trend.avgLabel }}</span><span style="font-size:12px;font-weight:600;padding:1px 7px;border-radius:999px;background:{{ ad.db.trend.dBg }};color:{{ ad.db.trend.dFg }}">{{ ad.db.trend.delta }}</span></div></div>
          <div style="display:flex;padding:3px;gap:2px;border:1px solid var(--border);border-radius:9px;background:var(--surface-2)"><sc-for list="{{ ad.db.ranges }}" as="rg" hint-placeholder-count="3"><button onClick="{{ rg.go }}" style="border:0;height:26px;padding:0 11px;border-radius:6px;font-size:12.5px;font-weight:500;cursor:pointer;background:{{ rg.bg }};color:{{ rg.fg }};box-shadow:{{ rg.sh }}">{{ rg.label }}</button></sc-for></div>
        </div>
        <div style="display:flex;gap:10px">
          <div style="display:flex;flex-direction:column;justify-content:space-between;height:190px;font:400 11px 'Geist Mono',monospace;color:var(--text-3);text-align:right;padding:0 0 2px"><sc-for list="{{ ad.db.trend.yl }}" as="yl" hint-placeholder-count="4"><span>{{ yl }}</span></sc-for></div>
          <div style="flex:1;min-width:0">
            <div style="position:relative;height:190px" onMouseLeave="{{ ad.db.trend.leave }}">
              <svg viewBox="0 0 600 190" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
                <path d="M0 0.5H600M0 63.5H600M0 126.5H600M0 189.5H600" style="stroke:var(--border)" stroke-width="1" vector-effect="non-scaling-stroke"></path>
                <path d="{{ ad.db.trend.target }}" fill="none" style="stroke:var(--ok-dot)" stroke-width="1.2" stroke-dasharray="4 4" vector-effect="non-scaling-stroke"></path>
                <path d="{{ ad.db.trend.area }}" style="fill:var(--accent-soft)"></path>
                <path d="{{ ad.db.trend.line }}" fill="none" style="stroke:var(--accent)" stroke-width="2.2" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
              </svg>
              <span style="position:absolute;right:4px;top:{{ ad.db.trend.targetTop }};transform:translateY(-120%);font-size:11px;font-weight:500;color:var(--ok)">{{ ad.db.st.target }}</span>
              <div style="position:absolute;inset:0;display:flex">
                <sc-for list="{{ ad.db.trend.cols }}" as="tc" hint-placeholder-count="7"><div onMouseEnter="{{ tc.enter }}" style="flex:1;height:100%"></div></sc-for>
              </div>
              <sc-if value="{{ ad.db.trend.hasHover }}">
                <div style="position:absolute;left:{{ ad.db.trend.hx }};top:0;bottom:0;width:1px;background:var(--border-strong);pointer-events:none"></div>
                <div style="position:absolute;left:{{ ad.db.trend.hx }};top:{{ ad.db.trend.hy }};width:10px;height:10px;margin:-5px 0 0 -5px;border-radius:50%;background:var(--accent);border:2px solid var(--surface);pointer-events:none"></div>
                <div style="position:absolute;left:{{ ad.db.trend.hx }};top:{{ ad.db.trend.hy }};transform:{{ ad.db.trend.htf }};padding:7px 10px;border-radius:8px;background:var(--text);color:var(--surface);font-size:12px;white-space:nowrap;pointer-events:none;box-shadow:var(--shadow-lg)"><div style="font-weight:600">{{ ad.db.trend.hv }}</div><div style="opacity:.75">{{ ad.db.trend.hd }}</div></div>
              </sc-if>
            </div>
            <div style="display:flex;justify-content:space-between;margin-top:8px;font:400 11px 'Geist Mono',monospace;color:var(--text-3)"><sc-for list="{{ ad.db.trend.xl }}" as="xl" hint-placeholder-count="5"><span>{{ xl }}</span></sc-for></div>
          </div>
        </div>
      </section>

      <section style="flex:1 1 300px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:16px 18px">
        <div style="font-weight:600;font-size:15px">{{ ad.db.st.methodTitle }}</div>
        <div style="font-size:12.5px;color:var(--text-3);margin-bottom:14px">{{ ad.db.methodSub }}</div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
          <div style="position:relative;width:140px;height:140px;flex:none">
            <svg viewBox="0 0 42 42" style="width:140px;height:140px;transform:rotate(-90deg)">
              <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:var(--neutral-bg)" stroke-width="6"></circle>
              <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:var(--accent)" stroke-width="6" stroke-dasharray="{{ ad.db.donut.a.da }}" stroke-dashoffset="{{ ad.db.donut.a.off }}"></circle>
              <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:var(--violet-dot)" stroke-width="6" stroke-dasharray="{{ ad.db.donut.b.da }}" stroke-dashoffset="{{ ad.db.donut.b.off }}"></circle>
              <circle cx="21" cy="21" r="15.9155" fill="none" style="stroke:var(--warn-dot)" stroke-width="6" stroke-dasharray="{{ ad.db.donut.c.da }}" stroke-dashoffset="{{ ad.db.donut.c.off }}"></circle>
            </svg>
            <div style="position:absolute;inset:0;display:grid;place-items:center;text-align:center"><div><div style="font-size:22px;font-weight:600;letter-spacing:-.02em">{{ ad.db.donut.total }}</div><div style="font-size:11px;color:var(--text-3)">{{ ad.db.st.checkins }}</div></div></div>
          </div>
          <div style="flex:1;min-width:150px;display:flex;flex-direction:column;gap:12px">
            <sc-for list="{{ ad.db.methods }}" as="me" hint-placeholder-count="3">
              <div style="display:flex;align-items:center;gap:10px">
                <span style="width:30px;height:30px;border-radius:8px;background:{{ me.bg }};color:{{ me.c }};display:grid;place-items:center;flex:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ me.icon }}"></path></svg></span>
                <div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500">{{ me.label }}</div><div style="font-size:11.5px;color:var(--text-3)">{{ me.sub }}</div></div>
                <div style="text-align:right"><div style="font:600 13px 'Geist Mono',monospace">{{ me.pct }}</div><div style="font-size:11.5px;color:var(--text-3)">{{ me.n }}</div></div>
              </div>
            </sc-for>
          </div>
        </div>
      </section>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:stretch">
      <section style="flex:1 1 400px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:16px 18px">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap">
          <div><div style="font-weight:600;font-size:15px">{{ ad.db.st.punctTitle }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ad.db.punctSub }}</div></div>
          <sc-if value="{{ ad.db.canGroup }}"><div style="display:flex;padding:3px;gap:2px;border:1px solid var(--border);border-radius:9px;background:var(--surface-2)"><sc-for list="{{ ad.db.groupBy }}" as="gb" hint-placeholder-count="2"><button onClick="{{ gb.go }}" style="border:0;height:26px;padding:0 11px;border-radius:6px;font-size:12.5px;font-weight:500;cursor:pointer;background:{{ gb.bg }};color:{{ gb.fg }};box-shadow:{{ gb.sh }}">{{ gb.label }}</button></sc-for></div></sc-if>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <sc-for list="{{ ad.db.punct }}" as="pu" hint-placeholder-count="4">
            <div style="display:grid;grid-template-columns:minmax(96px,150px) minmax(0,1fr) 52px;gap:12px;align-items:center">
              <div style="min-width:0"><div style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ pu.name }}</div><div style="font-size:11.5px;color:var(--text-3)">{{ pu.sub }}</div></div>
              <div title="{{ pu.tip }}" style="display:flex;height:12px;border-radius:6px;overflow:hidden;background:var(--neutral-bg);gap:2px"><span style="width:{{ pu.on }};background:var(--ok-dot)"></span><span style="width:{{ pu.late }};background:var(--warn-dot)"></span></div>
              <div style="text-align:right;font:600 13px 'Geist Mono',monospace;color:{{ pu.c }}">{{ pu.pct }}</div>
            </div>
          </sc-for>
        </div>
        <div style="display:flex;gap:14px;margin-top:16px;font-size:12px;color:var(--text-2)"><span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;border-radius:3px;background:var(--ok-dot)"></span>{{ ad.db.st.onTimeL }}</span><span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;border-radius:3px;background:var(--warn-dot)"></span>{{ ad.db.st.lateL }}</span></div>
      </section>

      <section style="flex:1.3 1 440px;min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);display:flex;flex-direction:column;max-height:470px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px 12px">
          <div style="display:flex;align-items:center;gap:8px"><span style="font-weight:600;font-size:15px">{{ ad.db.streamTitle }}</span><sc-if value="{{ ad.db.streamLive }}">{{ ad.db.liveDot2 }}</sc-if></div>
          <sc-if value="{{ ad.db.isToday }}"><button onClick="{{ ad.db.togglePause }}" style="height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.db.pauseIcon }}"></path></svg>{{ ad.db.pauseLabel }}</button></sc-if>
        </div>
        <div style="flex:1;overflow:auto;border-top:1px solid var(--border)">
          <sc-for list="{{ ad.db.stream }}" as="ev" hint-placeholder-count="8">
            <div style="display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:1px solid var(--border);background:{{ ev.bg }};transition:background 1.2s">
              <span style="width:32px;height:32px;border-radius:50%;background:{{ ev.av.bg }};color:{{ ev.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600;flex:none">{{ ev.av.ini }}</span>
              <div style="flex:1;min-width:0"><div style="font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><strong style="font-weight:600">{{ ev.name }}</strong> <span style="color:var(--text-2)">{{ ev.action }}</span></div><div style="font-size:12px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ ev.site }}</div></div>
              <span title="{{ ev.methodL }}" style="width:26px;height:26px;border-radius:7px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);display:grid;place-items:center;flex:none"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ev.mIcon }}"></path></svg></span>
              <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:500;white-space:nowrap;background:{{ ev.chip.bg }};color:{{ ev.chip.fg }};flex:none"><span style="width:6px;height:6px;border-radius:50%;background:{{ ev.chip.dot }}"></span>{{ ev.chip.label }}</span>
              <span style="font:500 12px 'Geist Mono',monospace;color:var(--text-3);width:40px;text-align:right;flex:none">{{ ev.time }}</span>
            </div>
          </sc-for>
        </div>
      </section>
    </div>
  </div>
  </sc-if>
</sc-if>

  <sc-if value="{{ ad.isLive }}">
  <div style="display:flex;flex-direction:column;gap:16px;padding-bottom:{{ ad.lb.padB }}">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap">
      <div>
        <h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.lb.st.title }}</h1>
        <div style="display:flex;align-items:center;gap:8px;margin-top:6px;color:var(--text-2);font-size:13.5px">{{ ad.lb.dot }}<span>{{ ad.lb.sub }}</span></div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:nowrap">
        <button onClick="{{ ad.lb.togglePause }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.lb.pauseIcon }}"></path></svg>{{ ad.lb.pauseLabel }}</button>
        <div style="display:flex;align-items:center;gap:8px;height:36px;padding:0 4px 0 10px;border:1px solid var(--border-strong);border-radius:9px;background:var(--surface)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"></path></svg>
          <select value="{{ ad.lb.siteF }}" onChange="{{ ad.lb.onSite }}" style="height:32px;border:0;outline:0;background:transparent;color:var(--text);font-size:13px;font-weight:500;cursor:pointer;padding-right:4px"><sc-for list="{{ ad.lb.siteOpts }}" as="so" hint-placeholder-count="3"><option value="{{ so.id }}">{{ so.name }}</option></sc-for></select>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px">
      <sc-for list="{{ ad.lb.counters }}" as="lc" hint-placeholder-count="6">
        <button onClick="{{ lc.go }}" style="text-align:left;cursor:pointer;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:12px 14px;display:flex;flex-direction:column;gap:4px;color:var(--text);border-color:{{ lc.bd }};box-shadow:{{ lc.sh }}" style-hover="border-color:var(--border-strong)">
          <span style="display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--text-2);font-weight:500;white-space:nowrap"><span style="width:8px;height:8px;border-radius:50%;background:{{ lc.dot }}"></span>{{ lc.label }}</span>
          <span style="font-size:26px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums">{{ lc.value }}</span>
        </button>
      </sc-for>
    </div>

    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:12px 14px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
      <div style="display:flex;align-items:center;gap:8px;height:34px;padding:0 10px;border:1px solid var(--border);border-radius:8px;flex:0 1 240px;color:var(--text-3)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg>
        <input value="{{ ad.lb.q }}" onChange="{{ ad.lb.onQ }}" placeholder="{{ ad.lb.st.searchPh }}" style="border:0;outline:0;background:transparent;font-size:13px;color:var(--text);flex:1;min-width:0">
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;flex:1">
        <sc-for list="{{ ad.lb.chips }}" as="lf" hint-placeholder-count="7">
          <button onClick="{{ lf.go }}" style="display:flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:999px;border:1px solid {{ lf.bd }};background:{{ lf.bg }};color:{{ lf.fg }};font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap"><sc-if value="{{ lf.hasDot }}"><span style="width:7px;height:7px;border-radius:50%;background:{{ lf.dot }}"></span></sc-if>{{ lf.label }}<span style="font:500 11.5px 'Geist Mono',monospace;opacity:.7">{{ lf.count }}</span></button>
        </sc-for>
      </div>
      <div style="display:flex;padding:3px;gap:2px;border:1px solid var(--border);border-radius:9px;background:var(--surface-2)">
        <sc-for list="{{ ad.lb.views }}" as="vw" hint-placeholder-count="2"><button onClick="{{ vw.go }}" title="{{ vw.label }}" style="border:0;height:28px;width:34px;border-radius:6px;cursor:pointer;background:{{ vw.bg }};color:{{ vw.fg }};box-shadow:{{ vw.sh }};display:grid;place-items:center"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ vw.icon }}"></path></svg></button></sc-for>
      </div>
    </div>

    <sc-for list="{{ ad.lb.sections }}" as="sec" hint-placeholder-count="3">
      <section style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);overflow:hidden">
        <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;flex-wrap:wrap;border-bottom:{{ sec.hdrBd }}">
          <input type="checkbox" checked="{{ sec.allSel }}" onChange="{{ sec.selAll }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;flex:none">
          <button onClick="{{ sec.toggle }}" style="display:flex;align-items:center;gap:10px;border:0;background:transparent;padding:0;cursor:pointer;color:var(--text);text-align:left;min-width:0">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3);transform:{{ sec.chev }};transition:transform .15s;flex:none"><path d="M9 6l6 6-6 6"></path></svg>
            <span><span style="display:block;font-weight:600;font-size:15px">{{ sec.name }}</span><span style="display:block;font-size:12px;color:var(--text-3)">{{ sec.branch }}</span></span>
          </button>
          <span style="display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--text-2)"><span style="width:24px;height:24px;border-radius:50%;background:{{ sec.mav.bg }};color:{{ sec.mav.fg }};display:grid;place-items:center;font-size:10px;font-weight:600">{{ sec.mav.ini }}</span>{{ sec.manager }}</span>
          <span title="{{ sec.fenceTip }}" style="display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;background:{{ sec.fenceBg }};color:{{ sec.fenceFg }};font-size:12px;font-weight:500;white-space:nowrap"><span style="width:6px;height:6px;border-radius:50%;background:{{ sec.fenceDot }}"></span>{{ sec.fence }}</span>
          <div style="flex:1"></div>
          <div style="display:flex;align-items:center;gap:10px;min-width:170px">
            <div style="flex:1;height:6px;border-radius:6px;background:var(--neutral-bg);overflow:hidden"><div style="height:100%;width:{{ sec.pct }};background:var(--ok-dot);border-radius:6px;transition:width .4s"></div></div>
            <span style="font:500 12.5px 'Geist Mono',monospace;color:var(--text-2);white-space:nowrap">{{ sec.present }}/{{ sec.expected }} {{ ad.lb.st.presentShort }}</span>
          </div>
        </div>
        <sc-if value="{{ sec.isList }}">
          <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:13.5px;min-width:1040px">
              <thead><tr style="background:var(--surface-2);color:var(--text-3);font-size:12px;text-align:left">
                <th style="width:44px;padding:8px 0 8px 16px;border-bottom:1px solid var(--border)"></th>
                <th style="padding:8px 12px 8px 0;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colEmp }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colSched }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colIn }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colOut }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colStatus }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colMethod }}</th>
                <th style="padding:8px 12px;font-weight:500;border-bottom:1px solid var(--border)">{{ ad.lb.st.colDist }}</th>
                <th style="padding:8px 16px 8px 12px;font-weight:500;border-bottom:1px solid var(--border);text-align:right">{{ ad.lb.st.colActions }}</th>
              </tr></thead>
              <tbody>
                <sc-for list="{{ sec.rows }}" as="r2" hint-placeholder-count="4">
                  <tr style="border-bottom:1px solid var(--border);background:{{ r2.bg }};transition:background 1.4s ease">
                    <td style="padding:10px 0 10px 16px"><input type="checkbox" checked="{{ r2.sel }}" onChange="{{ r2.toggleSel }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;flex:none"></td>
                    <td style="padding:10px 12px 10px 0"><div style="display:flex;align-items:center;gap:10px"><span style="width:32px;height:32px;border-radius:50%;background:{{ r2.av.bg }};color:{{ r2.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600;flex:none">{{ r2.av.ini }}</span><div style="min-width:0"><div style="font-weight:500;display:flex;align-items:center;gap:6px">{{ r2.name }}<sc-if value="{{ r2.isFresh }}"><span style="font-size:10px;font-weight:700;letter-spacing:.04em;padding:1px 6px;border-radius:999px;background:var(--accent);color:#fff">{{ ad.lb.st.newTag }}</span></sc-if></div><div style="font-size:12px;color:var(--text-3)">{{ r2.job }}</div></div></div></td>
                    <td style="padding:10px 12px;font:400 12.5px 'Geist Mono',monospace;white-space:nowrap">{{ r2.sched }}</td>
                    <td style="padding:10px 12px;font:400 12.5px 'Geist Mono',monospace;color:{{ r2.inC }};white-space:nowrap">{{ r2.inT }}</td>
                    <td style="padding:10px 12px;font:400 12.5px 'Geist Mono',monospace;color:{{ r2.outC }};white-space:nowrap">{{ r2.outT }}</td>
                    <td style="padding:10px 12px"><div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px"><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap;background:{{ r2.chip.bg }};color:{{ r2.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ r2.chip.dot }}"></span>{{ r2.chip.label }}</span><sc-if value="{{ r2.hasNote }}"><span style="font-size:11.5px;color:var(--text-3);padding-left:2px">{{ r2.note }}</span></sc-if></div></td>
                    <td style="padding:10px 12px"><div style="display:flex;align-items:center;gap:6px"><span title="{{ r2.methodL }}" style="width:26px;height:26px;border-radius:7px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);display:grid;place-items:center;flex:none;visibility:{{ r2.mVis }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ r2.mIcon }}"></path></svg></span><sc-if value="{{ r2.hasFlag }}"><span title="{{ r2.flagTip }}" style="width:26px;height:26px;border-radius:7px;background:var(--bad-bg);color:var(--bad);display:grid;place-items:center;flex:none"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM12 8v5M12 16h.01"></path></svg></span></sc-if></div></td>
                    <td style="padding:10px 12px;font:500 12.5px 'Geist Mono',monospace;color:{{ r2.distC }};white-space:nowrap">{{ r2.dist }}</td>
                    <td style="padding:10px 16px 10px 12px"><div style="display:flex;gap:6px;justify-content:flex-end"><sc-if value="{{ r2.canIn }}"><button onClick="{{ r2.doIn }}" title="{{ ad.lb.st.checkIn }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none;color:var(--accent)" style-hover="background:var(--accent-soft)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg></button></sc-if>
<sc-if value="{{ r2.canOut }}"><button onClick="{{ r2.doOut }}" title="{{ ad.lb.st.checkOut }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg></button></sc-if>
<button onClick="{{ r2.view }}" title="{{ ad.lb.st.view }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path></svg></button>
<button onClick="{{ r2.call }}" title="{{ r2.callTip }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></button></div></td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
        </sc-if>
        <sc-if value="{{ sec.isGrid }}">
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;padding:14px 16px 16px">
            <sc-for list="{{ sec.rows }}" as="r2" hint-placeholder-count="4">
              <div style="display:flex;flex-direction:column;gap:10px;padding:12px;border:1px solid {{ r2.cardBd }};border-radius:11px;background:{{ r2.bg }};transition:background 1.4s ease">
                <div style="display:flex;align-items:center;gap:10px">
                  <input type="checkbox" checked="{{ r2.sel }}" onChange="{{ r2.toggleSel }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;flex:none">
                  <span style="width:34px;height:34px;border-radius:50%;background:{{ r2.av.bg }};color:{{ r2.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600;flex:none">{{ r2.av.ini }}</span>
                  <div style="flex:1;min-width:0"><div style="font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ r2.name }}</div><div style="font-size:12px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ r2.job }}</div></div>
                  <sc-if value="{{ r2.hasFlag }}"><span title="{{ r2.flagTip }}" style="width:26px;height:26px;border-radius:7px;background:var(--bad-bg);color:var(--bad);display:grid;place-items:center;flex:none"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM12 8v5M12 16h.01"></path></svg></span></sc-if>
                </div>
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap"><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap;background:{{ r2.chip.bg }};color:{{ r2.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ r2.chip.dot }}"></span>{{ r2.chip.label }}</span><sc-if value="{{ r2.hasNote }}"><span style="font-size:11.5px;color:var(--text-3)">{{ r2.note }}</span></sc-if></div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-size:11px;color:var(--text-3)">
                  <div><div>{{ ad.lb.st.colSched }}</div><div style="font:500 12px 'Geist Mono',monospace;color:var(--text)">{{ r2.schedStart }}</div></div>
                  <div><div>{{ ad.lb.st.inShort }}</div><div style="font:500 12px 'Geist Mono',monospace;color:{{ r2.inC }}">{{ r2.inT }}</div></div>
                  <div><div>{{ ad.lb.st.outShort }}</div><div style="font:500 12px 'Geist Mono',monospace;color:{{ r2.outC }}">{{ r2.outT }}</div></div>
                </div>
                <div style="display:flex;align-items:center;gap:6px;border-top:1px solid var(--border);padding-top:10px">
                  <span title="{{ r2.methodL }}" style="width:26px;height:26px;border-radius:7px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);display:grid;place-items:center;flex:none;visibility:{{ r2.mVis }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ r2.mIcon }}"></path></svg></span><span style="font:500 12px 'Geist Mono',monospace;color:{{ r2.distC }}">{{ r2.dist }}</span>
                  <div style="flex:1"></div>
                  <sc-if value="{{ r2.canIn }}"><button onClick="{{ r2.doIn }}" title="{{ ad.lb.st.checkIn }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none;color:var(--accent)" style-hover="background:var(--accent-soft)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg></button></sc-if>
<sc-if value="{{ r2.canOut }}"><button onClick="{{ r2.doOut }}" title="{{ ad.lb.st.checkOut }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg></button></sc-if>
<button onClick="{{ r2.view }}" title="{{ ad.lb.st.view }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path></svg></button>
<button onClick="{{ r2.call }}" title="{{ r2.callTip }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);display:grid;place-items:center;cursor:pointer;padding:0;flex:none" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></button>
                </div>
              </div>
            </sc-for>
          </div>
        </sc-if>
        <sc-if value="{{ sec.isEmpty }}"><div style="padding:22px 16px;text-align:center;font-size:13px;color:var(--text-3)">{{ ad.lb.st.noMatch }}</div></sc-if>
      </section>
    </sc-for>
    <sc-if value="{{ ad.lb.allEmpty }}">
      <div style="padding:56px 20px;text-align:center;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow)"><div style="font-weight:600;font-size:15px">{{ ad.lb.st.emptyTitle }}</div><div style="color:var(--text-3);font-size:13px;margin:4px 0 14px">{{ ad.lb.st.emptyDesc }}</div><button onClick="{{ ad.lb.clear }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap">{{ ad.lb.st.clear }}</button></div>
    </sc-if>
  </div>

  <sc-if value="{{ ad.lb.hasSel }}">
    <div style="position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:35;display:flex;align-items:center;gap:10px;padding:8px 8px 8px 16px;border-radius:12px;background:var(--text);color:var(--surface);box-shadow:var(--shadow-lg);animation:ssIn .18s ease-out;white-space:nowrap">
      <span style="font-size:13.5px;font-weight:600">{{ ad.lb.selLabel }}</span>
      <span style="width:1px;height:20px;background:rgba(255,255,255,.2)"></span>
      <button onClick="{{ ad.lb.bulkRemind }}" style="height:32px;padding:0 12px;border-radius:8px;border:0;background:rgba(255,255,255,.12);color:inherit;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4"></path></svg>{{ ad.lb.st.remind }}</button>
      <sc-if value="{{ ad.lb.canAbsent }}"><button onClick="{{ ad.lb.bulkAbsent }}" style="height:32px;padding:0 12px;border-radius:8px;border:0;background:var(--bad-dot);color:#fff;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 4 1.5M17 15l5 5M22 15l-5 5"></path></svg>{{ ad.lb.st.markAbsent }}</button></sc-if>
      <button onClick="{{ ad.lb.clearSel }}" title="{{ ad.lb.st.clearSel }}" style="width:32px;height:32px;border-radius:8px;border:0;background:transparent;color:inherit;display:grid;place-items:center;cursor:pointer;opacity:.8"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
    </div>
  </sc-if>

  <sc-if value="{{ ad.lb.mOpen }}">
    <div style="position:fixed;inset:0;background:var(--overlay);z-index:45;display:grid;place-items:center;padding:20px">
      <div style="width:460px;max-width:100%;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);border-radius:14px;box-shadow:var(--shadow-lg);animation:ssIn .18s ease-out">
        <div style="display:flex;align-items:center;gap:12px;padding:18px 22px 14px">
          <span style="width:40px;height:40px;border-radius:50%;background:{{ ad.lb.m.av.bg }};color:{{ ad.lb.m.av.fg }};display:grid;place-items:center;font-size:13px;font-weight:600;flex:none">{{ ad.lb.m.av.ini }}</span>
          <div style="flex:1;min-width:0"><div style="font-weight:600;font-size:16px">{{ ad.lb.m.title }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ ad.lb.m.sub }}</div></div>
        </div>
        <div style="padding:0 22px;display:flex;flex-direction:column;gap:14px">
          <div style="display:grid;grid-template-columns:140px 1fr;gap:12px">
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.lb.st.time }}</span><input type="time" value="{{ ad.lb.m.time }}" onChange="{{ ad.lb.m.onTime }}" style="height:38px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 14px 'Geist Mono',monospace;outline:none"></label>
            <label style="display:flex;flex-direction:column;gap:6px"><span style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-size:13px;font-weight:500"><span>{{ ad.lb.st.reason }}</span><span style="color:var(--bad)">*</span></span>
              <select value="{{ ad.lb.m.reason }}" onChange="{{ ad.lb.m.onReason }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.lb.m.reasonBd }};background:var(--surface);color:var(--text);font-size:13.5px"><sc-for list="{{ ad.lb.m.reasons }}" as="rs" hint-placeholder-count="5"><option value="{{ rs.v }}">{{ rs.label }}</option></sc-for></select>
            </label>
          </div>
          <sc-if value="{{ ad.lb.m.hasErr }}"><span style="font-size:12.5px;color:var(--bad);margin-top:-6px">{{ ad.lb.st.reasonErr }}</span></sc-if>
          <label style="display:flex;flex-direction:column;gap:6px"><span style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-size:13px;font-weight:500"><span>{{ ad.lb.st.note }}</span><span style="color:var(--text-3);font-weight:400">· {{ ad.lb.st.optional }}</span></span>
            <textarea value="{{ ad.lb.m.note }}" onChange="{{ ad.lb.m.onNote }}" rows="3" placeholder="{{ ad.lb.st.notePh }}" style="padding:10px 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px;resize:vertical;outline-color:var(--accent)"></textarea>
          </label>
          <label style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--text-2);cursor:pointer"><input type="checkbox" checked="{{ ad.lb.m.verified }}" onChange="{{ ad.lb.m.onVerified }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;flex:none;margin-top:2px"><span>{{ ad.lb.st.verified }}</span></label>
          <div style="display:flex;gap:8px;padding:10px 12px;border-radius:9px;background:var(--surface-2);font-size:12.5px;color:var(--text-2)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 8h.01M12 11v5"></path></svg><span>{{ ad.lb.m.audit }}</span></div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:8px;padding:16px 22px 18px">
          <button onClick="{{ ad.lb.m.cancel }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;height:36px">{{ ad.lb.st.cancel }}</button>
          <button onClick="{{ ad.lb.m.confirm }}" style="height:36px;padding:0 14px;border-radius:9px;border:0;background:var(--accent);color:#fff;font-size:13px;font-weight:500;cursor:pointer;opacity:{{ ad.lb.m.op }}">{{ ad.lb.m.cta }}</button>
        </div>
      </div>
    </div>
  </sc-if>
</sc-if>

  <sc-if value="{{ ad.isAtt }}">
  <div style="display:flex;flex-direction:column;gap:14px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap">
      <div><h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.ar.st.title }}</h1><div style="margin-top:4px;color:var(--text-2);font-size:13.5px">{{ ad.ar.sub }}</div></div>
      <div style="display:flex;gap:8px;align-items:center">
        <div style="position:relative">
          <button onClick="{{ ad.ar.tog.export }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"></path></svg>{{ ad.ar.st.export }}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M6 9l6 6 6-6"></path></svg></button>
          <sc-if value="{{ ad.ar.open.export }}">
            <div style="position:absolute;top:calc(100% + 6px);z-index:31;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out;right:0;width:240px;padding:6px">
              <div style="padding:6px 10px 8px;font-size:12px;color:var(--text-3)">{{ ad.ar.exportNote }}</div>
              <sc-for list="{{ ad.ar.exports }}" as="ex" hint-placeholder-count="3"><button onClick="{{ ex.go }}" style="display:flex;align-items:center;gap:10px;width:100%;height:36px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font-size:13.5px;cursor:pointer;text-align:left" style-hover="background:var(--hover)"><span style="font:600 10px 'Geist Mono',monospace;padding:3px 5px;border-radius:5px;background:{{ ex.bg }};color:{{ ex.fg }};width:32px;text-align:center">{{ ex.tag }}</span>{{ ex.label }}</button></sc-for>
            </div>
          </sc-if>
        </div>
        <sc-if value="{{ ad.ar.canAdd }}"><button onClick="{{ ad.ar.openAdd }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;border:0;background:var(--accent);color:#fff;height:36px" style-hover="background:var(--accent-hover)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 5v14M5 12h14"></path></svg>{{ ad.ar.st.add }}</button></sc-if>
      </div>
    </div>

    <sc-if value="{{ ad.ar.isEmptyCo }}">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:64px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px">
        <div style="width:56px;height:56px;border-radius:14px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;margin-bottom:8px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"></path></svg></div>
        <div style="font-weight:600;font-size:17px">{{ ad.ar.st.emptyCoTitle }}</div>
        <div style="color:var(--text-3);font-size:13.5px;max-width:420px;text-wrap:pretty">{{ ad.ar.st.emptyCoDesc }}</div>
        <div style="display:flex;gap:8px;margin-top:14px"><button onClick="{{ ad.ar.goSchedules }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px">{{ ad.ar.st.createSched }}</button><button onClick="{{ ad.ar.openAdd }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;border:0;background:var(--accent);color:#fff">{{ ad.ar.st.add }}</button></div>
      </div>
    </sc-if>

    <sc-if value="{{ ad.ar.hasData }}" hint-placeholder-val="{{ true }}">
    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
      <span style="font-size:12px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-right:4px">{{ ad.ar.st.views }}</span>
      <sc-for list="{{ ad.ar.views }}" as="ve" hint-placeholder-count="3">
        <span style="display:inline-flex;align-items:center;height:30px;border-radius:999px;border:1px solid {{ ve.bd }};background:{{ ve.bg }};overflow:hidden">
          <button onClick="{{ ve.go }}" style="height:100%;padding:0 12px;border:0;background:transparent;color:{{ ve.fg }};font-size:12.5px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;white-space:nowrap"><sc-if value="{{ ve.saved }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></sc-if>{{ ve.name }}</button>
          <sc-if value="{{ ve.saved }}"><button onClick="{{ ve.del }}" title="{{ ad.ar.st.delView }}" style="height:100%;width:24px;border:0;border-left:1px solid {{ ve.bd }};background:transparent;color:var(--text-3);cursor:pointer;display:grid;place-items:center;padding:0"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button></sc-if>
        </span>
      </sc-for>
    </div>

    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow)">
      <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border)">
        <div style="position:relative">
          <button onClick="{{ ad.ar.tog.range }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid {{ ad.ar.bd.range }};background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M3 5h18v16H3zM3 10h18M8 3v4M16 3v4"></path></svg>{{ ad.ar.rangeLabel }}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M6 9l6 6 6-6"></path></svg></button>
          <sc-if value="{{ ad.ar.open.range }}">
            <div style="position:absolute;top:calc(100% + 6px);z-index:31;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out;left:0;width:280px;padding:8px">
              <sc-for list="{{ ad.ar.ranges }}" as="rp" hint-placeholder-count="5"><button onClick="{{ rp.go }}" style="display:flex;align-items:center;justify-content:space-between;width:100%;height:34px;padding:0 10px;border:0;border-radius:8px;background:{{ rp.bg }};color:{{ rp.fg }};font-size:13px;font-weight:500;cursor:pointer;text-align:left" style-hover="background:var(--hover)">{{ rp.label }}<span style="font-size:11.5px;color:var(--text-3);font-weight:400">{{ rp.hint }}</span></button></sc-for>
              <div style="border-top:1px solid var(--border);margin:6px -8px 0;padding:10px 10px 2px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
                <label style="display:flex;flex-direction:column;gap:4px;font-size:11.5px;color:var(--text-3)">{{ ad.ar.st.from }}<input type="date" min="2026-10-01" max="2026-10-15" value="{{ ad.ar.fromV }}" onChange="{{ ad.ar.onFrom }}" style="height:32px;padding:0 6px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;min-width:0"></label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:11.5px;color:var(--text-3)">{{ ad.ar.st.to }}<input type="date" min="2026-10-01" max="2026-10-15" value="{{ ad.ar.toV }}" onChange="{{ ad.ar.onTo }}" style="height:32px;padding:0 6px;border-radius:8px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px;min-width:0"></label>
              </div>
            </div>
          </sc-if>
        </div>
        <sc-if value="{{ ad.ar.multiBranch }}"><select value="{{ ad.ar.branch }}" onChange="{{ ad.ar.onBranch }}" style="height:34px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.ar.bd.branch }};background:var(--surface);color:var(--text);font-size:13px;max-width:180px"><sc-for list="{{ ad.ar.branchOpts }}" as="bo" hint-placeholder-count="3"><option value="{{ bo.id }}">{{ bo.name }}</option></sc-for></select></sc-if>
        <sc-if value="{{ ad.ar.multiSite }}"><select value="{{ ad.ar.site }}" onChange="{{ ad.ar.onSite }}" style="height:34px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.ar.bd.site }};background:var(--surface);color:var(--text);font-size:13px;max-width:180px"><sc-for list="{{ ad.ar.siteOpts }}" as="so" hint-placeholder-count="3"><option value="{{ so.id }}">{{ so.name }}</option></sc-for></select></sc-if>
        <div style="display:flex;align-items:center;gap:7px;height:34px;padding:0 10px;border:1px solid {{ ad.ar.bd.emp }};border-radius:9px;color:var(--text-3);width:190px;box-sizing:border-box"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg><input value="{{ ad.ar.emp }}" onChange="{{ ad.ar.onEmp }}" placeholder="{{ ad.ar.st.empPh }}" style="border:0;outline:0;background:transparent;font-size:13px;color:var(--text);flex:1;min-width:0"></div>
        <div style="position:relative">
          <button onClick="{{ ad.ar.tog.status }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid {{ ad.ar.bd.status }};background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px">{{ ad.ar.statusLabel }}<sc-if value="{{ ad.ar.hasStatusN }}"><span style="min-width:18px;height:18px;padding:0 5px;box-sizing:border-box;border-radius:999px;background:var(--accent);color:#fff;font-size:11px;font-weight:600;display:grid;place-items:center">{{ ad.ar.statusN }}</span></sc-if><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M6 9l6 6 6-6"></path></svg></button>
          <sc-if value="{{ ad.ar.open.status }}">
            <div style="position:absolute;top:calc(100% + 6px);z-index:31;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out;left:0;width:230px;padding:6px">
              <sc-for list="{{ ad.ar.statusOpts }}" as="sto" hint-placeholder-count="10"><label style="display:flex;align-items:center;gap:10px;height:34px;padding:0 10px;border-radius:8px;cursor:pointer;font-size:13px" style-hover="background:var(--hover)"><input type="checkbox" checked="{{ sto.on }}" onChange="{{ sto.toggle }}" style="width:15px;height:15px;margin:0;accent-color:#0B67DD"><span style="width:7px;height:7px;border-radius:50%;background:{{ sto.dot }}"></span><span style="flex:1">{{ sto.label }}</span><span style="font:500 11.5px 'Geist Mono',monospace;color:var(--text-3)">{{ sto.count }}</span></label></sc-for>
              <div style="display:flex;justify-content:space-between;border-top:1px solid var(--border);margin:6px -6px -6px;padding:8px 12px"><button onClick="{{ ad.ar.statusClear }}" style="border:0;background:transparent;color:var(--text-2);font-size:12.5px;cursor:pointer;padding:0">{{ ad.ar.st.clear }}</button><button onClick="{{ ad.ar.closeAll }}" style="border:0;background:transparent;color:var(--accent);font-size:12.5px;font-weight:600;cursor:pointer;padding:0">{{ ad.ar.st.done }}</button></div>
            </div>
          </sc-if>
        </div>
        <select value="{{ ad.ar.method }}" onChange="{{ ad.ar.onMethod }}" style="height:34px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.ar.bd.method }};background:var(--surface);color:var(--text);font-size:13px;max-width:180px"><sc-for list="{{ ad.ar.methodOpts }}" as="mo" hint-placeholder-count="5"><option value="{{ mo.id }}">{{ mo.name }}</option></sc-for></select>
        <sc-for list="{{ ad.ar.toggles }}" as="tg" hint-placeholder-count="2">
          <button onClick="{{ tg.go }}" role="switch" aria-checked="{{ tg.on }}" style="display:flex;align-items:center;gap:8px;height:34px;padding:0 10px 0 8px;border-radius:9px;border:1px solid {{ tg.bd }};background:{{ tg.bg }};color:{{ tg.fg }};font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap">
            <span style="width:28px;height:16px;border-radius:999px;background:{{ tg.track }};position:relative;flex:none;transition:background .15s"><span style="position:absolute;top:2px;left:{{ tg.knob }};width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:left .15s"></span></span>{{ tg.label }}
          </button>
        </sc-for>
        <div style="flex:1"></div>
        <sc-if value="{{ ad.ar.hasActive }}"><button onClick="{{ ad.ar.clearAll }}" style="border:0;background:transparent;color:var(--text-2);font-size:13px;font-weight:500;cursor:pointer;padding:0 6px;white-space:nowrap" style-hover="color:var(--text)">{{ ad.ar.clearLabel }}</button></sc-if>
        <div style="position:relative">
          <button onClick="{{ ad.ar.tog.save }}" disabled="{{ ad.ar.noActive }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;opacity:{{ ad.ar.saveOp }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>{{ ad.ar.st.saveView }}</button>
          <sc-if value="{{ ad.ar.open.save }}">
            <div style="position:absolute;top:calc(100% + 6px);z-index:31;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out;right:0;width:280px;padding:14px;display:flex;flex-direction:column;gap:10px">
              <div style="font-weight:600;font-size:13.5px">{{ ad.ar.st.saveTitle }}</div>
              <input value="{{ ad.ar.viewName }}" onChange="{{ ad.ar.onViewName }}" autoFocus="{{ true }}" placeholder="{{ ad.ar.st.viewPh }}" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px;outline-color:var(--accent)">
              <div style="font-size:12px;color:var(--text-3)">{{ ad.ar.saveSummary }}</div>
              <div style="display:flex;justify-content:flex-end;gap:8px"><button onClick="{{ ad.ar.closeAll }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:32px">{{ ad.ar.st.cancel }}</button><button onClick="{{ ad.ar.saveView }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:32px;border:0;background:var(--accent);color:#fff;opacity:{{ ad.ar.saveBtnOp }}">{{ ad.ar.st.save }}</button></div>
            </div>
          </sc-if>
        </div>
        <div style="position:relative">
          <button onClick="{{ ad.ar.tog.cols }}" title="{{ ad.ar.st.columns }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;padding:0 10px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M3 4h18v16H3zM9 4v16M15 4v16"></path></svg><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--text-3)"><path d="M6 9l6 6 6-6"></path></svg></button>
          <sc-if value="{{ ad.ar.open.cols }}">
            <div style="position:absolute;top:calc(100% + 6px);z-index:31;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);animation:ssIn .14s ease-out;right:0;width:220px;padding:6px">
              <div style="padding:6px 10px;font-size:12px;color:var(--text-3)">{{ ad.ar.st.showCols }}</div>
              <sc-for list="{{ ad.ar.colOpts }}" as="cv" hint-placeholder-count="11"><label style="display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border-radius:8px;cursor:{{ cv.cursor }};font-size:13px;color:{{ cv.fg }}" style-hover="background:var(--hover)"><input type="checkbox" checked="{{ cv.on }}" disabled="{{ cv.locked }}" onChange="{{ cv.toggle }}" style="width:15px;height:15px;margin:0;accent-color:#0B67DD">{{ cv.label }}</label></sc-for>
            </div>
          </sc-if>
        </div>
      </div>

      <sc-if value="{{ ad.ar.anyOpen }}"><div onClick="{{ ad.ar.closeAll }}" style="position:fixed;inset:0;z-index:30"></div></sc-if>

      <sc-if value="{{ ad.ar.hasSel }}">
        <div style="display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--accent-soft);border-bottom:1px solid var(--border);flex-wrap:wrap">
          <span style="font-size:13px;font-weight:600;color:var(--accent)">{{ ad.ar.selLabel }}</span>
          <sc-if value="{{ ad.ar.canSelAll }}"><button onClick="{{ ad.ar.selAllMatching }}" style="border:0;background:transparent;color:var(--accent);font-size:12.5px;text-decoration:underline;cursor:pointer;padding:0">{{ ad.ar.selAllLabel }}</button></sc-if>
          <div style="flex:1"></div>
          <sc-if value="{{ ad.ar.canApprove }}"><button onClick="{{ ad.ar.bulkApprove }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--ok)"><path d="M5 12l5 5L20 7"></path></svg>{{ ad.ar.st.approve }}</button></sc-if>
          <sc-if value="{{ ad.ar.canAbsent }}"><button onClick="{{ ad.ar.bulkAbsent }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--bad)"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 4 1.5M17 15l5 5M22 15l-5 5"></path></svg>{{ ad.ar.st.markAbsent }}</button></sc-if>
          <button onClick="{{ ad.ar.bulkExport }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"></path></svg>{{ ad.ar.st.exportSel }}</button>
          <button onClick="{{ ad.ar.clearSel }}" title="{{ ad.ar.st.clearSel }}" style="width:30px;height:30px;border-radius:8px;border:0;background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
        </div>
      </sc-if>

      <sc-if value="{{ ad.loading }}">
        <div style="padding:6px 0">
          <sc-for list="{{ ad.skel }}" as="sk" hint-placeholder-count="6">
            <div style="display:flex;align-items:center;gap:16px;padding:14px 16px;animation:ssShimmer 1.2s ease-in-out infinite"><div style="width:16px;height:16px;border-radius:4px;background:var(--neutral-bg)"></div><div style="width:60px;height:10px;border-radius:4px;background:var(--neutral-bg)"></div><div style="width:32px;height:32px;border-radius:50%;background:var(--neutral-bg)"></div><div style="flex:1;display:flex;flex-direction:column;gap:6px"><div style="width:30%;height:10px;border-radius:4px;background:var(--neutral-bg)"></div><div style="width:18%;height:8px;border-radius:4px;background:var(--neutral-bg)"></div></div><div style="width:12%;height:10px;border-radius:4px;background:var(--neutral-bg)"></div><div style="width:80px;height:22px;border-radius:999px;background:var(--neutral-bg)"></div></div>
          </sc-for>
        </div>
      </sc-if>

      <sc-if value="{{ ad.ar.showTable }}" hint-placeholder-val="{{ true }}">
        <div style="overflow-x:auto">
          <table style="width:100%;border-collapse:collapse;font-size:13.5px;min-width:{{ ad.ar.minW }}">
            <thead><tr style="background:var(--surface-2);color:var(--text-3);text-align:left">
              <th style="width:40px;padding:0 0 0 16px;border-bottom:1px solid var(--border)"><input type="checkbox" checked="{{ ad.ar.pageAllSel }}" onChange="{{ ad.ar.togglePage }}" aria-label="Select page" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;vertical-align:middle"></th>
              <sc-if value="{{ ad.ar.col.date }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.date.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.date.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cDate }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.date.op }}"><path d="{{ ad.ar.sh.date.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.emp }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.emp.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.emp.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cEmp }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.emp.op }}"><path d="{{ ad.ar.sh.emp.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.site }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.site.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.site.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cSite }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.site.op }}"><path d="{{ ad.ar.sh.site.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.sched }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;font-size:12px">{{ ad.ar.st.cSched }}</th></sc-if><sc-if value="{{ ad.ar.col.in }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.in.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.in.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cIn }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.in.op }}"><path d="{{ ad.ar.sh.in.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.out }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.out.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.out.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cOut }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.out.op }}"><path d="{{ ad.ar.sh.out.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.worked }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;text-align:right"><button onClick="{{ ad.ar.sh.worked.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.worked.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cWorked }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.worked.op }}"><path d="{{ ad.ar.sh.worked.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.status }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.status.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.status.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cStatus }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.status.op }}"><path d="{{ ad.ar.sh.status.icon }}"></path></svg></button></th></sc-if><sc-if value="{{ ad.ar.col.method }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;font-size:12px">{{ ad.ar.st.cMethod }}</th></sc-if><sc-if value="{{ ad.ar.col.flag }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;font-size:12px">{{ ad.ar.st.cFlag }}</th></sc-if><sc-if value="{{ ad.ar.col.edited }}"><th style="padding:0 12px;height:38px;font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;"><button onClick="{{ ad.ar.sh.edited.go }}" style="display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;padding:0;color:{{ ad.ar.sh.edited.c }};font-size:12px;font-weight:500;cursor:pointer">{{ ad.ar.st.cEdited }}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="opacity:{{ ad.ar.sh.edited.op }}"><path d="{{ ad.ar.sh.edited.icon }}"></path></svg></button></th></sc-if>
            </tr></thead>
            <tbody>
              <sc-for list="{{ ad.ar.rows }}" as="rw" hint-placeholder-count="10">
                <tr onClick="{{ rw.open }}" style="border-bottom:1px solid var(--border);cursor:pointer;background:{{ rw.bg }}" style-hover="background:var(--hover)">
                  <td style="padding:9px 0 9px 16px" onClick="{{ rw.stop }}"><input type="checkbox" checked="{{ rw.sel }}" onChange="{{ rw.toggle }}" style="width:16px;height:16px;margin:0;accent-color:#0B67DD;cursor:pointer;vertical-align:middle"></td>
                  <sc-if value="{{ ad.ar.col.date }}"><td style="padding:9px 12px;"><div style="font-weight:500;white-space:nowrap">{{ rw.dateL }}</div><div style="font-size:11.5px;color:var(--text-3)">{{ rw.dow }}</div></td></sc-if>
                  <sc-if value="{{ ad.ar.col.emp }}"><td style="padding:9px 12px;"><div style="display:flex;align-items:center;gap:10px"><span style="width:32px;height:32px;border-radius:50%;background:{{ rw.av.bg }};color:{{ rw.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600;flex:none">{{ rw.av.ini }}</span><div style="min-width:0"><div style="font-weight:500;white-space:nowrap">{{ rw.name }}</div><div style="font:400 11.5px 'Geist Mono',monospace;color:var(--text-3)">{{ rw.empId }}</div></div></div></td></sc-if>
                  <sc-if value="{{ ad.ar.col.site }}"><td style="padding:9px 12px;color:var(--text-2)"><div style="white-space:nowrap">{{ rw.site }}</div><div style="font-size:11.5px;color:var(--text-3)">{{ rw.branch }}</div></td></sc-if>
                  <sc-if value="{{ ad.ar.col.sched }}"><td style="padding:9px 12px;"><div style="font:400 12.5px 'Geist Mono',monospace;white-space:nowrap">{{ rw.sched }}</div><div style="font-size:11.5px;color:var(--text-3);white-space:nowrap">{{ rw.shift }}</div></td></sc-if>
                  <sc-if value="{{ ad.ar.col.in }}"><td style="padding:9px 12px;font:400 12.5px 'Geist Mono',monospace;color:{{ rw.inC }};white-space:nowrap">{{ rw.inT }}</td></sc-if>
                  <sc-if value="{{ ad.ar.col.out }}"><td style="padding:9px 12px;font:400 12.5px 'Geist Mono',monospace;color:{{ rw.outC }};white-space:nowrap">{{ rw.outT }}</td></sc-if>
                  <sc-if value="{{ ad.ar.col.worked }}"><td style="padding:9px 12px;font:400 12.5px 'Geist Mono',monospace;color:var(--text-2);text-align:right;white-space:nowrap">{{ rw.worked }}</td></sc-if>
                  <sc-if value="{{ ad.ar.col.status }}"><td style="padding:9px 12px;"><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap;background:{{ rw.chip.bg }};color:{{ rw.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ rw.chip.dot }}"></span>{{ rw.chip.label }}</span></td></sc-if>
                  <sc-if value="{{ ad.ar.col.method }}"><td style="padding:9px 12px;"><div style="display:flex;align-items:center;gap:5px"><span title="{{ rw.methodL }}" style="width:26px;height:26px;border-radius:7px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);display:grid;place-items:center;visibility:{{ rw.mVis }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ rw.mIcon }}"></path></svg></span><sc-if value="{{ rw.offline }}"><span title="{{ rw.offlineTip }}" style="width:26px;height:26px;border-radius:7px;background:var(--info-bg);color:var(--info);display:grid;place-items:center"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M2 2l20 20M17.5 17.5H7a5 5 0 0 1-1.7-9.7M10 5.2A6 6 0 0 1 18 10h1a4 4 0 0 1 2.4 7.2"></path></svg></span></sc-if></div></td></sc-if>
                  <sc-if value="{{ ad.ar.col.flag }}"><td style="padding:9px 12px;"><sc-if value="{{ rw.hasFlag }}"><span title="{{ rw.flagTip }}" style="display:inline-grid;place-items:center;width:26px;height:26px;border-radius:7px;background:{{ rw.flagBg }};color:{{ rw.flagFg }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM12 8v5M12 16h.01"></path></svg></span></sc-if><sc-if value="{{ rw.noFlag }}"><span style="color:var(--text-3)">—</span></sc-if></td></sc-if>
                  <sc-if value="{{ ad.ar.col.edited }}"><td style="padding:9px 12px;padding-right:16px"><sc-if value="{{ rw.hasEdit }}"><div style="display:flex;align-items:center;gap:8px"><span style="width:22px;height:22px;border-radius:50%;background:{{ rw.eav.bg }};color:{{ rw.eav.fg }};display:grid;place-items:center;font-size:9.5px;font-weight:600;flex:none">{{ rw.eav.ini }}</span><div style="min-width:0"><div style="font-size:12.5px;white-space:nowrap">{{ rw.editBy }}</div><div style="font-size:11.5px;color:var(--text-3);white-space:nowrap">{{ rw.editAt }}</div></div></div></sc-if><sc-if value="{{ rw.noEdit }}"><span style="color:var(--text-3)">—</span></sc-if></td></sc-if>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;font-size:12.5px;color:var(--text-2)">
          <div style="display:flex;align-items:center;gap:8px"><span>{{ ad.ar.st.rowsPer }}</span><select value="{{ ad.ar.per }}" onChange="{{ ad.ar.onPer }}" style="height:28px;padding:0 6px;border-radius:7px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:12.5px"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select><span style="color:var(--text-3)">{{ ad.ar.rangeTxt }}</span></div>
          <div style="display:flex;align-items:center;gap:4px">
            <button onClick="{{ ad.ar.prev }}" disabled="{{ ad.ar.atFirst }}" style="height:30px;padding:0 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;opacity:{{ ad.ar.prevOp }}">←</button>
            <sc-for list="{{ ad.ar.pages }}" as="pg" hint-placeholder-count="5"><button onClick="{{ pg.go }}" disabled="{{ pg.gap }}" style="min-width:30px;height:30px;padding:0 6px;border-radius:7px;border:1px solid {{ pg.bd }};background:{{ pg.bg }};color:{{ pg.fg }};font:500 12.5px 'Geist Mono',monospace;cursor:pointer">{{ pg.label }}</button></sc-for>
            <button onClick="{{ ad.ar.next }}" disabled="{{ ad.ar.atLast }}" style="height:30px;padding:0 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;opacity:{{ ad.ar.nextOp }}">→</button>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ ad.ar.noResults }}">
        <div style="padding:60px 20px;text-align:center">
          <div style="width:48px;height:48px;margin:0 auto 14px;border-radius:12px;background:var(--neutral-bg);color:var(--text-3);display:grid;place-items:center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3M8 11h6"></path></svg></div>
          <div style="font-weight:600;font-size:15px">{{ ad.ar.st.noResTitle }}</div>
          <div style="color:var(--text-3);font-size:13px;margin:4px 0 16px">{{ ad.ar.noResDesc }}</div>
          <button onClick="{{ ad.ar.clearAll }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;display:inline-flex">{{ ad.ar.st.clearAll }}</button>
        </div>
      </sc-if>
    </div>
    </sc-if>
  </div>

  <sc-if value="{{ ad.ar.addOpen }}">
    <div style="position:fixed;inset:0;background:var(--overlay);z-index:45;display:grid;place-items:center;padding:20px">
      <div role="dialog" aria-label="Add manual record" style="width:580px;max-width:100%;max-height:92vh;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-lg);animation:ssIn .18s ease-out">
        <div style="display:flex;align-items:flex-start;gap:12px;padding:18px 22px 14px;border-bottom:1px solid var(--border)">
          <div style="flex:1"><div style="font-weight:600;font-size:16px">{{ ad.ar.st.addTitle }}</div><div style="font-size:12.5px;color:var(--text-3);margin-top:2px">{{ ad.ar.st.addSub }}</div></div>
          <button onClick="{{ ad.ar.add.cancel }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
        </div>
        <div style="flex:1;overflow:auto;padding:16px 22px;display:flex;flex-direction:column;gap:14px">
          <sc-if value="{{ ad.ar.add.showSummary }}"><div style="display:flex;gap:8px;align-items:center;padding:9px 12px;border-radius:9px;background:var(--bad-bg);color:var(--bad);font-size:12.5px;font-weight:500"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 3l10 18H2zM12 10v4M12 17h.01"></path></svg>{{ ad.ar.add.summary }}</div></sc-if>
          <div style="display:flex;flex-direction:column;gap:6px;position:relative"><span style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-size:13px;font-weight:500"><span>{{ ad.ar.st.cEmp }}</span><span style="color:var(--bad)">*</span></span>
            <sc-if value="{{ ad.ar.add.hasEmp }}">
              <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;border:1px solid var(--border-strong);background:var(--surface-2)">
                <span style="width:32px;height:32px;border-radius:50%;background:{{ ad.ar.add.sel.av.bg }};color:{{ ad.ar.add.sel.av.fg }};display:grid;place-items:center;font-size:12px;font-weight:600;flex:none">{{ ad.ar.add.sel.av.ini }}</span>
                <div style="flex:1;min-width:0"><div style="font-weight:500;font-size:13.5px">{{ ad.ar.add.sel.name }}</div><div style="font-size:12px;color:var(--text-3)">{{ ad.ar.add.sel.empId }} · {{ ad.ar.add.sel.job }} · {{ ad.ar.add.sel.sched }}</div></div>
                <button onClick="{{ ad.ar.add.clearEmp }}" style="border:0;background:transparent;color:var(--accent);font-size:12.5px;font-weight:500;cursor:pointer">{{ ad.ar.add.L.change }}</button>
              </div>
            </sc-if>
            <sc-if value="{{ ad.ar.add.noEmp }}">
              <div style="display:flex;align-items:center;gap:8px;height:38px;padding:0 12px;border-radius:9px;border:1px solid {{ ad.ar.add.empBd }};background:var(--surface);color:var(--text-3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3"></path></svg><input value="{{ ad.ar.add.q }}" onChange="{{ ad.ar.add.onQ }}" onFocus="{{ ad.ar.add.openSearch }}" placeholder="{{ ad.ar.add.L.searchPh }}" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:13.5px"></div>
              <sc-if value="{{ ad.ar.add.searchOpen }}">
                <div style="position:absolute;top:66px;left:0;right:0;z-index:5;max-height:240px;overflow:auto;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-lg);padding:4px">
                  <sc-for list="{{ ad.ar.add.results }}" as="er" hint-placeholder-count="5"><button onClick="{{ er.pick }}" style="display:flex;align-items:center;gap:10px;width:100%;padding:7px 8px;border:0;border-radius:8px;background:transparent;color:var(--text);cursor:pointer;text-align:left" style-hover="background:var(--hover)"><span style="width:28px;height:28px;border-radius:50%;background:{{ er.av.bg }};color:{{ er.av.fg }};display:grid;place-items:center;font-size:11px;font-weight:600;flex:none">{{ er.av.ini }}</span><span style="flex:1;min-width:0"><span style="display:block;font-size:13px;font-weight:500">{{ er.name }}</span><span style="display:block;font-size:11.5px;color:var(--text-3)">{{ er.empId }} · {{ er.site }}</span></span></button></sc-for>
                  <sc-if value="{{ ad.ar.add.noResults }}"><div style="padding:14px;text-align:center;font-size:12.5px;color:var(--text-3)">{{ ad.ar.add.L.noEmp }}</div></sc-if>
                </div>
              </sc-if>
            </sc-if>
            <sc-if value="{{ ad.ar.add.empErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ ad.ar.st.errEmp }}</span></sc-if>
          </div>
          <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:10px">
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.ar.st.cSite }}</span><select value="{{ ad.ar.add.site }}" onChange="{{ ad.ar.add.onSite }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px"><sc-for list="{{ ad.ar.add.siteOpts }}" as="so2" hint-placeholder-count="3"><option value="{{ so2.id }}">{{ so2.name }}</option></sc-for></select></label>
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.ar.st.cDate }}</span><input type="date" min="2026-10-01" max="2026-10-15" value="{{ ad.ar.add.date }}" onChange="{{ ad.ar.add.onDate }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;min-width:0"></label>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:10px">
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.ar.st.cIn }}</span><input type="time" value="{{ ad.ar.add.in }}" onChange="{{ ad.ar.add.onIn }}" disabled="{{ ad.ar.add.noTimes }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.ar.add.inBd }};background:{{ ad.ar.add.timeBg }};color:var(--text);font:500 13px 'Geist Mono',monospace;min-width:0"></label>
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.ar.st.cOut }}</span><input type="time" value="{{ ad.ar.add.out }}" onChange="{{ ad.ar.add.onOut }}" disabled="{{ ad.ar.add.noTimes }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid {{ ad.ar.add.outBd }};background:{{ ad.ar.add.timeBg }};color:var(--text);font:500 13px 'Geist Mono',monospace;min-width:0"></label>
            <label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:13px;font-weight:500">{{ ad.ar.st.cStatus }}</span><select value="{{ ad.ar.add.status }}" onChange="{{ ad.ar.add.onStatus }}" style="height:38px;padding:0 8px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13.5px"><sc-for list="{{ ad.ar.add.statusOpts }}" as="sx" hint-placeholder-count="6"><option value="{{ sx.id }}">{{ sx.name }}</option></sc-for></select></label>
          </div>
          <div style="font-size:12px;color:var(--text-3);margin-top:-6px">{{ ad.ar.add.hint }}</div>
          <sc-if value="{{ ad.ar.add.timeErr }}"><span style="font-size:12.5px;color:var(--bad);margin-top:-8px">{{ ad.ar.st.errTime }}</span></sc-if>
          <sc-if value="{{ ad.ar.add.hasOverlap }}">
            <div style="display:flex;gap:10px;padding:11px 13px;border-radius:10px;background:var(--bad-bg);color:var(--bad)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3M9 12h6"></path></svg>
              <div style="flex:1"><div style="font-weight:600;font-size:13px">{{ ad.ar.add.L.overlapTitle }}</div><div style="font-size:12.5px">{{ ad.ar.add.overlapDesc }}</div><a href="#" onClick="{{ ad.ar.add.openOverlap }}" style="font-size:12.5px;font-weight:500;color:inherit;text-decoration:underline">{{ ad.ar.add.L.openRec }}</a></div>
            </div>
          </sc-if>
          <label style="display:flex;flex-direction:column;gap:6px"><span style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-size:13px;font-weight:500"><span>{{ ad.ar.st.reason }}</span><span style="color:var(--bad)">*</span></span><textarea value="{{ ad.ar.add.reason }}" onChange="{{ ad.ar.add.onReason }}" rows="2" placeholder="{{ ad.ar.st.reasonPh }}" style="padding:10px 12px;border-radius:9px;border:1px solid {{ ad.ar.add.reasonBd }};background:var(--surface);color:var(--text);font:400 13.5px 'Geist',sans-serif;resize:vertical;outline-color:var(--accent)"></textarea><sc-if value="{{ ad.ar.add.reasonErr }}"><span style="font-size:12.5px;color:var(--bad)">{{ ad.ar.st.errReason }}</span></sc-if></label>
          <div style="display:flex;flex-direction:column;gap:8px"><span style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-size:13px;font-weight:500"><span>{{ ad.ar.add.L.evidence }}</span><span style="color:var(--text-3);font-weight:400">· {{ ad.ar.add.L.optional }}</span></span>
            <label style="display:flex;align-items:center;gap:12px;padding:12px 14px;border:1.5px dashed var(--border-strong);border-radius:10px;background:var(--surface-2);cursor:pointer" style-hover="border-color:var(--accent)">
              <input type="file" multiple="{{ true }}" accept="image/*,.pdf" onChange="{{ ad.ar.add.onFiles }}" style="display:none">
              <span style="width:34px;height:34px;border-radius:9px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;flex:none"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M21 12l-8.5 8.5a5 5 0 0 1-7-7L14 5a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 8"></path></svg></span>
              <span><span style="display:block;font-size:13px;font-weight:500">{{ ad.ar.add.L.attach }}</span><span style="display:block;font-size:12px;color:var(--text-3)">{{ ad.ar.add.L.attachHint }}</span></span>
            </label>
            <sc-for list="{{ ad.ar.add.files }}" as="fl"><div style="display:flex;align-items:center;gap:10px;padding:7px 10px;border:1px solid var(--border);border-radius:9px;font-size:13px"><span style="font:600 10px 'Geist Mono',monospace;padding:3px 5px;border-radius:5px;background:var(--neutral-bg);color:var(--text-2)">{{ fl.ext }}</span><span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ fl.name }}</span><span style="font-size:12px;color:var(--text-3)">{{ fl.size }}</span><button onClick="{{ fl.remove }}" style="width:24px;height:24px;border:0;border-radius:6px;background:transparent;color:var(--text-3);display:grid;place-items:center;cursor:pointer"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button></div></sc-for>
          </div>
          <div style="display:flex;gap:8px;padding:10px 12px;border-radius:9px;background:var(--surface-2);font-size:12.5px;color:var(--text-2)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 8h.01M12 11v5"></path></svg><span>{{ ad.ar.add.audit }}</span></div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 22px 16px;border-top:1px solid var(--border)">
          <button onClick="{{ ad.ar.add.cancel }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:36px">{{ ad.ar.st.cancel }}</button>
          <button onClick="{{ ad.ar.add.save }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:36px;border:0;background:var(--accent);color:#fff;opacity:{{ ad.ar.add.saveOp }}">{{ ad.ar.st.addSave }}</button>
        </div>
      </div>
    </div>
  </sc-if>
</sc-if>

  <sc-if value="{{ ad.isLeave }}">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div><h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-.02em">{{ ad.t.leave }}</h1><div style="margin-top:4px;color:var(--text-2);font-size:13.5px">{{ ad.t.leaveSub }}</div></div>
      <sc-if value="{{ ad.readOnlyLeave }}">
        <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;background:var(--info-bg);color:var(--info);font-size:13px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4"></path></svg>{{ ad.t.readOnly }}</div>
      </sc-if>
      <div style="display:flex;gap:20px;border-bottom:1px solid var(--border)">
        <sc-for list="{{ ad.leaveTabs }}" as="lt" hint-placeholder-count="4">
          <button onClick="{{ lt.go }}" style="border:0;background:transparent;padding:0 0 10px;margin-bottom:-1px;border-bottom:2px solid {{ lt.bd }};color:{{ lt.fg }};font:500 13.5px 'Geist',sans-serif;cursor:pointer;display:flex;gap:6px;align-items:center">{{ lt.label }}<span style="font:500 11.5px 'Geist Mono',monospace;padding:1px 6px;border-radius:999px;background:var(--neutral-bg);color:var(--text-2)">{{ lt.count }}</span></button>
        </sc-for>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <sc-for list="{{ ad.leaveRows }}" as="l" hint-placeholder-count="4">
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px;padding:14px 18px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow)">
            <div style="display:flex;align-items:center;gap:12px;flex:1 1 220px;min-width:0">
              <div style="width:36px;height:36px;border-radius:50%;background:{{ l.av.bg }};color:{{ l.av.fg }};display:grid;place-items:center;font-size:12.5px;font-weight:600;flex:none">{{ l.av.ini }}</div>
              <div style="min-width:0"><div style="font-weight:600">{{ l.name }}</div><div style="font-size:12.5px;color:var(--text-3)">{{ l.siteName }} · {{ l.submitted }}</div></div>
            </div>
            <div style="flex:0 0 140px"><div style="font-size:12px;color:var(--text-3)">{{ ad.t.colType }}</div><div style="font-weight:500">{{ l.type }}</div></div>
            <div style="flex:1 1 180px"><div style="font-size:12px;color:var(--text-3)">{{ ad.t.colDates }}</div><div style="display:flex;flex-wrap:wrap;gap:0 4px;align-items:baseline;font-weight:500"><span>{{ l.dates }}</span><span style="color:var(--text-3);font-weight:400">· {{ l.daysL }}</span></div></div>
            <div style="flex:1 1 200px;display:flex;flex-direction:column;gap:4px">
              <sc-if value="{{ l.hasNote }}"><div style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:{{ l.noteC }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="{{ l.noteIcon }}"></path></svg>{{ l.note }}</div></sc-if>
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-left:auto">
              <sc-if value="{{ l.showActions }}">
                <button onClick="{{ l.reject }}" style="height:34px;padding:0 14px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 13px 'Geist',sans-serif;cursor:pointer" style-hover="background:var(--hover)">{{ ad.t.reject }}</button>
                <button onClick="{{ l.approve }}" style="height:34px;padding:0 14px;border-radius:9px;border:0;background:var(--accent);color:#fff;font:500 13px 'Geist',sans-serif;cursor:pointer" style-hover="background:var(--accent-hover)">{{ ad.t.approve }}</button>
              </sc-if>
              <sc-if value="{{ l.showChip }}"><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:500;background:{{ l.chip.bg }};color:{{ l.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ l.chip.dot }}"></span>{{ l.chip.label }}</span></sc-if>
            </div>
          </div>
        </sc-for>
        <sc-if value="{{ ad.leaveEmpty }}">
          <div style="padding:56px 20px;text-align:center;background:var(--surface);border:1px dashed var(--border-strong);border-radius:12px">
            <div style="font-weight:600;font-size:15px">{{ ad.t.emptyLeave }}</div><div style="color:var(--text-3);font-size:13px;margin-top:4px">{{ ad.t.emptyLeaveDesc }}</div>
          </div>
        </sc-if>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ ad.isOther }}">
    <div style="min-height:60vh;display:grid;place-items:center;text-align:center">
      <div style="max-width:360px">
        <div style="width:52px;height:52px;margin:0 auto 14px;border-radius:14px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.otherIcon }}"></path></svg></div>
        <div style="font-weight:600;font-size:17px">{{ ad.otherTitle }}</div>
        <div style="color:var(--text-3);font-size:13.5px;margin:6px 0 18px">{{ ad.t.notBuiltDesc }}</div>
        <button onClick="{{ ad.goDash }}" style="height:34px;padding:0 14px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 13px 'Geist',sans-serif;cursor:pointer">{{ ad.t.backDash }}</button>
      </div>
    </div>
  </sc-if>
  </main>
</div>

<sc-if value="{{ ad.drawerOpen }}">
  <div onClick="{{ ad.closeDrawer }}" style="position:fixed;inset:0;background:var(--overlay);z-index:20"></div>
  <aside role="dialog" aria-label="Attendance record" style="position:fixed;top:0;right:0;bottom:0;width:560px;max-width:100vw;background:var(--surface);border-left:1px solid var(--border);box-shadow:var(--shadow-lg);z-index:21;display:flex;flex-direction:column;animation:ssDrawer .22s ease-out">
    <div style="padding:14px 20px 16px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:12px">
      <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-3)">
        <span style="font:500 12px 'Geist Mono',monospace;padding:2px 7px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border)">{{ ad.d.recId }}</span><span>{{ ad.d.dateL }}</span>
        <div style="flex:1"></div>
        <button onClick="{{ ad.closeDrawer }}" title="{{ ad.t.close }}" style="width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text-2);display:grid;place-items:center;cursor:pointer" style-hover="background:var(--hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
      </div>
      <div style="display:flex;align-items:center;gap:14px">
        <div style="width:52px;height:52px;border-radius:50%;background:{{ ad.d.av.bg }};color:{{ ad.d.av.fg }};display:grid;place-items:center;font-size:17px;font-weight:600;flex:none">{{ ad.d.av.ini }}</div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:17px;letter-spacing:-.01em">{{ ad.d.name }}</div>
          <div style="font-size:13px;color:var(--text-2)">{{ ad.d.job }} · {{ ad.d.siteName }}</div>
          <div style="font:400 11.5px 'Geist Mono',monospace;color:var(--text-3)">{{ ad.d.empId }} · {{ ad.d.branch }}</div>
        </div>
        <button onClick="{{ ad.d.profile }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:32px">{{ ad.d.L.profile }}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M7 17L17 7M9 7h8v8"></path></svg></button>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
        <span style="display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font-size:12.5px;font-weight:500;background:{{ ad.d.chip.bg }};color:{{ ad.d.chip.fg }}"><span style="width:6px;height:6px;border-radius:50%;background:{{ ad.d.chip.dot }}"></span>{{ ad.d.chip.label }}</span>
        <span style="display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font-size:12.5px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ad.d.mIcon }}"></path></svg>{{ ad.d.methodShort }}</span>
        <sc-if value="{{ ad.d.isOffline }}"><span style="display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font-size:12.5px;font-weight:500;background:var(--info-bg);color:var(--info)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M2 2l20 20M17.5 17.5H7a5 5 0 0 1-1.7-9.7M10 5.2A6 6 0 0 1 18 10h1a4 4 0 0 1 2.4 7.2"></path></svg>{{ ad.d.offlineL }}</span></sc-if>
        <sc-if value="{{ ad.d.isApproved }}"><span style="display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font-size:12.5px;font-weight:500;background:var(--ok-bg);color:var(--ok)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M5 12l5 5L20 7"></path></svg>{{ ad.d.approvedL }}</span></sc-if>
      </div>
    </div>

    <div style="flex:1;overflow:auto;padding:18px 20px 24px;display:flex;flex-direction:column;gap:22px">
      <sc-if value="{{ ad.d.hasFlag }}">
        <div style="display:flex;flex-direction:column;gap:10px;padding:12px 14px;border-radius:10px;background:var(--bad-bg);color:var(--bad)">
          <div style="display:flex;gap:10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM12 8v5M12 16h.01"></path></svg><div><div style="font-weight:600;font-size:13.5px">{{ ad.d.flagTitle }}</div><div style="font-size:12.5px">{{ ad.d.flagDesc }}</div></div></div>
          <sc-if value="{{ ad.d.canReview }}"><div style="display:flex;gap:8px;padding-left:28px">
            <button onClick="{{ ad.d.approveFlag }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px;border-color:transparent"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--ok)"><path d="M5 12l5 5L20 7"></path></svg>{{ ad.d.L.approveFlag }}</button>
            <button onClick="{{ ad.d.rejectFlag }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px;border:0;background:var(--bad-dot);color:#fff">{{ ad.d.L.rejectFlag }}</button>
          </div></sc-if>
          <sc-if value="{{ ad.d.noPermNote }}"><div style="font-size:12px;padding-left:28px">{{ ad.t.noPermFlag }}</div></sc-if>
        </div>
      </sc-if>

      <div>
        <div style="display:flex;justify-content:space-between;align-items:baseline"><div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.d.L.times }}</div><sc-if value="{{ ad.d.canEdit }}"><button onClick="{{ ad.d.openTimes }}" style="border:0;background:transparent;color:var(--accent);font-size:12.5px;font-weight:500;cursor:pointer;padding:0">{{ ad.d.L.editTimes }}</button></sc-if></div>
        <div style="border:1px solid var(--border);border-radius:10px;overflow:hidden">
          <div style="display:grid;grid-template-columns:1.1fr 1fr 1fr 1.2fr;gap:8px;padding:8px 14px;background:var(--surface-2);font-size:11.5px;color:var(--text-3);font-weight:500"><span></span><span>{{ ad.d.L.scheduled }}</span><span>{{ ad.d.L.actual }}</span><span style="text-align:right">{{ ad.d.L.diff }}</span></div>
          <sc-for list="{{ ad.d.times }}" as="tm" hint-placeholder-count="3">
            <div style="display:grid;grid-template-columns:1.1fr 1fr 1fr 1.2fr;gap:8px;padding:10px 14px;border-top:1px solid var(--border);align-items:center">
              <span style="font-size:13px;color:var(--text-2)">{{ tm.k }}</span>
              <span style="font:400 13px 'Geist Mono',monospace;color:var(--text-3)">{{ tm.sched }}</span>
              <span style="font:600 13px 'Geist Mono',monospace;color:{{ tm.actC }}">{{ tm.act }}</span>
              <span style="text-align:right"><span style="display:inline-block;font-size:12px;font-weight:500;padding:2px 8px;border-radius:999px;background:{{ tm.diffBg }};color:{{ tm.diffC }};white-space:nowrap">{{ tm.diff }}</span></span>
            </div>
          </sc-for>
        </div>
      </div>

      <sc-if value="{{ ad.d.editing }}">
        <div style="border:1px solid var(--accent);box-shadow:0 0 0 3px var(--accent-soft);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:12px;animation:ssIn .16s ease-out">
          <div style="font-weight:600;font-size:13.5px">{{ ad.d.edTitle }}</div>
          <sc-if value="{{ ad.d.edTimes }}">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <label style="display:flex;flex-direction:column;gap:5px;font-size:12.5px;font-weight:500">{{ ad.t.colIn }}<input type="time" value="{{ ad.d.ed.in }}" onChange="{{ ad.d.ed.onIn }}" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 13px 'Geist Mono',monospace;min-width:0;outline-color:var(--accent)"></label>
              <label style="display:flex;flex-direction:column;gap:5px;font-size:12.5px;font-weight:500">{{ ad.t.colOut }}<input type="time" value="{{ ad.d.ed.out }}" onChange="{{ ad.d.ed.onOut }}" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 13px 'Geist Mono',monospace;min-width:0;outline-color:var(--accent);border-color:{{ ad.d.ed.outBd }}"></label>
            </div>
            <sc-if value="{{ ad.d.ed.timeErr }}"><span style="font-size:12.5px;color:var(--bad);margin-top:-6px">{{ ad.d.L.errTime }}</span></sc-if>
          </sc-if>
          <sc-if value="{{ ad.d.edStatus }}">
            <div style="display:flex;flex-wrap:wrap;gap:6px">
              <sc-for list="{{ ad.d.ed.statusOpts }}" as="so" hint-placeholder-count="8"><button onClick="{{ so.go }}" style="display:flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:999px;border:1px solid {{ so.bd }};background:{{ so.bg }};color:var(--text);font-size:12.5px;font-weight:500;cursor:pointer"><span style="width:7px;height:7px;border-radius:50%;background:{{ so.dot }}"></span>{{ so.label }}</button></sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ ad.d.ed.hasDiff }}"><div style="display:flex;flex-direction:column;gap:4px;font-size:12.5px;padding:8px 10px;border-radius:8px;background:var(--surface-2)"><sc-for list="{{ ad.d.ed.diffs }}" as="df"><div style="display:flex;gap:8px;align-items:center"><span style="color:var(--text-3);min-width:80px">{{ df.k }}</span><span style="text-decoration:line-through;color:var(--text-3);font-family:'Geist Mono',monospace">{{ df.a }}</span>→<span style="font-weight:600;font-family:'Geist Mono',monospace">{{ df.b }}</span></div></sc-for></div></sc-if>
          <label style="display:flex;flex-direction:column;gap:5px;font-size:12.5px;font-weight:500">{{ ad.d.L.reason }} <textarea value="{{ ad.d.ed.reason }}" onChange="{{ ad.d.ed.onReason }}" rows="2" placeholder="{{ ad.d.L.reasonPh }}" style="padding:9px 11px;border-radius:9px;border:1px solid {{ ad.d.ed.reasonBd }};background:var(--surface);color:var(--text);font:400 13px 'Geist',sans-serif;resize:vertical;outline-color:var(--accent)"></textarea></label>
          <sc-if value="{{ ad.d.ed.reasonErr }}"><span style="font-size:12.5px;color:var(--bad);margin-top:-6px">{{ ad.d.L.errReason }}</span></sc-if>
          <div style="display:flex;justify-content:flex-end;gap:8px"><button onClick="{{ ad.d.ed.cancel }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:32px">{{ ad.t.cancel }}</button><button onClick="{{ ad.d.ed.save }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:32px;border:0;background:var(--accent);color:#fff">{{ ad.d.L.saveChanges }}</button></div>
        </div>
      </sc-if>

      <div>
        <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.d.L.location }}</div>
        <div style="position:relative;aspect-ratio:400/220;border-radius:10px;overflow:hidden;background:var(--map-bg);border:1px solid var(--border)">
          <svg viewBox="0 0 400 220" style="position:absolute;inset:0;width:100%;height:100%">
            <rect x="18" y="14" width="70" height="40" rx="3" style="fill:var(--map-block)"></rect><rect x="300" y="64" width="80" height="50" rx="3" style="fill:var(--map-block)"></rect><rect x="20" y="78" width="66" height="60" rx="3" style="fill:var(--map-block)"></rect>
            <path d="M0 176 C 80 158, 150 214, 250 194 S 360 168, 400 182 L400 220 L0 220Z" style="fill:var(--map-water)"></path>
            <g style="stroke:var(--map-road);fill:none" stroke-linecap="round"><path d="M0 60 L400 50" stroke-width="7"></path><path d="M96 0 L106 220" stroke-width="7"></path><path d="M0 150 L400 140" stroke-width="5"></path><path d="M236 0 L292 220" stroke-width="5"></path><path d="M340 0 L350 140" stroke-width="3"></path></g>
            <circle cx="200" cy="108" r="{{ ad.d.fence.r }}" style="fill:var(--fence);stroke:var(--accent);stroke-width:1.6;stroke-dasharray:5 4"></circle>
            <polygon points="{{ ad.d.fence.points }}" style="fill:var(--fence);stroke:var(--accent);stroke-width:1.6;stroke-dasharray:5 4;stroke-linejoin:round"></polygon>
            <line x1="200" y1="108" x2="{{ ad.d.ci.x }}" y2="{{ ad.d.ci.y }}" style="stroke:{{ ad.d.ci.c }};stroke-width:1.4;stroke-dasharray:3 3;opacity:{{ ad.d.ci.op }}"></line>
            <line x1="200" y1="108" x2="{{ ad.d.co.x }}" y2="{{ ad.d.co.y }}" style="stroke:var(--violet-dot);stroke-width:1.4;stroke-dasharray:3 3;opacity:{{ ad.d.co.op }}"></line>
            <rect x="195" y="103" width="10" height="10" rx="2" transform="rotate(45 200 108)" style="fill:var(--accent);stroke:var(--surface);stroke-width:2"></rect>
            <circle cx="{{ ad.d.co.x }}" cy="{{ ad.d.co.y }}" r="6" style="fill:var(--violet-dot);stroke:var(--surface);stroke-width:2.5;opacity:{{ ad.d.co.op }}"></circle>
            <circle cx="{{ ad.d.ci.x }}" cy="{{ ad.d.ci.y }}" r="7" style="fill:{{ ad.d.ci.c }};stroke:var(--surface);stroke-width:2.5;opacity:{{ ad.d.ci.op }}"></circle>
          </svg>
          <sc-if value="{{ ad.d.noGps }}"><div style="position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.04)"><span style="padding:6px 10px;border-radius:8px;background:var(--surface);border:1px solid var(--border);font-size:12.5px;color:var(--text-2)">{{ ad.d.L.noGps }}</span></div></sc-if>
        </div>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin:8px 0 12px;font-size:12px;color:var(--text-2)">
          <span style="display:flex;align-items:center;gap:6px"><span style="width:9px;height:9px;border-radius:50%;background:{{ ad.d.ci.c }}"></span>{{ ad.t.colIn }} · {{ ad.d.ci.dist }}</span>
          <span style="display:flex;align-items:center;gap:6px"><span style="width:9px;height:9px;border-radius:50%;background:var(--violet-dot)"></span>{{ ad.t.colOut }} · {{ ad.d.co.dist }}</span>
          <span style="display:flex;align-items:center;gap:6px"><span style="width:8px;height:8px;background:var(--accent);transform:rotate(45deg);border-radius:2px"></span>{{ ad.d.L.center }}</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border);border-radius:10px;overflow:hidden">
          <sc-for list="{{ ad.d.facts }}" as="fc" hint-placeholder-count="6">
            <div style="padding:10px 12px;border-bottom:1px solid var(--border);border-right:1px solid var(--border);margin:0 -1px -1px 0"><div style="font-size:11.5px;color:var(--text-3)">{{ fc.k }}</div><div style="font-weight:500;font-size:13px;color:{{ fc.c }}">{{ fc.v }}</div></div>
          </sc-for>
        </div>
      </div>

      <sc-if value="{{ ad.d.hasSelfies }}">
        <div>
          <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.d.L.selfies }}</div>
          <div style="display:flex;gap:10px">
            <sc-for list="{{ ad.d.selfies }}" as="sf" hint-placeholder-count="2">
              <button onClick="{{ sf.open }}" style="width:120px;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface);padding:0;cursor:zoom-in;text-align:left">
                <div style="aspect-ratio:3/4;background:repeating-linear-gradient(135deg,var(--surface-2) 0 8px,var(--neutral-bg) 8px 16px);display:grid;place-items:center;color:var(--text-3)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M4 7h3l2-3h6l2 3h3v13H4zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"></path></svg></div>
                <div style="padding:6px 8px"><div style="font-size:12px;font-weight:500;color:var(--text)">{{ sf.label }}</div><div style="font:400 11px 'Geist Mono',monospace;color:var(--text-3)">{{ sf.time }}</div></div>
              </button>
            </sc-for>
          </div>
        </div>
      </sc-if>

      <div>
        <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.t.timeline }}</div>
        <div style="display:flex;flex-direction:column">
          <sc-for list="{{ ad.d.events }}" as="ev" hint-placeholder-count="4">
            <div style="display:flex;gap:12px">
              <div style="display:flex;flex-direction:column;align-items:center"><span style="width:10px;height:10px;border-radius:50%;background:{{ ev.c }};margin-top:4px;flex:none"></span><span style="width:1px;flex:1;background:var(--border);min-height:14px"></span></div>
              <div style="padding-bottom:12px;flex:1;min-width:0"><div style="font-size:13px"><span style="font:500 12.5px 'Geist Mono',monospace;color:var(--text-2);margin-right:8px">{{ ev.time }}</span>{{ ev.label }}</div><div style="font-size:12px;color:var(--text-3)">{{ ev.sub }}</div></div>
            </div>
          </sc-for>
        </div>
      </div>

      <div>
        <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.d.L.history }}</div>
        <sc-if value="{{ ad.d.hasHistory }}">
          <div style="display:flex;flex-direction:column;border:1px solid var(--border);border-radius:10px;overflow:hidden">
            <sc-for list="{{ ad.d.history }}" as="hi" hint-placeholder-count="2">
              <div style="padding:11px 14px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:6px">
                <div style="display:flex;align-items:center;gap:8px;font-size:12.5px"><span style="width:22px;height:22px;border-radius:50%;background:{{ hi.av.bg }};color:{{ hi.av.fg }};display:grid;place-items:center;font-size:9.5px;font-weight:600;flex:none">{{ hi.av.ini }}</span><strong style="font-weight:600">{{ hi.by }}</strong><span style="color:var(--text-3)">{{ hi.at }}</span></div>
                <sc-for list="{{ hi.changes }}" as="hc"><div style="display:grid;grid-template-columns:90px auto auto 1fr;gap:8px;align-items:center;font-size:12.5px;padding-left:30px"><span style="color:var(--text-3)">{{ hc.k }}</span><span style="padding:1px 7px;border-radius:6px;background:var(--bad-bg);color:var(--bad);text-decoration:line-through;font-family:'Geist Mono',monospace">{{ hc.a }}</span><span style="padding:1px 7px;border-radius:6px;background:var(--ok-bg);color:var(--ok);font-family:'Geist Mono',monospace">{{ hc.b }}</span><span></span></div></sc-for>
                <div style="font-size:12.5px;color:var(--text-2);padding-left:30px">“{{ hi.reason }}”</div>
              </div>
            </sc-for>
          </div>
        </sc-if>
        <sc-if value="{{ ad.d.noHistory }}"><div style="font-size:12.5px;color:var(--text-3)">{{ ad.d.L.noHistory }}</div></sc-if>
      </div>

      <div>
        <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">{{ ad.d.L.notes }}</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <sc-for list="{{ ad.d.notes }}" as="nt" hint-placeholder-count="1">
            <div style="display:flex;gap:10px"><span style="width:28px;height:28px;border-radius:50%;background:{{ nt.av.bg }};color:{{ nt.av.fg }};display:grid;place-items:center;font-size:11px;font-weight:600;flex:none">{{ nt.av.ini }}</span><div style="flex:1;min-width:0"><div style="font-size:12.5px"><strong style="font-weight:600">{{ nt.by }}</strong> <span style="color:var(--text-3)">{{ nt.at }}</span></div><div style="font-size:13px;color:var(--text);margin-top:2px;padding:8px 11px;border-radius:0 10px 10px 10px;background:var(--surface-2);border:1px solid var(--border);text-wrap:pretty">{{ nt.text }}</div></div></div>
          </sc-for>
          <div style="display:flex;gap:10px;align-items:flex-start"><span style="width:28px;height:28px;border-radius:50%;background:{{ ad.d.meAv.bg }};color:{{ ad.d.meAv.fg }};display:grid;place-items:center;font-size:11px;font-weight:600;flex:none">{{ ad.d.meAv.ini }}</span>
            <div style="flex:1;display:flex;flex-direction:column;gap:6px"><textarea value="{{ ad.d.note }}" onChange="{{ ad.d.onNote }}" rows="2" placeholder="{{ ad.d.L.notePh }}" style="padding:9px 11px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:400 13px 'Geist',sans-serif;resize:vertical;outline-color:var(--accent)"></textarea><button onClick="{{ ad.d.postNote }}" disabled="{{ ad.d.noteDisabled }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:30px;align-self:flex-end;opacity:{{ ad.d.noteOp }}">{{ ad.d.L.post }}</button></div>
          </div>
        </div>
      </div>
    </div>

    <div style="display:flex;gap:8px;align-items:center;padding:12px 20px;border-top:1px solid var(--border);background:var(--surface-2);flex-wrap:wrap">
      <sc-if value="{{ ad.d.canDelete }}"><button onClick="{{ ad.d.askDelete }}" title="{{ ad.d.L.delete }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;color:var(--bad)" style-hover="background:var(--bad-bg)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>{{ ad.d.L.delete }}</button></sc-if>
      <div style="flex:1"></div>
      <sc-if value="{{ ad.d.canEdit }}"><button onClick="{{ ad.d.openStatus }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px">{{ ad.d.L.changeStatus }}</button></sc-if>
      <sc-if value="{{ ad.d.showBehalf }}"><button onClick="{{ ad.d.behalf }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;border:0;background:var(--accent);color:#fff">{{ ad.t.checkInBehalf }}</button></sc-if>
      <sc-if value="{{ ad.d.canApproveRec }}"><button onClick="{{ ad.d.approveRec }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;border:0;background:var(--accent);color:#fff" style-hover="background:var(--accent-hover)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M5 12l5 5L20 7"></path></svg>{{ ad.d.L.approveRec }}</button></sc-if>
    </div>
  </aside>
  <sc-if value="{{ ad.d.confirmDel }}">
    <div style="position:fixed;inset:0;background:var(--overlay);z-index:50;display:grid;place-items:center;padding:20px">
      <div style="width:420px;max-width:100%;background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-lg);animation:ssIn .18s ease-out;padding:20px 22px;display:flex;flex-direction:column;gap:12px">
        <div style="width:40px;height:40px;border-radius:10px;background:var(--bad-bg);color:var(--bad);display:grid;place-items:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg></div>
        <div style="font-weight:600;font-size:16px">{{ ad.d.L.delTitle }}</div>
        <div style="font-size:13px;color:var(--text-2);text-wrap:pretty">{{ ad.d.delDesc }}</div>
        <label style="display:flex;flex-direction:column;gap:5px;font-size:12.5px;font-weight:500">{{ ad.d.L.reason }}<input value="{{ ad.d.delReason }}" onChange="{{ ad.d.onDelReason }}" placeholder="{{ ad.d.L.delPh }}" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;outline-color:var(--accent)"></label>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:4px"><button onClick="{{ ad.d.cancelDel }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:36px">{{ ad.t.cancel }}</button><button onClick="{{ ad.d.doDelete }}" style="height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px;height:36px;border:0;background:var(--bad-dot);color:#fff;opacity:{{ ad.d.delOp }}">{{ ad.d.L.delConfirm }}</button></div>
      </div>
    </div>
  </sc-if>
</sc-if>

<sc-if value="{{ ad.modalOpen }}">
  <div style="position:fixed;inset:0;background:var(--overlay);z-index:30;display:grid;place-items:center;padding:20px">
    <div style="width:440px;max-width:100%;background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-lg);animation:ssIn .18s ease-out">
      <div style="padding:20px 22px 0">
        <div style="font-weight:600;font-size:16px">{{ ad.t.rejectTitle }}</div>
        <div style="font-size:13px;color:var(--text-2);margin-top:4px">{{ ad.modalSub }}</div>
        <div style="font-size:12.5px;color:var(--text-3);margin-top:10px">{{ ad.t.rejectDesc }}</div>
        <textarea value="{{ ad.rejectReason }}" onChange="{{ ad.onReason }}" placeholder="{{ ad.t.reasonPh }}" rows="3" style="width:100%;box-sizing:border-box;margin-top:12px;padding:10px 12px;border:1px solid var(--border-strong);border-radius:9px;background:var(--surface);color:var(--text);font:inherit;font-size:13.5px;resize:vertical;outline-color:var(--accent)"></textarea>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;padding:16px 22px 18px">
        <button onClick="{{ ad.closeModal }}" style="height:36px;padding:0 14px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);font:500 13px 'Geist',sans-serif;cursor:pointer">{{ ad.t.cancel }}</button>
        <button onClick="{{ ad.confirmReject }}" disabled="{{ ad.rejectDisabled }}" style="height:36px;padding:0 14px;border-radius:9px;border:0;background:var(--bad-dot);color:#fff;font:500 13px 'Geist',sans-serif;cursor:pointer;opacity:{{ ad.rejectOpacity }}">{{ ad.t.confirmReject }}</button>
      </div>
    </div>
  </div>
</sc-if>

<div style="position:fixed;right:20px;bottom:20px;z-index:40;display:flex;flex-direction:column;gap:8px;align-items:flex-end">
  <sc-for list="{{ ad.toasts }}" as="tt">
    <div style="display:flex;align-items:center;gap:10px;min-width:280px;max-width:380px;padding:12px 14px;border-radius:11px;background:var(--text);color:var(--surface);box-shadow:var(--shadow-lg);font-size:13.5px;animation:ssIn .2s ease-out">
      <span style="width:20px;height:20px;border-radius:50%;background:{{ tt.c }};display:grid;place-items:center;flex:none;color:#fff"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="{{ tt.icon }}"></path></svg></span>
      <span style="flex:1">{{ tt.msg }}</span>
    </div>
  </sc-for>
</div>
</div>
</div>
</sc-if>
<sc-if value="{{ showSwitcher }}" hint-placeholder-val="{{ true }}">
    <div style="position:fixed;top:0;left:50%;transform:translateX(-50%);z-index:100;display:flex;flex-direction:column;align-items:center;font-family:'Geist',system-ui,sans-serif">
      <button onClick="{{ toggleMenu }}" style="display:flex;align-items:center;gap:7px;height:26px;padding:0 12px;border:0;border-radius:0 0 10px 10px;background:#0D1B2E;color:#fff;font-size:12px;font-weight:500;cursor:pointer;box-shadow:0 4px 14px rgba(13,27,46,.25)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"></path></svg>
        <span>{{ currentLabel }}</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="{{ chevron }}"></path></svg>
      </button>
      <sc-if value="{{ menuOpen }}">
        <div style="margin-top:8px;width:300px;max-height:75vh;overflow:auto;background:#fff;color:#0D1B2E;border:1px solid #E3E7ED;border-radius:12px;box-shadow:0 16px 48px rgba(13,27,46,.22);padding:8px">
          <sc-for list="{{ groups }}" as="g" hint-placeholder-count="2">
            <div style="padding:8px 8px 4px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#6F7A8B">{{ g.label }}</div>
            <sc-for list="{{ g.items }}" as="it" hint-placeholder-count="4">
              <button onClick="{{ it.go }}" style="display:flex;align-items:center;gap:10px;width:100%;height:34px;padding:0 10px;border:0;border-radius:8px;background:{{ it.bg }};color:{{ it.fg }};font-size:13px;font-weight:500;cursor:pointer;text-align:left" style-hover="background:#F1F4F8">
                <span style="flex:1">{{ it.label }}</span>
                <sc-if value="{{ it.soon }}"><span style="font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:999px;background:#EEF1F5;color:#6F7A8B">Upcoming</span></sc-if>
                <sc-if value="{{ it.active }}"><span style="width:6px;height:6px;border-radius:50%;background:#0B67DD"></span></sc-if>
              </button>
            </sc-for>
          </sc-for>
        </div>
      </sc-if>
    </div>
  </sc-if>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;startScreen&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;signin&quot;,&quot;invite&quot;,&quot;workspaces&quot;,&quot;onboarding&quot;,&quot;dashboard&quot;,&quot;live&quot;,&quot;attendance&quot;,&quot;alerts&quot;,&quot;employees&quot;,&quot;sites&quot;,&quot;schedules&quot;,&quot;leave&quot;,&quot;reports&quot;,&quot;users&quot;,&quot;audit&quot;,&quot;settings&quot;],&quot;default&quot;:&quot;signin&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Navigation&quot;},&quot;showSwitcher&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Navigation&quot;},&quot;sidebar&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;expanded&quot;,&quot;collapsed&quot;],&quot;default&quot;:&quot;expanded&quot;,&quot;tsType&quot;:&quot;'expanded'|'collapsed'&quot;,&quot;section&quot;:&quot;App shell&quot;},&quot;layout&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;auto&quot;,&quot;desktop&quot;,&quot;tablet&quot;],&quot;default&quot;:&quot;desktop&quot;,&quot;tsType&quot;:&quot;'auto'|'desktop'|'tablet'&quot;,&quot;section&quot;:&quot;App shell&quot;},&quot;role&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;admin&quot;,&quot;branch&quot;,&quot;site&quot;],&quot;default&quot;:&quot;admin&quot;,&quot;tsType&quot;:&quot;'admin'|'branch'|'site'&quot;,&quot;section&quot;:&quot;Access&quot;},&quot;theme&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;light&quot;,&quot;dark&quot;],&quot;default&quot;:&quot;light&quot;,&quot;tsType&quot;:&quot;'light'|'dark'&quot;,&quot;section&quot;:&quot;Display&quot;},&quot;lang&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;en&quot;,&quot;fr&quot;],&quot;default&quot;:&quot;en&quot;,&quot;tsType&quot;:&quot;'en'|'fr'&quot;,&quot;section&quot;:&quot;Display&quot;},&quot;dashState&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;live&quot;,&quot;new&quot;],&quot;default&quot;:&quot;live&quot;,&quot;tsType&quot;:&quot;'live'|'new'&quot;,&quot;section&quot;:&quot;States&quot;},&quot;recordsState&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;normal&quot;,&quot;empty&quot;],&quot;default&quot;:&quot;normal&quot;,&quot;tsType&quot;:&quot;'normal'|'empty'&quot;,&quot;section&quot;:&quot;States&quot;},&quot;signinState&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;default&quot;,&quot;loading&quot;,&quot;wrong&quot;,&quot;locked&quot;,&quot;deactivated&quot;,&quot;offline&quot;],&quot;default&quot;:&quot;default&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;States&quot;},&quot;inviteState&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;valid&quot;,&quot;expired&quot;,&quot;used&quot;],&quot;default&quot;:&quot;valid&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;States&quot;},&quot;onboardingStep&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;min&quot;:1,&quot;max&quot;:9,&quot;default&quot;:1,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;States&quot;}}">

class Sub {
  constructor(host,key){ this.host=host; this.key=key; this._s={}; }
  get state(){ return this._s; } set state(v){ this._s=v; }
  get props(){ return this.host.subProps(this.key); }
  setState(u,cb){ const p=typeof u==='function'?u(this._s,this.props):u; if(p) this._s=Object.assign({},this._s,p); if(this.host._alive&&this.host.subs[this.key]===this) this.host.forceUpdate(cb); }
  forceUpdate(cb){ if(this.host._alive) this.host.forceUpdate(cb); }
}
const SignInC=(()=>{

const T={
  title:['Sign in to StaffSync','Connexion à StaffSync'],sub:['Welcome back. Sign in to your admin workspace.','Bon retour. Connectez-vous à votre espace administrateur.'],
  email:['Work email','E-mail professionnel'],password:['Password','Mot de passe'],forgot:['Forgot password?','Mot de passe oublié ?'],remember:['Remember me for 30 days','Se souvenir de moi pendant 30 jours'],
  signIn:['Sign in','Se connecter'],signingIn:['Signing in…','Connexion…'],or:['or','ou'],google:['Continue with Google','Continuer avec Google'],ms:['Continue with Microsoft','Continuer avec Microsoft'],
