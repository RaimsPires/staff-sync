          cancel:()=>this.setState({drEdit:null}),
          save:()=>{ if(tErr) return; if(!E.reason.trim()){this.setState({drEdit:Object.assign({},E,{tried:true})});return;} if(!diffs.length){this.setState({drEdit:null});return;}
