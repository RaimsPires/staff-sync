# StaffSync backend configuration. Copy to `.env` and fill in what you use.
# Anything left empty keeps its development behaviour: e-mails, texts and push messages are only written to the
# server log, files are kept on local disk, and single sign-on and billing are switched off.

# --- Core ---------------------------------------------------------------------------------------------
APP_ENV=dev                      # dev | test | staging | prod
DATABASE_URL=postgresql+asyncpg://staffsync:staffsync@localhost:5433/staffsync
REDIS_URL=redis://localhost:6380/0
# Generate each secret with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=iYukGF3177xRf6xaUi1WGa8c79uLvJ1i82Vnow1qyTCkLglx3t3W8Q4rhnQzBXOb
SERVER_PEPPER=1uJbCTmx7qKohHIVmk0FQtzXgMXy-QF8IHJqkoj6LP-bZo9CxTxDEsEJh7QO_6sv
# Encrypts two-factor secrets at rest. Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000"]
# Where people reach this API and the dashboard. Used in links the API hands out (file upload/download URLs,
# the single sign-on return address, invitation and reset e-mails).
PUBLIC_API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
# Lowest mobile app version allowed to talk to the API (older builds get a "please update" screen). Empty = no limit.
APP_VERSION_MIN=
SENTRY_DSN=

# --- E-mail (SMTP) ------------------------------------------------------------------------------------
# Codes, invitations and password resets are sent from here. Works with any SMTP service (Resend, Brevo,
# Mailgun, Amazon SES, Gmail with an app password...). Leave SMTP_HOST empty to only log e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@staffsync.app
SMTP_FROM_NAME=StaffSync
SMTP_STARTTLS=true               # port 587
SMTP_SSL=false                   # set true (and SMTP_STARTTLS=false) for implicit TLS on port 465

# --- SMS ----------------------------------------------------------------------------------------------
# Login codes for people without an e-mail address. SMS_PROVIDER: console | twilio | africastalking
SMS_PROVIDER=console
# Twilio (set either a sender or a messaging service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # a Twilio number or an alphanumeric sender id, e.g. StaffSync
TWILIO_MESSAGING_SERVICE_SID=
# Africa's Talking (Cameroon, Côte d'Ivoire and most of Africa). Use the username "sandbox" to test.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Push notifications -------------------------------------------------------------------------------
# Sent through Expo's push service, which delivers to Apple and Google for the mobile app.
EXPO_PUSH_ENABLED=false          # true to send real pushes
EXPO_ACCESS_TOKEN=               # only if "enhanced push security" is turned on in your Expo project

# --- File storage -------------------------------------------------------------------------------------
# With S3_BUCKET empty, uploads (chat media, selfies, leave documents, profile photos) are stored on local disk
# in LOCAL_STORAGE_DIR: fine for development, not for several servers. Set the bucket for production; this
# works with Amazon S3 and S3-compatible stores (Cloudflare R2, MinIO, DigitalOcean Spaces, Scaleway...).
LOCAL_STORAGE_DIR=./.storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                 # leave empty for Amazon S3; set for R2, MinIO, Spaces...
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Single sign-on (dashboard) -----------------------------------------------------------------------
# Redirect address to register with each provider: {PUBLIC_API_URL}/api/v1/auth/sso/google/callback (and /microsoft/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common          # a tenant id, "organizations" or "common"

# --- App attestation (mobile) -------------------------------------------------------------------------
# A failed verdict adds a flag to a check-in; a missing or unverified one never blocks it.
PLAY_INTEGRITY_PACKAGE_NAME=     # Android package, e.g. app.staffsync.mobile
GOOGLE_SERVICE_ACCOUNT_FILE=     # path to a service account JSON with the Play Integrity API enabled
APPLE_APP_ID=                    # "<TEAM_ID>.<bundle id>" for iOS App Attest

# --- Billing (Stripe) ---------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan -> Stripe price id, e.g. {"starter_month":"price_123","business_month":"price_456"}
STRIPE_PRICES={}
BILLING_GRACE_DAYS=7
